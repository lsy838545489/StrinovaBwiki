      "7": {
        "ItemId": 3031004,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "7_Name",
          "SourceString": "敬茶礼仪",
          "LocalizedString": "敬茶礼仪"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "7_Desc",
          "SourceString": "有关茶叶一切都需要认真对待。选杯、温盏、置茶、润茶……每一步都不能马虎。尤其，是为了这个特殊的仪式。\n“既然你我都能作为彼此的老师，那这拜师的礼仪，也要独一无二才行。”",
          "LocalizedString": "有关茶叶一切都需要认真对待。选杯、温盏、置茶、润茶……每一步都不能马虎。尤其，是为了这个特殊的仪式。\n“既然你我都能作为彼此的老师，那这拜师的礼仪，也要独一无二才行。”"
        },
