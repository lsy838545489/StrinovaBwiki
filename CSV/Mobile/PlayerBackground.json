      "23": {
        "ItemId": 3032014,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "23_Name",
          "SourceString": "绯莎-致命潜行",
          "LocalizedString": "绯莎-致命潜行"
        },
        "Quality": 4,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "23_Desc",
          "SourceString": "潜行者应该有怎样的气质？绯莎不清楚。她只知道自己就像深海中名为“鲨鱼”的猎手，停止游动的那天，就是生命的终点。\n“啊，被抓住了。”",
          "LocalizedString": "潜行者应该有怎样的气质？绯莎不清楚。她只知道自己就像深海中名为“鲨鱼”的猎手，停止游动的那天，就是生命的终点。\n“啊，被抓住了。”"
