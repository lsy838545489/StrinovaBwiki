      "6": {
        "ItemId": 3031003,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "6_Name",
          "SourceString": "记忆独奏",
          "LocalizedString": "记忆独奏"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "6_Desc",
          "SourceString": "音乐具有跨越时空的力量。当尘封已久的琴弦再度震颤，遥远时光里的微风与阳光，仿佛也随着音符一起重现在身边。\n“希望这首曲子可以停留在你的记忆中，无论经历多少岁月……”",
          "LocalizedString": "音乐具有跨越时空的力量。当尘封已久的琴弦再度震颤，遥远时光里的微风与阳光，仿佛也随着音符一起重现在身边。\n“希望这首曲子可以停留在你的记忆中，无论经历多少岁月……”"
        },
