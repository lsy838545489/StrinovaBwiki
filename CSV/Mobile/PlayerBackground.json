        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "20_Name",
          "SourceString": "星绘-星辰降临",
          "LocalizedString": "星绘-星辰降临"
        },
        "Quality": 4,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "20_Desc",
          "SourceString": "她跨越时空的门扉来到此处，以星星的光芒驱散崩溃的阴影。她是战场上不坠落的星辰，指尖流淌着银河的辉光。她的力量温柔而坚定，常伴在你的身边。\n“终有一天，我们会治愈这个世界。”",
          "LocalizedString": "她跨越时空的门扉来到此处，以星星的光芒驱散崩溃的阴影。她是战场上不坠落的星辰，指尖流淌着银河的辉光。她的力量温柔而坚定，常伴在你的身边。\n“终有一天，我们会治愈这个世界。”"
