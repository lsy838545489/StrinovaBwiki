      "9": {
        "ItemId": 3031006,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "9_Name",
          "SourceString": "橙香手作",
          "LocalizedString": "橙香手作"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "9_Desc",
          "SourceString": "名为“家”的空间里充满水果与烘烤的气息。利里家的晚餐为特殊的访客奉上了一道独特的手作——摆弄画笔与颜料的双手，看来同样擅长烹饪呢。\n“想要将我的心意，制作成你能触摸到的、生活中最本真的温暖。”",
          "LocalizedString": "名为“家”的空间里充满水果与烘烤的气息。利里家的晚餐为特殊的访客奉上了一道独特的手作——摆弄画笔与颜料的双手，看来同样擅长烹饪呢。\n“想要将我的心意，制作成你能触摸到的、生活中最本真的温暖。”"
        },
