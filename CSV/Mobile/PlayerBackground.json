      "12": {
        "ItemId": 3032003,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "12_Name",
          "SourceString": "伊薇特-极地熊影",
          "LocalizedString": "伊薇特-极地熊影"
        },
        "Quality": 4,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "12_Desc",
          "SourceString": "就像童话中为孩子击退梦魇的玩偶骑士，皮毛柔软的可爱之物，遇到危机时也会展现出英勇强壮的一面。研究员的战斗能力，同样不可小觑。\n“菲说：别怕，熊是大家的好朋友。要来，一起取暖吗？”",
          "LocalizedString": "就像童话中为孩子击退梦魇的玩偶骑士，皮毛柔软的可爱之物，遇到危机时也会展现出英勇强壮的一面。研究员的战斗能力，同样不可小觑。\n“菲说：别怕，熊是大家的好朋友。要来，一起取暖吗？”"
