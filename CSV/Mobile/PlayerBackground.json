      "10": {
        "ItemId": 3032001,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "10_Name",
          "SourceString": "米雪儿-新秀登场",
          "LocalizedString": "米雪儿-新秀登场"
        },
        "Quality": 4,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "10_Desc",
          "SourceString": "维护卡丘世界的和谐稳定，努力成为优秀搜查官！怀揣着这样的梦想，少女的身影活跃在大街小巷中。\n“新人搜查官米雪儿，堂堂登场！”",
          "LocalizedString": "维护卡丘世界的和谐稳定，努力成为优秀搜查官！怀揣着这样的梦想，少女的身影活跃在大街小巷中。\n“新人搜查官米雪儿，堂堂登场！”"
