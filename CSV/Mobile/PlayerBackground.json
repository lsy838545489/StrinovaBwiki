      "11": {
        "ItemId": 3032002,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "11_Name",
          "SourceString": "心夏-极限支援",
          "LocalizedString": "心夏-极限支援"
        },
        "Quality": 4,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "11_Desc",
          "SourceString": "欧泊“最佳队友”评选第一名，毫无疑问属于心夏。无论是战斗支持还是伤员救助，有这位前辈在身边，再困难的任务也不在话下！\n“真是的，训练后要好好打扫靶场啊！”",
          "LocalizedString": "欧泊“最佳队友”评选第一名，毫无疑问属于心夏。无论是战斗支持还是伤员救助，有这位前辈在身边，再困难的任务也不在话下！\n“真是的，训练后要好好打扫靶场啊！”"
