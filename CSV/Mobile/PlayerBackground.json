      "4": {
        "ItemId": 3031001,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "4_Name",
          "SourceString": "璀璨星空",
          "LocalizedString": "璀璨星空"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "4_Desc",
          "SourceString": "看不到星星的夜晚，也可以许愿吗？如果星空被阴霾遮盖，就用这场盛大的烟花，让天空重新璀璨，来换你同样灿烂的笑容。\n“谢谢前辈实现我的愿望。前辈的心愿，也由我来实现吧。”",
          "LocalizedString": "看不到星星的夜晚，也可以许愿吗？如果星空被阴霾遮盖，就用这场盛大的烟花，让天空重新璀璨，来换你同样灿烂的笑容。\n“谢谢前辈实现我的愿望。前辈的心愿，也由我来实现吧。”"
        },
