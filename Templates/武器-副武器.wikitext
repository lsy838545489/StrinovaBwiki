<div class="klbq-sub-overview">
<!-- 1. 顶部副武器展台 (Hero Banner) -->
<div class="klbq-sub-hero">
<div class="klbq-sub-hero__image">[[文件:武器-{{{武器名称|{{PAGENAME}}}}}.png|240px|center|link={{{武器名称|{{PAGENAME}}}}}]]</div>
<div class="klbq-sub-hero__name">{{{武器名称|{{PAGENAME}}}}}</div>
<div class="klbq-sub-hero__badges">{{#if:{{{获得方式|}}}|<span class="klbq-sub-badge">获得方式：{{{获得方式|}}}</span>}}</div>
<div class="klbq-sub-hero__intro">{{{武器介绍|}}}</div>
</div>

<!-- 2. 战术参数面板（PC 端） -->
<div class="klbq-sub-grid">
<div class="klbq-sub-grid__col">
<div class="klbq-sub-panel">
<div class="klbq-sub-section-title"><span>TACTICAL METRICS</span><em>战术参数</em></div>
<div class="klbq-sub-metric-grid">
<div class="klbq-sub-metric">
<div class="klbq-sub-metric__head"><span class="klbq-sub-metric__label">弹匣容量</span><span class="klbq-sub-metric__val"><code class="klbq-sub-mono">{{{弹匣容量|}}}</code> 发</span></div>
<div class="klbq-sub-metric__track"><div class="klbq-sub-metric__fill" style="width: {{#iferror:{{#expr:{{{弹匣容量|0}}}*2}}|0}}%;"></div></div>
</div>
{{#if:{{{射速|}}}|<div class="klbq-sub-metric">
<div class="klbq-sub-metric__head"><span class="klbq-sub-metric__label">射速</span><span class="klbq-sub-metric__val"><code class="klbq-sub-mono">{{{射速}}}</code> RPM</span></div>
<div class="klbq-sub-metric__track"><div class="klbq-sub-metric__fill" style="width: {{#iferror:{{#expr:{{{射速|0}}}*0.083}}|0}}%;"></div></div>
</div>}}
{{#if:{{{弹丸数|}}}|<div class="klbq-sub-metric">
<div class="klbq-sub-metric__head"><span class="klbq-sub-metric__label">弹丸数</span><span class="klbq-sub-metric__val"><code class="klbq-sub-mono">{{{弹丸数}}}</code> 发</span></div>
<div class="klbq-sub-metric__track"><div class="klbq-sub-metric__fill" style="width: {{#iferror:{{#expr:{{{弹丸数|0}}}*6}}|0}}%;"></div></div>
</div>}}
<div class="klbq-sub-metric">
<div class="klbq-sub-metric__head"><span class="klbq-sub-metric__label">弦化伤害</span><span class="klbq-sub-metric__val"><code class="klbq-sub-mono">{{#iferror:{{#expr:{{{弦化伤害|67}}}*1}}|{{{弦化伤害|67%}}}|{{{弦化伤害|67}}}}}%</code></span></div>
<div class="klbq-sub-metric__track"><div class="klbq-sub-metric__fill" style="width: {{#iferror:{{#expr:{{{弦化伤害|67}}}*1}}|{{{弦化伤害|67%}}}|{{{弦化伤害|67}}}%}};"></div></div>
</div>
</div>
</div>
</div>
