{{#if:{{#varexists:sec-att-card-css}} || {{#vardefine:sec-att-card-css | 1 }}<bstyle>/*<pre>*/
/* ===== 弦溯战线 · 配件卡片 ===== */
/* 列数只作用于本模式图鉴（容器额外带 sec-att-gallery 类），不影响同页其他 gallerygrid */
@media (min-width: 320px) {
    .gallerygrid.sec-att-gallery {
        grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    }
}
@media (min-width: 768px) {
    .gallerygrid.sec-att-gallery {
        grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
    }
}

.sec-att-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    /* 默认顺序 = 模块输出顺序（游戏内图鉴序）；
       点排序按钮后由 [[Widget:CardSelectGallery]] 写行内 order 重排 */
    background: rgb(var(--klbq-surface-rgb) / .9);
    border: 1.5px solid rgba(216, 222, 227, .85);
    border-radius: 14px;
    overflow: hidden;
    transition: transform .28s cubic-bezier(.34, 1.56, .64, 1), box-shadow .28s ease;
}
.sec-att-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 18px rgba(18, 26, 33, .12);
}

/* 品质色：编号沿用弦溯战线自身口径（5=臻藏、6=传说），与主游戏不同 */
.sec-att-card[data-quality="6"] {
    border-color: var(--item-quality-Legendary);
    box-shadow: 0 2px 10px -4px var(--item-quality-Legendary);
}
.sec-att-card[data-quality="5"] {
    border-color: var(--item-quality-Secret);
    box-shadow: 0 2px 10px -4px var(--item-quality-Secret);
}
.sec-att-card[data-quality="4"] {
    border-color: var(--item-quality-Perfect);
    box-shadow: 0 2px 10px -4px var(--item-quality-Perfect);
}
.sec-att-card[data-quality="3"] {
    border-color: var(--item-quality-Superior);
    box-shadow: 0 2px 10px -4px var(--item-quality-Superior);
}
.sec-att-card[data-quality="2"] {
    border-color: var(--item-quality-Exquisite);
    box-shadow: 0 2px 10px -4px var(--item-quality-Exquisite);
}
.sec-att-card[data-quality="1"], .sec-att-card[data-quality="0"] {
    border-color: var(--item-quality-Initial);
    box-shadow: 0 2px 6px -4px rgba(0, 0, 0, .25);
}

.sec-att-card-img {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 96px;
    padding: 10px 8px 2px;
    background: linear-gradient(180deg, rgba(255, 255, 255, .5) 0%, rgba(247, 248, 246, 0) 100%);
}
.sec-att-card-img img {
    object-fit: contain;
    transition: transform .3s ease;
}
.sec-att-card:hover .sec-att-card-img img {
    transform: scale(1.06);
}

.sec-att-card-body {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    padding: 6px 12px 12px;
}
.sec-att-card-name {
    font-size: 1rem;
    font-weight: bold;
    color: var(--klbq-text);
    text-align: center;
    padding-bottom: 6px;
    margin-bottom: 6px;
    border-bottom: 1px dashed rgba(0, 172, 193, .5);
}
.sec-att-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 6px;
}
.sec-att-card-value {
    font-size: .8125rem;
    font-weight: bold;
    color: var(--klbq-warning);
    white-space: nowrap;
    /* 品质徽章已移除，这一行只剩价值，靠右排 */
    margin-left: auto;
}
.sec-att-card-desc {
    font-size: .8125rem;
    line-height: 1.5;
    color: var(--klbq-text-muted);
    background: rgb(var(--klbq-surface-rgb) / .6);
    border: 1px solid rgba(0, 172, 193, .1);
    border-radius: 8px;
    padding: 6px 8px;
    margin-bottom: 6px;
}
/* 块内小标题：区分「描述」与「实际效果」两块 */
.sec-att-card-title {
    display: block;
    font-size: .6875rem;
    font-weight: 700;
    letter-spacing: .03em;
    margin-bottom: 3px;
    color: var(--klbq-text-subtle);
}
.sec-att-card-detail .sec-att-card-title {
    color: var(--klbq-accent-strong);
}

/* 细分效果：逐参数一行（数据里已是「参数名 ±N%」的自解释字符串） */
.sec-att-card-detail {
    font-size: .75rem;
    line-height: 1.55;
    color: var(--klbq-accent-strong);
    background: rgba(207, 250, 254, .6);
    border: 1px solid rgba(77, 208, 225, .12);
    border-radius: 8px;
    padding: 5px 8px;
    margin-bottom: 5px;
    word-break: break-all;
}

/* 适用枪种 + 弹种 */
.sec-att-card-compat {
    font-size: .75rem;
    line-height: 1.5;
    color: #7c3aed;
    background: rgba(237, 233, 254, .7);
    border-radius: 8px;
    padding: 4px 8px;
    margin-bottom: 5px;
}

/* 弹匣扩容 */
.sec-att-card-ammo {
    font-size: .75rem;
    line-height: 1.5;
    color: var(--klbq-warning);
    background: rgba(253, 230, 138, .35);
    border-radius: 8px;
    padding: 4px 8px;
    margin-bottom: 5px;
}

/* 关键数值行：占格 / 重量 / 售价 / 搜刮耗时 / 来源 */
.sec-att-card-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: .75rem;
    color: var(--klbq-text-muted);
    margin-bottom: 4px;
}
.sec-att-card-stats > span + span {
    position: relative;
}
.sec-att-card-stats > span + span::before {
    content: "·";
    position: absolute;
    left: -8px;
    color: var(--klbq-text-subtle);
}
.sec-att-card-stats-fx {
    color: var(--klbq-accent-strong);
}

.sec-att-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: auto;
}
.sec-att-card-tag {
    font-size: .6875rem;
    color: var(--klbq-text-muted);
    background: rgba(216, 222, 227, .8);
    border-radius: 4px;
    padding: 1px 5px;
}
.sec-att-card-tag[data-tag="来源"] {
    color: var(--klbq-accent-strong);
    background: rgba(207, 250, 254, .85);
}
.sec-att-card-tag[data-tag="流通"] {
    color: #7c3aed;
    background: rgba(237, 233, 254, .9);
}

/* ===== 暗色模式 ===== */
.client-js.wiki-dark-mode .sec-att-card {
    background: rgba(18, 26, 33, .85);
    border-color: rgba(147, 163, 173, .25);
}
.client-js.wiki-dark-mode .sec-att-card-name { color: var(--klbq-text); }
.client-js.wiki-dark-mode .sec-att-card-desc {
    background: rgba(18, 26, 33, .6);
    color: var(--klbq-text-muted);
}
.client-js.wiki-dark-mode .sec-att-card-title { color: var(--klbq-text-muted); }
.client-js.wiki-dark-mode .sec-att-card-detail .sec-att-card-title { color: var(--klbq-accent); }
.client-js.wiki-dark-mode .sec-att-card-detail {
    background: rgba(14, 116, 144, .18);
    color: var(--klbq-accent);
    border-color: rgba(34, 211, 238, .15);
}
.client-js.wiki-dark-mode .sec-att-card-compat {
    background: rgba(124, 58, 237, .18);
    color: #c4b5fd;
}
.client-js.wiki-dark-mode .sec-att-card-ammo {
    color: #fcd34d;
    background: rgba(180, 83, 9, .25);
}
.client-js.wiki-dark-mode .sec-att-card-stats { color: var(--klbq-text-muted); }
.client-js.wiki-dark-mode .sec-att-card-stats-fx { color: var(--klbq-accent); }
.client-js.wiki-dark-mode .sec-att-card-tag {
    background: rgba(51, 65, 85, .9);
    color: var(--klbq-text);
}
.client-js.wiki-dark-mode .sec-att-card-tag[data-tag="流通"] {
    color: #c4b5fd;
    background: rgba(124, 58, 237, .25);
}
.client-js.wiki-dark-mode .sec-att-card-img {
    background: linear-gradient(180deg, rgba(255, 255, 255, .05) 0%, rgba(18, 26, 33, 0) 100%);
}
/*</pre>*/</bstyle>}}