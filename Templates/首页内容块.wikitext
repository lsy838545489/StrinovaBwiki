{{#forargs: 内容块 | k | v |{{#if:{{{小标题{{#var:k}}|}}}|<div class="home-panel__sub">{{{小标题{{#var:k}}}}}</div>}}{{#if:{{#var:v}}|<div class="home-panel__body">{{#var:v}}</div>}}}}
