/* 本模块专用功能色：取自游戏内弦能增幅网络装饰物的近似色，仅作分类区分用途。
   使用频率低，不提升为全局令牌，仅在 .Growth2 容器内声明。 */
.Growth2 {
	--xn-color-blue: #849FF8;      /* 蓝紫 —— 图标描边 */
	--xn-color-green: #A4FA64;     /* 荧光绿 —— 增益类图标 */
	--xn-color-gold: #E5C04E;      /* 金 —— 技能强化数值（rgb(229,192,78)） */
	--xn-color-gold-rgb: 229, 192, 78;
	--xn-color-sky: #7CA0FF;       /* 亮蓝 —— 枪械强化数值（rgb(124,160,255)） */
	--xn-color-sky-rgb: 124, 160, 255;
	--xn-color-leaf: #67C75B;      /* 草绿 —— 超弦体强化数值（rgb(103,199,91)） */
	--xn-color-leaf-rgb: 103, 199, 91;
	--xn-color-panel: 70, 74, 81;  /* 深灰 —— 面板/tab 底色 */
	--xn-color-red: #C02A35;       /* 红 —— tab 激活高亮（rgb(192,42,53)） */
	--xn-color-red-rgb: 192, 42, 53;
	margin-bottom: 1em;
}
.Growth2 .panel{
    border: none;
    border-radius: 0;
    -webkit-box-shadow: none;
    box-shadow: none;
    padding: 0;
	margin-bottom: 0.5em;
    background-color: rgba(0, 0, 0, 0);
}
.Growth2 .panel-title{
    cursor: pointer;
}
.Growth2 .panel-body {
	padding: 5px;
}
.Growth2 .nav-tabs > li {
    display: inline-flex;
    width: 25%;
}
.Growth2 .nav > li > span {
    position: relative;
    display: block;
    padding: 10px 5px;
    margin: 5px;
    font-weight: bold;
    text-align: center;
    width: 100%;
}
.Growth2 .nav-tabs > li > span {
    color: #fff;
    line-height: 1.42857143;
    border: 2px solid rgba(var(--xn-color-panel), 1);
    border-radius: 5px;
    background-color: rgba(var(--xn-color-panel), 1);
}
.Growth2 .nav-tabs > li.active > span, .Growth2 .nav-tabs > li.active > span:hover, .Growth2 .nav-tabs > li.active > span:focus {
    color: #fff;
    border: 2px solid rgba(var(--xn-color-red-rgb), .8);
    cursor: default;
    background-color: rgba(var(--xn-color-red-rgb), .8);
}
.Growth2 .progress {
    margin: 0;
}
.Growth2 .btn-primary {
    color: var(--klbq-accent-strong);
    background-color: #fff;
    margin-left: 5px;
}
.Growth2 .upgrade-Group-bomb2 {
    width: 100%;
    margin-bottom: 2px;
    background-color: rgba(var(--xn-color-panel), 1);
    border-radius: 5px;
}
.Growth2 .upgrade-top-bomb2 {
    height: 50px;
    width: 100%;
    display: inline-flex;
}
.Growth2 .upgrade-icon-bomb2 {
    width: 50px;
    height: 50px;
}
.Growth2 .upgrade-icon2-bomb2 {
    border: solid 2px rgb(var(--xn-color-gold-rgb));
    border-radius: 50%;
    background-color: black;
}
.Growth2 .upgrade-icon2-bomb2 img {
    width: 50px;
    height: 50px;
}
.Growth2 .upgrade-icon3-bomb2 {
    width: 55px !important;
    background-color: var(--xn-color-green);
    clip-path:polygon(10% 0%,90% 0%,100% 19%,63% 100%,37% 100%,0% 19%);
    display:inline-block;
}
.Growth2 .upgrade-icon3-bomb2 img {
    margin-left: 25%;
    margin-top: 15%;
    width: 50%;
    height: 60%;
}
.Growth2 .upgrade-icon3-bomb2 .upgrade-icon-inner {
    width:52px;
    height:48px;
    margin-left:1px;
    margin-top:1px;
    background-color: black;
    clip-path:polygon(11% 1%,92% 1%,100% 18%,62% 99%,39% 99%,2% 18%);
    display:inline-block;
}
.Growth2 .upgrade-name-bomb2  {
    display: inline-flex;
    color: #fff;
    width: 60%;
    margin-left: 5px;
    font-size: 24px;
    align-items: center;
}
.Growth2 .upgrade-icon1 img {
    width: 50px;
    height: 50px;
    border-style: solid;
    border-width: 2px;
    background-color: black;
    border-color: var(--xn-color-blue);
    border-radius: 5px;
}
.Growth2 .upgrade-icon2 {
    border: solid 2px rgb(var(--xn-color-gold-rgb));
    border-radius: 50%;
    background-color: black;
}
.Growth2 .upgrade-icon2 img {
    width: 40px;
    height: 40px;
    margin-left: 3px;
    margin-top: 3px;
}
.Growth2 .upgrade-icon3 {
    width: 55px !important;
    background-color: var(--xn-color-green);
    clip-path:polygon(10% 0%,90% 0%,100% 19%,63% 100%,37% 100%,0% 19%);
    display:inline-block;
}
.Growth2 .upgrade-icon3 .upgrade-icon-inner {
    width:52px;
    height:48px;
    margin-left:1px;
    margin-top:1px;
    background-color: black;
    clip-path:polygon(11% 1%,92% 1%,100% 18%,62% 99%,39% 99%,2% 18%);
    display:inline-block;
}
.Growth2 .upgrade-icon3 img {
    margin-left: 25%;
    margin-top: 15%;
    width: 50%;
    height: 60%;
}
.Growth2 .upgrade-Maxvalue {
    display: inline-flex;
    width: 25%;
    font-size: 24px;
    align-items: center;
}
.Growth2 #枪械强化 .upgrade-Maxvalue {
    color: var(--xn-color-sky);
}
.Growth2 #技能强化 .upgrade-Maxvalue {
    color: var(--xn-color-gold);
}
.Growth2 #超弦体强化 .upgrade-Maxvalue {
    color: var(--xn-color-leaf);
}
.Growth2 .upgrade-options-bomb2 {
    width: 100%;
    border-radius: 5px;
}
.Growth2 #枪械强化 .upgrade-options-bomb2, .Growth2 #技能强化 .upgrade-options-bomb2, .Growth2 #超弦体强化 .upgrade-options-bomb2 {
    color: #000;
}
.Growth2 #枪械强化 .upgrade-row {
    background-color: rgba(var(--xn-color-sky-rgb), .7);
}
.Growth2 #技能强化 .upgrade-row {
    background-color: rgba(var(--xn-color-gold-rgb), .7);
}
.Growth2 #超弦体强化 .upgrade-row {
    background-color: rgba(var(--xn-color-leaf-rgb), .7);
}
.Growth2 .upgrade-row {
	display: inline-flex;
    align-items: center;
    width: 100%;
    height: 35px;
    color: #000;
    border-radius: 5px;
    cursor: pointer;
}
.Growth2 .left-shade {
    position: relative;
    border-left: 3px solid var(--klbq-ink-500);
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    width: 0;
    height: 25px;
}
.Growth2 .upgrade-text {
	display: inline-flex;
	align-items: center;
	margin-right: auto;
    padding-left: 5px;
    font-weight: bold;
}
.Growth2 .upgrade-cost {
	display: inline-flex;
    align-items: center;
    margin-left: auto;
    padding-right: 8px;
}