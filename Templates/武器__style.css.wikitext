}

.klbq-tac-hero__name {
    margin-top: 10px;
    font-size: 1.25rem;
    font-weight: 850;
    color: #1e293b;
    letter-spacing: 0.02em;
    line-height: 1.3;
    text-align: center;
}

.klbq-tac-hero__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 10px;
}

.klbq-tac-badge {
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 750;
    background: rgba(255, 113, 50, 0.1);
    color: var(--klbq-signal);
    border: 1px solid rgba(255, 113, 50, 0.25);
}

.klbq-tac-hero__intro {
    width: 100%;
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--klbq-text-muted);
    line-height: 1.7;
    text-align: left;
}

/* 战术效果重点条 */
.klbq-tac-effect {
    width: 100%;
    margin-top: 12px;
    padding: 10px 14px;
    background: rgba(255, 113, 50, 0.06);
    border: 1px solid rgba(255, 113, 50, 0.22);
    border-left: 3px solid var(--klbq-signal);
    border-radius: 8px;
}

.klbq-tac-effect__label {
    display: flex;
    align-items: baseline;
    gap: 6px;
    line-height: 1;
    margin-bottom: 6px;
}

.klbq-tac-effect__label span {
    color: var(--klbq-signal);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.075rem;
}

.klbq-tac-effect__label em {
    color: var(--klbq-text-muted);
    font-size: 0.8125rem;
    font-style: normal;
    font-weight: 700;
}

.klbq-tac-effect__body {
    font-size: 0.875rem;
    color: var(--klbq-text);
    line-height: 1.7;
}

/* 效果内容内的列表（效果参数常以 * 列表填写） */
.klbq-tac-effect__body ul,
.klbq-tac-effect__body ol {
    margin: 0;
    padding-left: 1.2em;
}

.klbq-tac-effect__body li {
    margin: 2px 0;
}

.klbq-tac-effect__body li::marker {
    color: var(--klbq-signal);
}

/* =========================================================
   暗色模式适配 (Dark Mode)
   ========================================================= */

.client-js.wiki-dark-mode .klbq-tac-hero {
    background: radial-gradient(circle at center, rgba(14, 165, 233, 0.15) 0%, rgba(15, 23, 42, 0.8) 80%);
    border-color: rgba(14, 165, 233, 0.3);
}

.client-js.wiki-dark-mode .klbq-tac-badge {
    color: var(--klbq-signal);
    background: rgba(255, 113, 50, 0.15);
    border-color: rgba(255, 113, 50, 0.35);
}

.client-js.wiki-dark-mode .klbq-tac-hero__name {
    color: var(--klbq-text);
}

.client-js.wiki-dark-mode .klbq-tac-hero__intro,
.client-js.wiki-dark-mode .klbq-tac-effect__label em {
    color: var(--klbq-text-muted);
}

.client-js.wiki-dark-mode .klbq-tac-effect {
    background: rgba(56, 189, 248, 0.08);
    border-color: rgba(56, 189, 248, 0.25);
    border-left-color: var(--klbq-accent);
}

.client-js.wiki-dark-mode .klbq-tac-effect__label span {
    color: var(--klbq-accent);
}

.client-js.wiki-dark-mode .klbq-tac-effect__body {
    color: var(--klbq-text);
}

.client-js.wiki-dark-mode .klbq-tac-effect__body li::marker {
    color: var(--klbq-accent);
}