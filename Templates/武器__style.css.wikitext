/* =========================================================
   KLBQ 武器系列 · 全族样式
   页面 模板:武器/style.css（contentmodel: css）
   加载：各模板首行以 #tag:nowiki 套 #tag:bstyle 转译本页
        —— 不经 #css 的 raw 端点，因此不受 Sanitizer::checkCss 限制，
           filter / url / var 均可正常使用。
   组织：按家族分三段，各自完整书写，不做跨家族合并。
        重复声明在 gzip 下几乎不占体积，换来的是每一段都能独立读懂、独立修改。
   约束：本页会被当作 wikitext 转译，正文中不能出现双花括号（会被展开）；
        不要在规则里使用竖线（会被当成参数分隔）。
   ========================================================= */


/* =========================================================
   一、主武器（模板:武器）
   ========================================================= */

.klbq-weapon-overview {
    display: flex;
    flex-direction: column;
    gap: 16px;
    width: 100%;
    margin-bottom: 20px;
}

/* 1. 顶部枪械 Hero 展台 */
.klbq-weapon-hero {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: radial-gradient(circle at center, rgba(0, 172, 193, 0.08) 0%, rgba(248, 249, 250, 0.85) 80%);
    border: 1px solid rgba(0, 172, 193, 0.25);
    border-radius: 12px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
}

.klbq-weapon-hero__image img {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.12));
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.klbq-weapon-hero:hover .klbq-weapon-hero__image img {
    transform: scale(1.04);
}

.klbq-weapon-hero__badges {
    display: flex;
    gap: 8px;
    margin-top: 10px;
}

.klbq-weapon-badge {
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 750;
}

.klbq-weapon-badge--type {
    background: rgba(0, 172, 193, 0.12);
    color: var(--klbq-accent);
    border: 1px solid rgba(0, 172, 193, 0.3);
}

.klbq-weapon-badge--user {
    background: rgba(255, 113, 50, 0.1);
    color: var(--klbq-signal);
    border: 1px solid rgba(255, 113, 50, 0.25);
}

/* 2. 双列弹性网格框架 */
.klbq-weapon-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    align-items: start;
}

@media screen and (max-width: 850px) {
    .klbq-weapon-grid {
        grid-template-columns: 1fr;
    }
}

.klbq-weapon-panel {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 10px;
}

.klbq-weapon-section-title {
    display: flex;
    align-items: baseline;
    gap: 6px;
    padding-left: 8px;
    border-left: 3px solid var(--klbq-signal);
    line-height: 1;
}

.klbq-weapon-section-title span {
    color: var(--klbq-signal);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.075rem;
}

.klbq-weapon-section-title em {
    color: var(--klbq-text-muted);
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 700;
}

.klbq-weapon-intro {
    margin-top: 10px;
    font-size: 0.875rem;
    color: var(--klbq-text-muted);
    line-height: 1.6;
}

/* 基础机制标签组 */
.klbq-weapon-meta-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.klbq-weapon-meta-chip {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 8px;
    background: rgba(248, 249, 250, 0.75);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 6px;
    font-size: 0.75rem;
}

.klbq-weapon-meta-chip span { color: var(--klbq-text-subtle); font-weight: 700; }
.klbq-weapon-meta-chip strong { color: var(--klbq-text); font-weight: 800; }

/* 战术说明提示条 (极简注脚) */
.klbq-weapon-section-tip {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 2px 0 6px 4px;
    font-size: 0.75rem; /* 12px */
    color: var(--klbq-text-subtle);
    font-family: "Roboto Mono", "Consolas", monospace;
}

.klbq-weapon-section-tip__symbol {
    color: var(--klbq-signal);
    font-weight: 800;
}

/* 3. 无表格参数仪表卡 (Metric Tiles) */
.klbq-metric-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
    width: 100%;
}

.klbq-metric-tile {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: 8px;
}

.klbq-metric-tile__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.klbq-metric-tile__label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--klbq-text-muted);
}

.klbq-metric-tile__val {
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--klbq-accent);
}

.klbq-metric-tile__track {
    width: 100%;
    height: 6px;
    background: rgba(226, 232, 240, 0.8);
    border-radius: 3px;
    overflow: hidden;
}

.klbq-metric-tile__fill {
    height: 100%;
    background: linear-gradient(90deg, #00acc1 0%, #38bdf8 100%);
    border-radius: 3px;
    transition: width 0.4s ease;
}

/* 4. 伤害倍率勋章组 */
.klbq-multiplier-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: 100%;
}

.klbq-multiplier-chip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex: 1 1 calc(25% - 8px);
    min-width: 100px;
    padding: 6px 12px;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 8px;
}

.klbq-multiplier-chip__label { white-space: nowrap; font-size: 0.75rem; font-weight: 700; color: var(--klbq-text-muted); }
.klbq-multiplier-chip__value { font-size: 0.875rem; font-weight: 850; color: var(--klbq-accent); }

/* 5. 距离衰减卡片链 */
.klbq-decay-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(105px, 1fr));
    gap: 8px;
    width: 100%;
}

.klbq-decay-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.75);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 10px;
    overflow: hidden;
    transition: all 0.2s ease;
}

@media (hover: hover) and (pointer: fine) {
    .klbq-decay-card:hover {
        border-color: rgba(0, 172, 193, 0.4);
        box-shadow: 0 4px 12px rgba(0, 172, 193, 0.1);
    }
}

.klbq-decay-card__distance {
    padding: 4px 8px;
    background: rgba(0, 172, 193, 0.08);
    border-bottom: 1px dashed rgba(0, 172, 193, 0.2);
    color: var(--klbq-accent);
    font-size: 0.75rem;
    font-weight: 800;
    text-align: center;
}

.klbq-decay-card__stats {
    display: flex;
    flex-direction: column;
    padding: 6px 8px;
    gap: 4px;
}

.klbq-decay-card__row {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--klbq-text-muted);
}

.klbq-decay-card__row--head strong,
.klbq-decay-card__row strong { color: var(--klbq-text); font-weight: 700; }

.klbq-mono {
    font-family: "Roboto Mono", "Consolas", monospace;
    font-weight: 700;
}

/* =========================================================
   暗色模式适配 (Dark Mode)
   ========================================================= */

.client-js.wiki-dark-mode .klbq-weapon-hero {
