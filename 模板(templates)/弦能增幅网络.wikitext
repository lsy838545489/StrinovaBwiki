<bstyle>/*<pre>*/
.upgrade-group {
    max-width: 300px;
    width: 100%;
    margin-bottom: 10px;
}
.upgrade-top {
    height: 50px;
    width: 100%;
    display: flex;
}
.upgrade-icon {
    width: 50px;
    height: 50px;
    display: inline-block;
    z-index: 1;
}
.upgrade-icon1 img {
    width: 50px;
    height: 50px;
    border-style: solid;
    border-width: 2px;
    background-color: black;
    border-color: #849FF8;
    border-radius: 5px;
}
.upgrade-icon2 {
    border: solid 2px rgb(230, 194, 86);
    border-radius: 50%;
    background-color: black;
}
.upgrade-icon2 img {
    width: 40px;
    height: 40px;
    margin-left: 3px;
    margin-top: 3px;
}
.upgrade-icon3 {
    width: 55px !important;
    background-color: #A4FA64;
    clip-path:polygon(10% 0%,90% 0%,100% 19%,63% 100%,37% 100%,0% 19%);
    display:inline-block;
}
.upgrade-icon3 .upgrade-icon-inner {
    width:52px;
    height:48px;
    margin-left:1px;
    margin-top:1px;
    background-color: black;
    clip-path:polygon(11% 1%,92% 1%,100% 18%,62% 99%,39% 99%,2% 18%);
    display:inline-block;
}
.upgrade-icon3 img {
    margin-left: 25%;
    margin-top: 15%;
    width: 50%;
    height: 60%;
}
.upgrade-name {
    margin-top: 10px;
    width: 180px;
    height: 40px;
    margin-left: -25px;
    padding-left: 32px;
    padding-top: 2px;
    font-size: 24px;
    background-color: #929292;
}
.upgrade-triangle {
    margin-left: -50px;
    margin-top: 10px;
    height: 40px;
    width: 70px;
    background: linear-gradient(135deg, transparent 35px, #929292 0)bottom right;
    border-right: 2px solid white;
    transform: skew(45deg);
}
.upgrade-options {
    width: 100%;
    max-width: 300px;
    background-color: #313439;
    border-radius: 5px;
}
.upgrade-options2 {
    width: 100%;
    max-width: 300px;
    background-color: #313439;
    color: #fff;
    border-radius: 5px;
}
.upgrade-options-team {
    width: 100%;
    max-width: 500px;
    background-color: #313439;
    border-radius: 5px;
}
.upgrade-options-team2 {
    width: 100%;
    max-width: 500px;
    background-color: #313439;
    color: #fff;
    border-radius: 5px;
}
.upgrade-row {
    width: 100%;
    height: 35px;
    color: #DCDCDC;
}
.left-shade {
    float: left;
    position: relative;
    top: 5px;
    border-left: 3px solid #515560;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    width: 0;
    height: 25px;
}
.upgrade-text {
    float: left;
    padding-left: 5px;
    padding-top: 8px;
}
.upgrade-cost {
    float: right;
    padding-top: 7px;
    padding-right: 8px;
}
.charas-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 5px 5px;
    background: rgba(255,255,255,0.3);
    border-radius: 5px;
    box-shadow: 2px 2px 8px #ddd;
}
.charas-table-td1 {
    width: 15%;
    font-weight: bold;
}
/*</pre>*/</bstyle></includeonly>