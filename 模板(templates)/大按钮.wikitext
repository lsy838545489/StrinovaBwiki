<includeonly><div class="large-wiki-btn">[[{{{1|}}}|{{#ifeq:{{{2|}}}||{{{1|}}}|{{{2|}}}}}]]</div></includeonly><noinclude>[[分类:模板]]{{大按钮|首页}}{{大按钮|首页}}{{大按钮|首页}}{{大按钮|首页}}</noinclude>{{#if:{{#varexists:large-wiki-btn-CSS}} || {{#vardefine:large-wiki-btn-CSS | 1 }}<bstyle>/*<pre>*/
.large-wiki-btn {
	display: inline-block;
	margin: 8px;
}
.large-wiki-btn a {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	min-width: 100px;
	padding: 12px 32px;
	font-size: 16px;
	font-weight: bold;
	color: #3b82f6;
	background-color: rgba(255, 255, 255, 0.9);
	border: 2px solid #93c5fd;
	border-radius: 24px;
	text-decoration: none;
	box-shadow: 0 4px 6px rgba(59, 130, 246, 0.1);
	transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
	position: relative;
	overflow: hidden;
}

@media (hover: hover) and (pointer: fine) {
  .large-wiki-btn a:hover {
  	color: #ffffff;
  	background: linear-gradient(135deg, #60a5fa, #93c5fd);
  	border-color: transparent;
  	box-shadow: 0 6px 12px rgba(59, 130, 246, 0.25);
  	transform: translateY(-2px);
  }
}
.large-wiki-btn a:visited {
	color: #3b82f6;
}

@media (hover: hover) and (pointer: fine) {
  .large-wiki-btn a:visited:hover {
  	color: #ffffff;
  }
}

/* --- 暗色模式 --- */
.client-js.wiki-dark-mode .large-wiki-btn a {
	color: #38bdf8;
	background-color: rgba(30, 41, 59, 0.6);
	border-color: rgba(56, 189, 248, 0.4);
	box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
}

@media (hover: hover) and (pointer: fine) {
  .client-js.wiki-dark-mode .large-wiki-btn a:hover {
  	color: #ffffff;
  	text-shadow: 0 0 6px rgba(255, 255, 255, 0.4);
  	background: linear-gradient(
  		135deg,
  		rgba(37, 99, 235, 0.8),
  		rgba(14, 165, 233, 0.9)
  	);
  	border-color: transparent;
  	box-shadow: 0 6px 16px rgba(14, 165, 233, 0.4);
  }
}
.client-js.wiki-dark-mode .large-wiki-btn a:visited {
	color: #38bdf8;
}

@media (hover: hover) and (pointer: fine) {
  .client-js.wiki-dark-mode .large-wiki-btn a:visited:hover {
  	color: #ffffff;
  }
}
/*</pre>*/</bstyle>}}