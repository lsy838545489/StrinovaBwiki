<bstyle>/*<pre>*/
:root {
    --navbox-bg: rgba(248, 249, 250, 0.6);
    --navbox-border: rgba(255, 255, 255, 0.8);
    --navbox-shadow: rgba(147, 197, 253, 0.2);
    
    --navbox-sub-title-bg: rgba(197, 234, 253, 0.6);
    --navbox-sub-title-text: #1e293b;
    
    --navbox-group-bg: rgba(235, 248, 255, 0.8);
    --navbox-list-bg: rgba(255, 255, 255, 0.5);
    --navbox-inner-border: rgba(255, 255, 255, 0.6);
    
    --navbox-link-hover-bg: rgba(147, 197, 253, 0.3);
    --navbox-link-hover-text: #1d4ed8;
}
.klbq-navbox {
    width: 100%;
    margin: 15px auto;
    background: var(--navbox-bg);
    border: 1px solid var(--navbox-border);
    border-radius: 12px;
    box-shadow: 0 4px 16px var(--navbox-shadow);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow: hidden;
    border-collapse: collapse;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.klbq-story-navbox-title {
    background: linear-gradient(90deg, #ffd34f 0%, #ffd34f 10px, #fef3c7 10px, #fef3c7 100%);
    color: #854d0e;
    font-size: 20px;
    text-align: left;
    padding: 10px 20px;
    font-weight: bold;
    border-bottom: 2px solid #ffd34f;
}
.klbq-navbox .navbox-subgroup .navbox-title {
    background: var(--navbox-sub-title-bg);
    color: var(--navbox-sub-title-text);
    font-size: 1.25rem;
    font-weight: 700;
    text-align: left;
    padding: 6px 15px;
    border-top: 1px solid var(--navbox-inner-border);
    border-bottom: 1px solid var(--navbox-inner-border);
}

.klbq-navbox .navbox-group {
    background: var(--navbox-group-bg);
    font-size: 1.125rem;
    font-weight: 700;
    text-align: center;
    width: 10%;
    padding: 8px 10px;
    border-right: 1px solid var(--navbox-inner-border);
    border-bottom: 1px solid var(--navbox-inner-border);
}

.klbq-navbox .navbox-list {
    background: var(--navbox-list-bg);
    padding: 8px 12px;
    border-bottom: 1px solid var(--navbox-inner-border);
    font-size: 1rem;
    line-height: 1.8;
}
.klbq-navbox tr:last-child .klbq-navbox .navbox-group,
.klbq-navbox tr:last-child .klbq-navbox .navbox-list {
    border-bottom: none;
}
.klbq-navbox .navbox-list a {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 6px;
    transition: all 0.2s ease-in-out;
}

@media (hover: hover) and (pointer: fine) {
  .klbq-navbox .navbox-list a:hover {
      background: var(--navbox-link-hover-bg);
      color: var(--navbox-link-hover-text);
      text-decoration: none;
  }
}

/* 5. 剧情标题前面的小装饰 */
.klbq-story-navbox .navbox span[style*="border-left"] {
    font-weight: bold;
    letter-spacing: 1px;
}
.klbq-story-navbox .kachiu-comm a {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 15px;
    padding: 2px 10px;
    margin: 4px;
    font-size: 1rem;
    box-shadow: 2px 2px 0px rgba(56, 189, 248, 0.2);
}
.klbq-story-navbox .kachiu-comm a::before {
    content: "●";
    color: #22c55e;
    margin-right: 4px;
    font-size: 0.875rem;
    vertical-align: baseline;
}
.klbq-story-navbox .season-plot {
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    padding: 10px;
}
.klbq-story-navbox .season-card {
    position: relative;
    background: #334155;
    color: #f1f5f9;
    padding: 8px 16px;
    border-radius: 4px;
    overflow: hidden;
    min-width: 140px;
    text-align: center;
}
.klbq-story-navbox .season-card::after {
    content: "SEASON";
    position: absolute;
    right: -5px;
    bottom: -10px;
    font-size: 24px;
    font-weight: 900;
    font-style: italic;
    color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
}
.klbq-story-navbox .season-card a {
    color: #ffd34f;
    font-weight: bold;
}
