<includeonly>{{#invoke:Bootstrap|panel}}</includeonly><noinclude>{{Documentation}}[[分类:首页模板]]</noinclude>
{{#if:{{#varexists:首页panel样式}} || {{#vardefine:首页panel样式 | 1 }}<bstyle>/*<pre>*/
.panel {
    padding: 0;
    background: rgba(248, 249, 250, 0.95);
    border-radius: 18px 2px 18px 2px;
    border: 1px solid rgba(0, 172, 193, 0.2);
    box-shadow: 4px 4px 0px rgba(0, 172, 193, 0.05);
    overflow: hidden;
    transition: all 0.3s ease;
}
.panel-heading {
    padding: 12px 20px;
    background: 
        repeating-linear-gradient(45deg, rgba(0, 172, 193, 0.03) 0px, rgba(0, 172, 193, 0.03) 2px, transparent 2px, transparent 4px), 
        linear-gradient(90deg, rgba(96, 165, 250, 0.15) 0%, transparent 100%);
    border-bottom: 2px solid #00acc1;
    display: flex;
    align-items: center;
}
.panel-heading::before {
    content: "";
    width: 6px;
    height: 20px;
    background: #00acc1;
    margin-right: 12px;
    border-radius: 2px;
    box-shadow: 4px 0 0 rgba(0, 172, 193, 0.3);
    display: inline-block;
    animation: pulse-cyan 3s infinite ease-in-out;
}
@keyframes pulse-cyan {
    0% { opacity: 1; }
    50% { opacity: 0.6; }
    100% { opacity: 1; }
}
.panel-title {
    color: #1a202c;
    font-weight: 900;
    font-size: 1.125rem;
    text-transform: uppercase;
    display: flex;
    flex-direction: column;
}
.panel-heading.panel-heading-h2 .panel-title::after {
	content: "Strinova";
	font-size: 0.625rem;
	color: #00acc1;
	opacity: 0.6;
	letter-spacing: 1px;
	margin-top: -2px;
}
.panel-title.panel-title-h3 {
	color: #475569;
	font-size: 1rem;
	border-bottom: 1px dashed #cbd5e1;
	padding: 8px 5px;
	margin: 0 10px;
}
.panel-body {
	padding: 5px 10px;
}

/* -----------暗色模式----------- */
.client-js.wiki-dark-mode .panel {
	background: rgba(15, 23, 42, 0.85);
	border: 1px solid rgba(0, 172, 193, 0.3);
	box-shadow: 4px 4px 0 rgba(0, 172, 193, 0.15);
}
.client-js.wiki-dark-mode .panel-heading {
	background:
		repeating-linear-gradient(
			45deg,
			rgba(0, 172, 193, 0.05) 0,
			rgba(0, 172, 193, 0.05) 2px,
			transparent 2px,
			transparent 4px
		),
		linear-gradient(90deg, rgba(14, 165, 233, 0.25) 0, transparent 100%);
	border-bottom: 2px solid var(--wiki-dark-accent-hover);
}
.client-js.wiki-dark-mode .panel-heading::before {
	background: var(--wiki-dark-accent-hover);
	box-shadow:
		4px 0 0 rgba(0, 172, 193, 0.4),
		0 0 10px rgba(0, 172, 193, 0.5);
}
.client-js.wiki-dark-mode .panel-title {
	color: var(--wiki-dark-text);
}
.client-js.wiki-dark-mode .panel-heading.panel-heading-h2 .panel-title::after {
	color: var(--wiki-dark-accent);
	opacity: 0.8;
}
.client-js.wiki-dark-mode .panel-title.panel-title-h3 {
	color: var(--wiki-dark-text-muted);
	border-bottom: 1px dashed rgba(14, 165, 233, 0.4);
}
.client-js.wiki-dark-mode .panel-body {
	color: var(--wiki-dark-text);
}
/*</pre>*/</bstyle>}}