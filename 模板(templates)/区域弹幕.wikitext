<bstyle>/*<pre>*/
@keyframes toleft{
  from {
    left: 100%;
    transform: translate(0);
  }
  to {
    left: 0%;
    /* 
      transform: translate(-100%);
      TemplateStyles说百分号是无效的属性
      所以这个就写在行内样式里面了
    */
  }
}

.ldanmaku{
  position: absolute;
  left: 100%;
  white-space: nowrap;
  z-index: 1000;
  line-height: 1;
  opacity: 0.7;
  animation-name: toleft;
  animation-duration: 20s;
  animation-timing-function: linear;
  animation-fill-mode: both;
}
/*</pre>*/</bstyle>