<includeonly>{{#invoke:CharaQuote|main}}</includeonly><noinclude>{{Lua|CharaQuote}}{{Documentation}}</noinclude><bstyle>/*<pre>*/
/* stylelint-disable no-descending-specificity */
.voice-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 4px 4px;
    border-radius: 10px;
}

.voice-table tr td[rowspan] {
    width: 15%;
    text-align: center;
    font-weight: bold;
    background-color: #E8E8E8;
}

.voice-table tr td:nth-child(2):not(:last-child) {
    width: 36px;
}

.voice-table tr:nth-child(2n+1) td {
    background-color: rgba(230,230,230,.3);
}

.voice-table tr:nth-child(2n) {
    background-color: rgba(235,248,255,.5);
}

.voice-table tr:first-child td:first-child {
    border-top-left-radius: 8px;
}

.voice-table tr:first-child td:last-child {
    border-top-right-radius: 8px;
}

.voice-table tr:last-child td:last-child {
    border-bottom-right-radius: 8px;
}
.voice-table.nojp tr:last-child td[rowspan],
.voice-table:not(.nojp) tr:nth-last-child(2) td[rowspan] {
    border-bottom-left-radius: 8px;
}
