<includeonly><div class="zombie-card-item" data-rarity="{{{quality}}}"><span class="zombie-card-img">[[文件:生化卡牌_{{{cardID}}}.png|100px|link=]]</span><span class="zombie-card-name">{{{cardName}}}</span></div></includeonly><noinclude>[[分类:模板]]</noinclude>
{{#if:{{#varexists:zombie-card-css}} || {{#vardefine:zombie-card-css | 1 }}<bstyle>/*<pre>*/
.zombie-card-item {
	display: inline-flex;
	flex-direction: column;
	align-items: center;
	margin: 6px;
	border-radius: 8px;
	background-color: rgba(232, 232, 232, 1);
	border-style: solid;
	border-width: 2px;
	text-align: center;
	vertical-align: top;
}
.zombie-card-item[data-rarity="完美"] { 
  border-color: #FFC555; 
}
.zombie-card-item[data-rarity="卓越"] { 
  border-color: #F285FF; 
}
.zombie-card-item[data-rarity="精致"] { 
  border-color: #60A3F7; 
}
.zombie-card-item .zombie-card-img {
	display: block;
	margin-bottom: 8px;
}
.zombie-card-item .zombie-card-name {
	display: block;
	padding: 10px 0;
	font-size: 14px;
	font-weight: 700;
	line-height: 1;
	max-width: 100%;
	word-break: break-word;
	width: 100%;
	border-radius: 0 0 6px 6px;
}
.zombie-card-item[data-rarity="完美"] .zombie-card-name { 
  background-color: #FFC555;
}
.zombie-card-item[data-rarity="卓越"] .zombie-card-name { 
  background-color: #F285FF;
}
.zombie-card-item[data-rarity="精致"] .zombie-card-name { 
  background-color: #60A3F7;
  color: #fff;
}
/*</pre>*/</bstyle>}}