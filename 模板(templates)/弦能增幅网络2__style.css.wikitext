.Growth2 {
	margin-bottom: 1em;
}
.Growth2 .panel{
    border: none;
    border-radius: 0;
    -webkit-box-shadow: none;
    box-shadow: none;
    padding: 0;
	margin-bottom: 0.5em;
    background-color: rgba(0, 0, 0, 0);
}
.Growth2 .panel-title{
    cursor: pointer;
}
.Growth2 .panel-body {
	padding: 5px;
}
.Growth2 .nav-tabs > li {
    display: inline-flex;
    width: 25%;
}
.Growth2 .nav > li > span {
    position: relative;
    display: block;
    padding: 10px 5px;
    margin: 5px;
    font-weight: bold;
    text-align: center;
    width: 100%;
}
.Growth2 .nav-tabs > li > span {
    color: #fff;
    line-height: 1.42857143;
    border: 2px solid rgba(70, 74, 81, 1);
    border-radius: 5px;
    background-color: rgba(70, 74, 81, 1);
}
.Growth2 .nav-tabs > li.active > span, .Growth2 .nav-tabs > li.active > span:hover, .Growth2 .nav-tabs > li.active > span:focus {
    color: #fff;
    border: 2px solid rgba(192,42,53,.8);
    cursor: default;
    background-color: rgba(192,42,53,.8);
}
.Growth2 .progress {
    margin: 0;
}
.Growth2 .btn-primary {
    color: #337ab7;
    background-color: #fff;
    margin-left: 5px;
}
.Growth2 .upgrade-Group-bomb2 {
    width: 100%;
    margin-bottom: 2px;
    background-color: rgba(70, 74, 81, 1);
    border-radius: 5px;
}
.Growth2 .upgrade-top-bomb2 {
    height: 50px;
    width: 100%;
    display: inline-flex;
}
.Growth2 .upgrade-icon-bomb2 {
    width: 50px;
    height: 50px;
}
.Growth2 .upgrade-icon2-bomb2 {
    border: solid 2px rgb(230, 194, 86);
    border-radius: 50%;
    background-color: black;
}
.Growth2 .upgrade-icon2-bomb2 img {
    width: 50px;
    height: 50px;
}
.Growth2 .upgrade-icon3-bomb2 {
    width: 55px !important;
    background-color: #A4FA64;
    clip-path:polygon(10% 0%,90% 0%,100% 19%,63% 100%,37% 100%,0% 19%);
    display:inline-block;
}
.Growth2 .upgrade-icon3-bomb2 img {
    margin-left: 25%;
    margin-top: 15%;
    width: 50%;
    height: 60%;
}
.Growth2 .upgrade-icon3-bomb2 .upgrade-icon-inner {
    width:52px;
    height:48px;
    margin-left:1px;
    margin-top:1px;
    background-color: black;
    clip-path:polygon(11% 1%,92% 1%,100% 18%,62% 99%,39% 99%,2% 18%);
    display:inline-block;
}
.Growth2 .upgrade-name-bomb2  {
    display: inline-flex;
    color: #fff;
    width: 60%;
    margin-left: 5px;
    font-size: 24px;
    align-items: center;
}
.Growth2 .upgrade-icon1 img {
    width: 50px;
    height: 50px;
    border-style: solid;
    border-width: 2px;
    background-color: black;
    border-color: #849FF8;
    border-radius: 5px;
}
.Growth2 .upgrade-icon2 {
    border: solid 2px rgb(230, 194, 86);
    border-radius: 50%;
    background-color: black;
}
.Growth2 .upgrade-icon2 img {
    width: 40px;
    height: 40px;
    margin-left: 3px;
    margin-top: 3px;
}
.Growth2 .upgrade-icon3 {
    width: 55px !important;
    background-color: #A4FA64;
    clip-path:polygon(10% 0%,90% 0%,100% 19%,63% 100%,37% 100%,0% 19%);
    display:inline-block;
}
.Growth2 .upgrade-icon3 .upgrade-icon-inner {
    width:52px;
    height:48px;
    margin-left:1px;
    margin-top:1px;
    background-color: black;
    clip-path:polygon(11% 1%,92% 1%,100% 18%,62% 99%,39% 99%,2% 18%);
    display:inline-block;
}
.Growth2 .upgrade-icon3 img {
    margin-left: 25%;
    margin-top: 15%;
    width: 50%;
    height: 60%;
}
.Growth2 .upgrade-Maxvalue {
    display: inline-flex;
    width: 25%;
    font-size: 24px;
    align-items: center;
}
.Growth2 #枪械强化 .upgrade-Maxvalue {
    color: #7ca0ff;
}
.Growth2 #技能强化 .upgrade-Maxvalue {
    color: #e5c04e;
}
.Growth2 #超弦体强化 .upgrade-Maxvalue {
    color: #67c75b;
}
.Growth2 .upgrade-options-bomb2 {
    width: 100%;
    border-radius: 5px;
}
.Growth2 #枪械强化 .upgrade-options-bomb2, .Growth2 #技能强化 .upgrade-options-bomb2, .Growth2 #超弦体强化 .upgrade-options-bomb2 {
    color: #000;
}
.Growth2 #枪械强化 .upgrade-row {
    background-color: rgba(124,160,255,.7);
}
.Growth2 #技能强化 .upgrade-row {
    background-color: rgba(229,192,78,.7);
}
.Growth2 #超弦体强化 .upgrade-row {
    background-color: rgba(103,199,91,.7);
}
.Growth2 .upgrade-row {
	display: inline-flex;
    align-items: center;
    width: 100%;
    height: 35px;
    color: #000;
    border-radius: 5px;
    cursor: pointer;
}
.Growth2 .left-shade {
    position: relative;
    border-left: 3px solid #515560;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    width: 0;
    height: 25px;
}
.Growth2 .upgrade-text {
	display: inline-flex;
	align-items: center;
	margin-right: auto;
    padding-left: 5px;
    font-weight: bold;
}
.Growth2 .upgrade-cost {
	display: inline-flex;
    align-items: center;
    margin-left: auto;
    padding-right: 8px;
}