.buff {
  position: relative;
  padding: 7px 2px 1px 30px;
  color: white;
  font-weight: bold;
  font-size: 14px;
  background: rgb(93,145,65);
  text-shadow: 0 1px 1px rgba(0,0,0,0.3);
  height: 30px;
}

.buff::after {
  content: '';
