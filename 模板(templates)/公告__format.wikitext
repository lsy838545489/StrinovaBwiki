<div class="klbq-notice-item__main">
<div class="klbq-notice-item__title">[[{{{1|}}}]]</div>
<div class="klbq-notice-item__time">{{#invoke:TimeNormalizer|to_chinese_time|{{{公告发布时间|}}}}}</div>
</div>
<div class="klbq-notice-item__links"><!--
-->{{#if:{{{公告B站发布链接|}}}|{{a|href={{{公告B站发布链接}}}|content=B站公告|class=klbq-notice-item__link klbq-notice-item__link--bilibili}}}}<!--
-->{{#if:{{{公告官网发布链接|}}}|{{a|href={{{公告官网发布链接}}}|content=官网公告|class=klbq-notice-item__link klbq-notice-item__link--official}}}}
</div>
</div></includeonly><noinclude>[[分类:SMW模板]]</noinclude>
{{#if:{{#varexists:klbq-notice-item-CSS}} || {{#vardefine:klbq-notice-item-CSS | 1 }}<bstyle>/*<pre>*/
.klbq-notice-list { /* --- 公告列表外层容器 --- */
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 12px 0;
}
.klbq-notice-item { /* --- 单行公告卡片 --- */
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(248, 249, 250, 0.85);
    border: 1px solid rgba(147, 197, 253, 0.4);
    border-left: 4px solid #3b82f6;
    border-radius: 8px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@media (hover: hover) and (pointer: fine) {
  .klbq-notice-item:hover {
      background: rgba(255, 255, 255, 0.95);
      border-color: rgba(147, 197, 253, 0.8);
      border-left-color: #00acc1;
      transform: translateX(4px);
      box-shadow: 0 4px 12px rgba(59, 130, 246, 0.12);
  }
}
.klbq-notice-item__main { /* --- 主信息区（标题与时间） --- */
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
    min-width: 0;
}
.klbq-notice-item__title {
    font-size: 0.95rem;
    font-weight: 700;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}
.klbq-notice-item__title a {
    color: #334155;
    text-decoration: none;
    transition: color 0.2s ease;
}

@media (hover: hover) and (pointer: fine) {
  .klbq-notice-item:hover .klbq-notice-item__title a {
      color: #00acc1;
  }
}
.klbq-notice-item__time {
    font-size: 0.825rem;
    color: #64748b;
    flex-shrink: 0;
    font-family: Consolas, monospace;
}
.klbq-notice-item__links { /* --- 外部发布链接按钮组 --- */
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
}

@media (hover: hover) and (pointer: fine) {
  .klbq-notice-item__link,
  .klbq-notice-item__link:link,
  .klbq-notice-item__link:visited,
  .klbq-notice-item__link:hover,
  .klbq-notice-item__link:active,
  .klbq-notice-item__link.external,
  .klbq-notice-item__link.external:hover {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 4px 12px;
      font-size: 0.75rem;
      font-weight: bold;
      border-radius: 6px;
      transition: all 0.2s ease;
  }
}
.klbq-notice-item__link--bilibili,
.klbq-notice-item__link--bilibili:visited { /* B站蓝色胶囊按钮 */
    color: #02b0da !important;
    background: rgba(2, 176, 218, 0.1);
    border: 1px solid rgba(2, 176, 218, 0.3);
}

@media (hover: hover) and (pointer: fine) {
  .klbq-notice-item__link--bilibili:hover {
      color: #fff !important;;
      background: #02b0da;
      box-shadow: 0 2px 8px rgba(2, 176, 218, 0.3);
  }
}
.klbq-notice-item__link--official,
.klbq-notice-item__link--official:visited { /* 官网胶囊按钮 */
    color: #ff6b2f !important;
    background: rgba(255, 107, 47, 0.1);
    border: 1px solid rgba(255, 107, 47, 0.3);
}

@media (hover: hover) and (pointer: fine) {
  .klbq-notice-item__link--official:hover {
      color: #fff !important;;
      background: #ff6b2f;
      box-shadow: 0 2px 8px rgba(255, 107, 47, 0.3);
  }
}
@media screen and (max-width: 768px) { /* --- 移动端自适应 --- */
    .klbq-notice-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 10px 12px;
    }
    .klbq-notice-item__main {
        flex-direction: column;
        align-items: flex-start;
        gap: 4px;
        width: 100%;
    }
    .klbq-notice-item__title {
        white-space: normal;
        line-height: 1.4;
    }
    .klbq-notice-item__links {
        width: 100%;
        justify-content: flex-end;
        border-top: 1px dashed rgba(147, 197, 253, 0.3);
        padding-top: 6px;
    }
}

/* --- 暗色模式适配 (Dark Mode) --- */
.client-js.wiki-dark-mode .klbq-notice-item {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(255, 255, 255, 0.1);
    border-left-color: var(--wiki-dark-accent, #38bdf8);
}

@media (hover: hover) and (pointer: fine) {
  .client-js.wiki-dark-mode .klbq-notice-item:hover {
      background: rgba(30, 41, 59, 0.95);
      border-color: rgba(14, 165, 233, 0.5);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
  }
}
.client-js.wiki-dark-mode .klbq-notice-item__title a {
    color: var(--wiki-dark-text, #f1f5f9);
}
.client-js.wiki-dark-mode .klbq-notice-item__time {
    color: #94a3b8;
}
/*</pre>*/</bstyle>}}