.client-js.wiki-dark-mode .infect-pass__content { background: rgba(51, 65, 85, 0.9); color: #E2E8F0; box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 0 0 1px rgba(168, 85, 247, 0.2); }
@media (hover: hover) and (pointer: fine) {
  /* WIKI类名暗色 */
