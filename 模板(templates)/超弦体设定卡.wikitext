<bstyle>/*<pre>*/
.klbq-role-info {
	float:none;
	margin:0 auto;
	display:flex;
	flex-direction:row-reverse;
	justify-content:space-between;
	align-items:center;
	border-radius: 10px; 
    background:transparent; 
    overflow:hidden;
	width:100%;
	max-width:100%;
	box-sizing:border-box;
	overflow: hidden;
	position: relative;
	padding: 10px;
}

/**内容**/
.klbq-role-info .text {
	width: 1px; /*这个有用*/
	flex: 1 2 490px;
	margin-top: 10px;
}
/*header*/
.klbq-role-info .head {
	display: flex;
}
.klbq-role-info .icon {
	position: relative;
	width: 88px;
	height: 88px;
	-webkit-user-select: none;
	user-select: none;
	z-index: 2;
}
.klbq-role-info .icon img {
	position: relative;
}
.klbq-role-info .id {
	color:rgb(65,67,79);
	flex: 1;
	z-index: 3;
}
.klbq-role-info .name {
	border-bottom:2px solid rgb(92,94,123);
	font-size:27px;
	line-height: 1.2;
	margin-bottom: 5px;
}
.klbq-role-info .data {
	display: flex;
	justify-content: space-between;
	flex-flow: row wrap;
	white-space: nowrap;
	column-gap: 1.5em;
}
/*信息*/
.klbq-role-info dl {
	margin: 20px 0 0;
	line-height: 27px;
	z-index: 3;
}
.klbq-role-info dl>div {
	display: flex;
	flex-flow: row wrap;
	align-items: flex-start;
	margin: 3px 0;
}
.klbq-role-info dt {
	color: #FFF;
	flex:0 100px;
	margin:0;
	background:linear-gradient(to right,rgba(136,141,163,0.842),rgba(166,174,199,0.788));
	padding:0 10px;
	font-weight:bold;
}
.klbq-role-info dd {
	margin:0 0 0 12px;
	border-bottom:1px dashed rgb(92,94,123);
	flex: 1 18em;
}
@media screen and (max-width:768px){
	.klbq-role-info{
		flex-wrap:wrap;
		justify-content:center;
		width:100%!important;
	}
}
