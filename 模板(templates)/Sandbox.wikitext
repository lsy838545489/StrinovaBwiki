		1px -1px 0 #fff,
		-1px 1px 0 #fff,
		1px 1px 0 #fff,
		0 0 6px rgba(255, 255, 255, 0.8),
		0 2px 10px var(--current-quality),
		0 4px 18px var(--current-quality);
}
.items-icon .items-icon-text[data-type]::before {
	display: block;
	content: attr(data-type);
	font-size: 12px;
	color: #94a3b8;
	margin-bottom: 2px;
	text-align: left;
}
