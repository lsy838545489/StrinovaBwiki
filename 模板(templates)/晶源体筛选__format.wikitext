{{#if:{{{晶源体特性|}}}|<div class="klbq-crystal-card__traits"><span class="klbq-crystal-card__label">晶源体特性：</span><div class="klbq-crystal-card__trait-list">{{#arraymap:{{{晶源体特性|}}}|、|@|<span class="klbq-crystal-card__trait">@</span>| }}</div></div>}}
