{{#if:{{#varexists:klbq-crystal-card-CSS}} || {{#vardefine:klbq-crystal-card-CSS | 1 }}<bstyle>/*<pre>*/
/* --- 晶源体卡片 Block --- */
.klbq-crystal-card {
    background: rgba(248, 249, 250, 0.9);
    border-radius: 16px;
    border: 1px solid rgba(240, 106, 106, 0.25);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    position: relative;
    z-index: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
}
.klbq-crystal-card::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 20%;
    background: linear-gradient(
        to bottom,
        transparent,
        rgba(240, 106, 106, 0.08),
        transparent
    );
    pointer-events: none;
    opacity: 0;
}
.klbq-crystal-card::before {
    content: attr(data-id);
    position: absolute;
    top: 9px;
    right: -25px;
    width: 82px;
    height: 21px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Roboto Mono", "Consolas", monospace;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1;
    color: #64748b;
    transform: rotate(35deg);
    pointer-events: none;
    z-index: 5;
}
@media (hover: hover) and (pointer: fine) {
    .klbq-crystal-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(240, 106, 106, 0.2);
        border-color: rgba(240, 106, 106, 0.5);
        z-index: 2;
    }
    .klbq-crystal-card:hover::after {
        opacity: 1;
        animation: klbq-card-scan 1.2s ease-out;
    }
}
@keyframes klbq-card-scan {
    from {
        top: -20%;
    }
    to {
        top: 100%;
    }
}

/* --- 图片展示区 (带顶部微弱赤红渐变) --- */
.klbq-crystal-card__imagebox {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 16px 0 8px 0;
    background: linear-gradient(180deg, rgba(240, 106, 106, 0.1) 0%, rgba(240, 106, 106, 0) 100%);
}
.klbq-crystal-card__imagebox::before {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    right: -25px;
    top: 15px;
    border: 1px solid rgba(0, 172, 193, .12);
    transform: rotate(45deg);
}
.klbq-crystal-card__imagebox img {
    object-position: center;
    object-fit: contain;
    transition: transform 0.3s ease;
}

/* --- 内容信息区 --- */
.klbq-crystal-card__captionbox {
    display: flex;
    flex-direction: column;
    padding: 4px 10px 12px 10px;
    color: #475569;
    flex-grow: 1;
}

.klbq-crystal-card__name {
    color: #334155;
    font-weight: bold;
    font-size: 1.2rem;
    text-align: center;
    padding: 6px 0;
    margin-bottom: 8px;
    background: linear-gradient(90deg, transparent, rgba(240, 106, 106, 0.15), transparent);
    border-bottom: 1px dashed rgba(240, 106, 106, 0.4);
}

.klbq-crystal-card__desc {
    display: flex;
    flex-direction: column;
    padding: 8px 10px;
    margin-bottom: 8px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 8px;
    border: 1px solid rgba(240, 106, 106, 0.15);
    font-size: 0.85rem;
    line-height: 1.5;
}

.klbq-crystal-card__traits {
    display: flex;
    position: relative;
    flex-direction: column;
    padding: 8px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 8px;
    border: 1px solid rgba(240, 106, 106, 0.15);
}

.klbq-crystal-card__trait-list {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
}

.klbq-crystal-card__trait {
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 12px;
    background: rgba(255, 154, 154, 0.15);
    color: #e05252;
    border: 1px solid rgba(240, 106, 106, 0.3);
}

.klbq-crystal-card__label {
    color: #64748b;
    font-size: 12px;
    margin-bottom: 2px;
}

.klbq-crystal-card__value {
    color: #334155;
}
.klbq-crystal-card__traits::before {
    content: "TRAIT";
    position: absolute;
    right: 8px;
    top: 6px;
    font-size: 8px;
    letter-spacing: 1px;
    opacity: .35;
}
.klbq-crystal-card__trait::before {
    content: "◆";
    font-size: .6em;
    margin-right: 4px;
}
/* --- 暗色模式适配 (Dark Mode) --- */
.client-js.wiki-dark-mode .klbq-crystal-card {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(239, 68, 68, 0.3);
}


@media (hover: hover) and (pointer: fine) {
  .client-js.wiki-dark-mode .klbq-crystal-card:hover {
      box-shadow: 0 8px 24px rgba(239, 68, 68, 0.25);
      border-color: rgba(239, 68, 68, 0.6);
  }
}

.client-js.wiki-dark-mode .klbq-crystal-card__imagebox {
    background: linear-gradient(180deg, rgba(239, 68, 68, 0.12) 0%, rgba(15, 23, 42, 0) 100%);
}

.client-js.wiki-dark-mode .klbq-crystal-card__trait {
    background: rgba(248, 113, 113, 0.15);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.4);
}

.client-js.wiki-dark-mode .klbq-crystal-card__name {
    color: var(--wiki-dark-text, #f1f5f9);
    background: linear-gradient(90deg, transparent, rgba(239, 68, 68, 0.25), transparent);
    border-bottom-color: rgba(239, 68, 68, 0.4);
}

.client-js.wiki-dark-mode .klbq-crystal-card__desc,
.client-js.wiki-dark-mode .klbq-crystal-card__traits {
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(239, 68, 68, 0.25);
}

.client-js.wiki-dark-mode .klbq-crystal-card__label { color: #94a3b8; }
.client-js.wiki-dark-mode .klbq-crystal-card__value { color: var(--wiki-dark-text, #f1f5f9); }
/*</pre>*/</bstyle>}}