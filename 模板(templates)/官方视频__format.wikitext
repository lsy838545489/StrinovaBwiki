{{#if:{{#varexists:klbq-official-video-css}} || {{#vardefine:klbq-official-video-css | 1 }}<bstyle>/*<pre>*/
/* --- 视频网格外层容器 (CSS Grid) --- */
.klbq-video-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 16px;
    margin: 12px 0;
}

/* 移动端单列/双列弹性适应 */
@media screen and (max-width: 600px) {
    .klbq-video-grid {
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 10px;
    }
}

/* --- 卡片 Block --- */
.klbq-video-card {
    display: flex;
    flex-direction: column;
    background: rgba(248, 249, 250, 0.9);
    border: 1px solid rgba(226, 232, 240, 0.8);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    height: 100%;
}

@media (hover: hover) and (pointer: fine) {
    .klbq-video-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 20px rgba(0, 172, 193, 0.18);
        border-color: rgba(0, 172, 193, 0.5);
    }
}

/* --- 视频封面区 (固定 16:9 或 2:1.4 比例) --- */
.klbq-video-card__cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgba(160, 207, 255, 0.1);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
}

.klbq-video-card__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 0.4s ease;
}

.klbq-video-card:hover .klbq-video-card__cover img {
    transform: scale(1.05);
}

/* --- 文本与信息区 --- */
.klbq-video-card__caption {
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex-grow: 1;
    gap: 6px;
}

.klbq-video-card__title {
    font-size: 0.875rem;
    font-weight: bold;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.klbq-video-card__title a {
    color: #334155;
    text-decoration: none;
    transition: color 0.2s ease;
}

.klbq-video-card__title a:hover {
    color: #00acc1;
}

.klbq-video-card__meta {
    font-size: 0.75rem;
    color: #94a3b8;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* --- 全站暗色模式适配 (Dark Mode) --- */
.client-js.wiki-dark-mode .klbq-video-card {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(255, 255, 255, 0.1);
}

.client-js.wiki-dark-mode .klbq-video-card__title a {
    color: var(--wiki-dark-text, #f1f5f9);
}

.client-js.wiki-dark-mode .klbq-video-card__title a:hover {
    color: var(--wiki-dark-accent, #38bdf8);
}
