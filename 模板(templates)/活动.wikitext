<includeonly>{{#set:
|活动名={{{活动名|{{PAGENAME}}}}}
|活动图片={{{活动图片|}}}
|活动开始时间={{#invoke:TimeNormalizer|format_time|{{{活动开始时间|}}}}}
|活动结束时间={{#invoke:TimeNormalizer|format_time|{{{活动结束时间|}}}}}
|活动简介={{{活动简介|}}}
}}
<div class="klbq-event-header">
<div class="klbq-event-header__banner">[[文件:{{{活动图片}}}|600px|alt={{{活动名|{{PAGENAME}}}}}]]</div>
<div class="klbq-event-header__content">
<div class="klbq-event-header__title">{{{活动名|{{PAGENAME}}}}}</div>
<div class="klbq-event-header__time-group">
<div class="klbq-event-header__time-item"><span class="klbq-event-header__label">开始时间：</span><span class="klbq-event-header__value"><time>{{{活动开始时间}}}</time></span></div>
<div class="klbq-event-header__time-item"><span class="klbq-event-header__label">结束时间：</span><span class="klbq-event-header__value"><time>{{{活动结束时间}}}</time></span></div>
</div>
<div class="klbq-event-header__desc">{{{活动简介}}}</div>
</div>
</div>
{{#if:{{{nocat|}}}||[[分类:活动]]}}</includeonly><noinclude>[[分类:模板]]</noinclude>
<bstyle>/*<pre>*/
/* --- 战术活动页头 Block --- */
.klbq-event-header {
    display: flex;
    flex-direction: row;
    gap: 16px;
    background: rgba(248, 249, 250, 0.85);
    border: 1px solid rgba(147, 197, 253, 0.4);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 16px;
    margin-bottom: 20px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
    box-sizing: border-box;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* --- 海报图展示区 --- */
.klbq-event-header__banner {
    flex: 0 0 320px;
    max-width: 40%;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(160, 207, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
}

.klbq-event-header__banner img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
}

/* --- 内容信息区 --- */
.klbq-event-header__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
}

.klbq-event-header__title {
    font-size: 1.4rem;
    font-weight: bold;
    color: #1e293b;
    border-bottom: 2px dashed rgba(147, 197, 253, 0.5);
    padding-bottom: 8px;
    letter-spacing: 0.5px;
}

.klbq-event-header__time-group {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    background: rgba(255, 255, 255, 0.6);
    padding: 8px 12px;
    border-radius: 10px;
    border: 1px solid rgba(147, 197, 253, 0.25);
    font-size: 0.9rem;
}

.klbq-event-header__time-item {
    display: flex;
    align-items: center;
    gap: 4px;
}

.klbq-event-header__label {
    color: #64748b;
    font-size: 0.85rem;
}

.klbq-event-header__value {
    color: #00acc1;
    font-weight: 700;
}

.klbq-event-header__desc {
    font-size: 0.925rem;
    color: #475569;
    line-height: 1.6;
    background: rgba(255, 255, 255, 0.5);
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(147, 197, 253, 0.2);
    flex-grow: 1;
}

/* --- 移动端响应式布局适配 --- */
@media screen and (max-width: 768px) {
    .klbq-event-header {
        flex-direction: column;
        padding: 12px;
        gap: 12px;
    }
    
    .klbq-event-header__banner {
        flex: 1 1 100%;
        max-width: 100%;
        width: 100%;
    }
    
    .klbq-event-header__title {
        font-size: 1.2rem;
        text-align: center;
    }

    .klbq-event-header__time-group {
        flex-direction: column;
        gap: 6px;
    }
}

/* --- 暗色模式适配 (Dark Mode) --- */
.client-js.wiki-dark-mode .klbq-event-header {
    background: rgba(30, 41, 59, 0.85);
    border-color: rgba(14, 165, 233, 0.3);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
}

.client-js.wiki-dark-mode .klbq-event-header__banner {
    background: rgba(15, 23, 42, 0.6);
}

.client-js.wiki-dark-mode .klbq-event-header__title {
    color: var(--wiki-dark-text, #f1f5f9);
    border-bottom-color: rgba(14, 165, 233, 0.4);
}

.client-js.wiki-dark-mode .klbq-event-header__time-group,
.client-js.wiki-dark-mode .klbq-event-header__desc {
    background: rgba(15, 23, 42, 0.6);
    border-color: rgba(14, 165, 233, 0.25);
}

.client-js.wiki-dark-mode .klbq-event-header__label {
    color: #94a3b8;
}

.client-js.wiki-dark-mode .klbq-event-header__value {
    color: var(--wiki-dark-accent, #38bdf8);
}

.client-js.wiki-dark-mode .klbq-event-header__desc {
    color: var(--wiki-dark-text, #f1f5f9);
}
/*</pre>*/</bstyle>