<includeonly><div class="Music163"><span>{{{id|}}}</span><span>{{#switch:{{{type|}}}|program=3|song=2|playlist=0|{{{type|2}}}}}</span></div>{{ResourceLoader|MediaWiki:Music163.js}}</includeonly><noinclude>
== 参数列表 ==
<pre>
	#type		song / playlist
	#id		分享链接的第一串id (两个斜杠中间的数字)
</pre>
== 示例 ==
代码
<pre>
{{网易云音乐|id=2497339114|type=program}}
{{网易云音乐|id=1384849524|type=song}}
{{网易云音乐|id=2712462966|type=playlist}}
</pre>
显示为
{{网易云音乐|id=2497339114|type=program}}
{{网易云音乐|id=1384849524|type=song}}
{{网易云音乐|id=2712462966|type=playlist}}

