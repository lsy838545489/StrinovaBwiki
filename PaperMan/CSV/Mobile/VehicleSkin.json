      "63000023": {
        "Id": 63000023,
        "BoolLoad": false,
        "AvailableState": 1,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000023_Name",
          "SourceString": "地心专列",
          "LocalizedString": "地心专列"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000023_Desc",
          "SourceString": "调皮的小恶魔驾驶着专列，包裹着炽热的熔岩从地心驶来。想拦住她，恐怕要费一番力气。\n\n【“地面上的交通规则，好复杂啊……”】",
          "LocalizedString": "调皮的小恶魔驾驶着专列，包裹着炽热的熔岩从地心驶来。想拦住她，恐怕要费一番力气。\n\n【“地面上的交通规则，好复杂啊……”】"
