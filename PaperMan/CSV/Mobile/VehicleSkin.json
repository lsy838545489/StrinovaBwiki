      "63000024": {
        "Id": 63000024,
        "BoolLoad": false,
        "AvailableState": 0,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000024_Name",
          "SourceString": "货拉拉-超能运输",
          "LocalizedString": "货拉拉-超能运输"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000024_Desc",
          "SourceString": "货拉拉冠名的移动货仓涂装。\n\n白墨的绝密私人仓库即将搬迁。传闻，这个仓库具有能够撼动区域金融版图的超高价值，各方势力都对它虎视眈眈。各家货运公司纷纷上门，希望能拿下这一单，为背后的势力打探虚实。\n然而，白墨拒绝了卡丘世界所有的载具公司。\n\n“老家伙们的小伎俩逃不过我的眼睛。”白墨敲了敲桌面上那抹亮眼的橙黄色，“信任、专业、高效，我有更好的选择。”\n\n超能货运品牌货拉拉突破位面而来，运力无限！",
          "LocalizedString": "货拉拉冠名的移动货仓涂装。\n\n白墨的绝密私人仓库即将搬迁。传闻，这个仓库具有能够撼动区域金融版图的超高价值，各方势力都对它虎视眈眈。各家货运公司纷纷上门，希望能拿下这一单，为背后的势力打探虚实。\n然而，白墨拒绝了卡丘世界所有的载具公司。\n\n“老家伙们的小伎俩逃不过我的眼睛。”白墨敲了敲桌面上那抹亮眼的橙黄色，“信任、专业、高效，我有更好的选择。”\n\n超能货运品牌货拉拉突破位面而来，运力无限！"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000024_SpDesc",
          "SourceString": "贴车时，获得5%的移速和减伤",
          "LocalizedString": "贴车时，获得5%的移速和减伤"
        },
