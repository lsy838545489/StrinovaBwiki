      "63000020": {
        "Id": 63000020,
        "BoolLoad": false,
        "AvailableState": 1,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_Name",
          "SourceString": "圣城传讯",
          "LocalizedString": "圣城传讯"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_Desc",
          "SourceString": "歌剧院的舞台上，一出神话戏剧即将上演。应援车从圣城出发，驶向大街小巷，带来女神的传讯。\n\n【“迷途的人们啊，请跟随我的指引，到达神圣的终点吧。”】",
          "LocalizedString": "歌剧院的舞台上，一出神话戏剧即将上演。应援车从圣城出发，驶向大街小巷，带来女神的传讯。\n\n【“迷途的人们啊，请跟随我的指引，到达神圣的终点吧。”】"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_SpDesc",
          "SourceString": "载具附近每2秒恢复1生命值",
          "LocalizedString": "载具附近每2秒恢复1生命值"
