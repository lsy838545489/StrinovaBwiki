        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": []
      },
      "8": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 146,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_146.T_Dynamic_RolePorfile_146",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "1DC00D8B4D591EEBDD9B80A3B132750D",
          "SourceString": "但不是讨厌的感觉！有点像踩在云朵上，轻飘飘的，软绵绵的……",
          "LocalizedString": "But it wasn't an unpleasant feeling! It felt like walking on clouds, all floaty and soft."
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
