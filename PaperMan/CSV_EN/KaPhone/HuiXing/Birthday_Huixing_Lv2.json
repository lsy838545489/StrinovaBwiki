        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "9C3601F34145F0C7370F1BA52AF2D40F",
          "SourceString": "吃完前辈给我准备的蛋糕后，感觉晕乎乎的，有一点像小时候偷吃太多酒心巧克力那次……",
          "LocalizedString": "After having the cake you made for me, I felt a little lightheaded, almost like when I ate too many chocolate liqueurs as a kid..."
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
