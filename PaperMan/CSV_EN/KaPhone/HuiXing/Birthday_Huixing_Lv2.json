        "TextContentList": [
          {
            "Namespace": "",
            "Key": "9464D97C42147523BA7741A2D999497E",
            "SourceString": "不太像是星绘会说出来的话呢。",
            "LocalizedString": "That doesn't quite sound like something you'd say, Celestia."
          },
          {
            "Namespace": "",
            "Key": "3F1E5D6843C46C9AFB3AD1BD3E824068",
            "SourceString": "虽然很确定只吃了蛋糕，但这个状态很奇妙啊。",
            "LocalizedString": "I'm sure it was just cake, but this feeling is pretty unique."
          }
        ],
        "EmojiList": [],
