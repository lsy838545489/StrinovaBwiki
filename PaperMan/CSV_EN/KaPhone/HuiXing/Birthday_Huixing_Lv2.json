        "TextContentList": [
          {
            "Namespace": "",
            "Key": "FB25FFC8446126E2ACCF758C7208D41F",
            "SourceString": "咖啡？醉？",
            "LocalizedString": "Coffee? Tipsy?"
          },
          {
            "Namespace": "",
            "Key": "FF54572D405E4C3FC958468645CFCF42",
            "SourceString": "咖啡的功效不是让人保持清醒吗？",
            "LocalizedString": "Isn't coffee supposed to keep you awake?"
          }
        ],
        "EmojiList": [],
