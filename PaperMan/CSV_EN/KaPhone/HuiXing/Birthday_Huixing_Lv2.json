      "7": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 146,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_146.T_Dynamic_RolePorfile_146",
          "SubPathString": ""
