        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "Lawine_128_Lv_7",
          "Key": "Row11_TextContent_FromRoleId128",
          "SourceString": "香包原本是用来辟邪和祈福的。",
          "LocalizedString": "Sachets were once used to ward off evil spirits and pray for blessings."
