        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "01E8D58D49BA514E223D23AFF06584EC",
          "SourceString": "这周末一起吃晚餐吧？我订了你最喜欢的餐厅。你不来的话……主厨会很失望的！",
          "LocalizedString": "Let's have dinner this weekend, okay? I've already booked your favorite restaurant. If you don't show up… the chef will be very disappointed!"
