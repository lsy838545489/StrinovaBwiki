        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "10801AA5473C54A628A1FB9264264B7D",
          "SourceString": "生日的意义，在此刻终于体现。",
          "LocalizedString": "This moment is what gives my birthday real meaning."
        },
