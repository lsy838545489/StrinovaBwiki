        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "E0E40502497C1CC9A141EBBE4BE02D54",
          "SourceString": "但你给了我品尝过苦涩后，终究会获得希望的甜。",
          "LocalizedString": "But you've reminded me that even after all the bitterness, there's still sweetness waiting at the end."
        },
