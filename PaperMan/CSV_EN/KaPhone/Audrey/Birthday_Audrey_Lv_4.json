        "TextContentList": [
          {
            "Namespace": "",
            "Key": "859080EF4C8578ECF9A83C8936A2A632",
            "SourceString": "突然这么正式我还有点不习惯……",
            "LocalizedString": "You sound so serious all of a sudden—it's kind of surprising."
          },
          {
            "Namespace": "",
            "Key": "8D7D58574D33A08FA27515B73A284BF8",
            "SourceString": "但，为奥黛丽庆祝生日是我想做的事。",
            "LocalizedString": "But celebrating your birthday is something I wanted to do."
          },
          {
            "Namespace": "",
            "Key": "399197544CA3CC4FAD3B4C89C9FF7DA3",
            "SourceString": "所以，不需要谢谢，只要开心收下就好了。",
            "LocalizedString": "So you don't have to thank me—just be happy and accept it."
          }
        ],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": [
          "9",
          "9",
          "9"
        ]
