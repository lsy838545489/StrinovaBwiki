      "14": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 105,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_105.T_Dynamic_RolePorfile_105",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "72D101034FA0F87F60EA8BADEBEF1F45",
          "SourceString": "辛苦是人生的常态，接手家族的那一刻，我也接受了这种命运。",
          "LocalizedString": "Hard work is just part of life. The moment I took over the family, I accepted that fate."
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
