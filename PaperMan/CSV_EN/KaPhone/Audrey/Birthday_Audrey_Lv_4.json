        "TextContentList": [
          {
            "Namespace": "",
            "Key": "0BC0E519443DBE9BEA47D984C224FA86",
            "SourceString": "希望你顺利忙完工作，我们好久没见面了。",
            "LocalizedString": "Hope you get through work smoothly. It's been too long since we last met."
          }
