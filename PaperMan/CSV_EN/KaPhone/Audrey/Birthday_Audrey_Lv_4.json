      "9": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 105,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_105.T_Dynamic_RolePorfile_105",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "E4E3626C4AFF3AA4CAC3ABA7DECB1071",
          "SourceString": "今天，我出席了三场会议，参加了两场私人聚会，喝了两次下午茶，听到了无数句“生日快乐”。",
          "LocalizedString": "Today, I attended three meetings, two private gatherings, had two afternoon teas, and heard countless \"happy birthdays.\""
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "10",
        "OptionType": "ECyCommunicationOptionType::None",
        "TextContentList": [],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": []
      },
      "10": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 105,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_105.T_Dynamic_RolePorfile_105",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "5FCF575A4A77213CF0DA65B2DFB58636",
          "SourceString": "但只有此刻收到你心意的我，是真正的幸福。",
          "LocalizedString": "But only now—reading your message—do I feel truly happy."
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
