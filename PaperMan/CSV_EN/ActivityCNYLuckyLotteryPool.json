[
  {
    "Type": "DataTable",
    "Name": "ActivityCNYLuckyLotteryPool",
    "Class": "UScriptClass'DataTable'",
    "Flags": "RF_Public | RF_Standalone | RF_Transactional | RF_WasLoaded | RF_LoadCompleted",
    "Properties": {
      "RowStruct": {
        "ObjectName": "ScriptStruct'CyActivityCNYLuckyLotteryPoolTableRow'",
        "ObjectPath": "/Script/PMGame"
      }
    },
    "Rows": {
      "1": {
        "Id": 1,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "1_Name",
          "SourceString": "长相守",
          "LocalizedString": "Enduring Couple"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "1_Content",
          "SourceString": "身无彩凤双飞翼，\n心有灵犀一点通。",
          "LocalizedString": "Though I have no wings like those of the bright phoenix for my body,\nI feel the harmonious heartbeat of the sacred."
        }
      },
      "2": {
        "Id": 2,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "2_Name",
          "SourceString": "好运来",
          "LocalizedString": "Fortune Cometh"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "2_Content",
          "SourceString": "长风破浪会有时，\n直挂云帆济沧海。",
          "LocalizedString": "The wind blows, breaking against waves.\nSails set high, crossing the vast seas."
        }
      },
      "3": {
        "Id": 3,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "10_Name",
          "SourceString": "钱多多",
          "LocalizedString": "Windfall"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "3_Content",
          "SourceString": "财禄盈门喜迎新，\n富贵荣华笑逐春。",
          "LocalizedString": "As joy fills home, New Year's cheer.\nWealth and fortune, springtime nears."
        }
      },
      "4": {
        "Id": 4,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "2_Name",
          "SourceString": "好运来",
          "LocalizedString": "Fortune Cometh"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "4_Content",
          "SourceString": "千门万户曈曈日，\n总把新桃换旧符。",
          "LocalizedString": "In countless homes, each passing stay,\nold ways yield on the new day."
        }
      },
      "5": {
        "Id": 5,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "2_Name",
          "SourceString": "好运来",
          "LocalizedString": "Fortune Cometh"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "5_Content",
          "SourceString": "如沐春风里，\n乘风上九霄。",
          "LocalizedString": "Basking in the spring breeze,\nriding the wind to the heavens."
        }
      },
      "6": {
        "Id": 6,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "6_Name",
          "SourceString": "常康健",
          "LocalizedString": "Forever Enduring"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "6_Content",
          "SourceString": "百岁身安康，\n健康似神仙。",
          "LocalizedString": "May you see the century,\ntime proves not to be your enemy."
        }
      },
      "7": {
        "Id": 7,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "7_Name",
          "SourceString": "万象新",
          "LocalizedString": "A Thousand Rebirths"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "7_Content",
          "SourceString": "历添新岁月，\n春满旧山河。",
          "LocalizedString": "As the calendar adds new years,\nspring casts the land anew."
        }
      },
      "8": {
        "Id": 8,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "7_Name",
          "SourceString": "万象新",
          "LocalizedString": "A Thousand Rebirths"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "8_Content",
          "SourceString": "烟火辞旧梦，\n人间好时节。",
          "LocalizedString": "Fireworks bid old dreams farewell,\nthe world is in good cheer."
        }
      },
      "9": {
        "Id": 9,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "1_Name",
          "SourceString": "长相守",
          "LocalizedString": "Enduring Couple"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "9_Content",
          "SourceString": "愿得一心人，\n白首不相离。",
          "LocalizedString": "Hold one in your heart,\ntill death do you part."
        }
      },
      "10": {
        "Id": 10,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "10_Name",
          "SourceString": "钱多多",
          "LocalizedString": "Windfall"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "10_Content",
          "SourceString": "财源常广进，\n福禄岁月新。",
          "LocalizedString": "May your wealth grow\nand prosperity overflow."
        }
      },
      "11": {
        "Id": 11,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "11_Name",
          "SourceString": "祝福签",
          "LocalizedString": "Blessing Lot"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "11_Content",
          "SourceString": "百尺竿头，\n更进一步。",
          "LocalizedString": "The next step\nis to go further."
        }
      },
      "12": {
        "Id": 12,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "11_Name",
          "SourceString": "祝福签",
          "LocalizedString": "Blessing Lot"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "12_Content",
          "SourceString": "千里之行，\n始于足下。",
          "LocalizedString": "The journey of a thousand miles\nbegins with a single step."
        }
      },
      "13": {
        "Id": 13,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "11_Name",
          "SourceString": "祝福签",
          "LocalizedString": "Blessing Lot"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "13_Content",
          "SourceString": "知己知彼，\n百战不殆。",
          "LocalizedString": "If you know the enemy and know yourself,\nyou need not fear the result of a hundred battles."
        }
      },
      "14": {
        "Id": 14,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "11_Name",
          "SourceString": "祝福签",
          "LocalizedString": "Blessing Lot"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "14_Content",
          "SourceString": "前途似锦，\n只争朝夕。",
          "LocalizedString": "The future is bright,\nso seize the moment."
        }
      },
      "15": {
        "Id": 15,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "15_Name",
          "SourceString": "幸运词条：风鸢草",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "15_Content",
          "SourceString": "今天，出发了。工作人员给了我一片叶子，说是带上它，能乘着风飞到更远的地方。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "16": {
        "Id": 16,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "16_Name",
          "SourceString": "幸运词条：鲷鱼烧",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "16_Content",
          "SourceString": "在路过的第一个小镇休息，买到了迄今为止吃过最好吃的巧克力味鲷鱼烧。一口气吃了五个。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "17": {
        "Id": 17,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "17_Name",
          "SourceString": "幸运词条：日行一善",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "17_Content",
          "SourceString": "遇到了两户正在争吵的商队，把路都堵住了。准备把他们劝走，但一靠近，他们就自己散开了。搞不懂。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "18": {
        "Id": 18,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "18_Name",
          "SourceString": "幸运词条：篝火节",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "18_Content",
          "SourceString": "在村庄被几个小孩邀请留下来参加篝火节。没什么兴趣，但他们马上要举办烤鱼大赛，勉强看一下吧。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "19": {
        "Id": 19,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "19_Name",
          "SourceString": "幸运词条：一日闲暇",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "19_Content",
          "SourceString": "无所事事的一整个白天。蹲在长满荷叶的池塘边看鱼，不知道哪个幸运的家伙今晚要被我吃掉。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "20": {
        "Id": 20,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "20_Name",
          "SourceString": "幸运词条：晒月亮",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "20_Content",
          "SourceString": "走着走着，突然很困，就躺在山坡上睡着了。醒来的时候，被月光照着，像披了件银色的外套。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "21": {
        "Id": 21,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "21_Name",
          "SourceString": "幸运词条：感谢粉丝",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "21_Content",
          "SourceString": "遇到了同样参加放飞节的人，把目前的赛况告诉了我。虽然不知道为什么，但我的名次很高。谢谢。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "22": {
        "Id": 22,
        "Name": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "22_Name",
          "SourceString": "幸运词条：未完待续",
          "LocalizedString": "!NoTextFound!"
        },
        "Content": {
          "Namespace": "ActivityCNYLuckyLotteryPool",
          "Key": "22_Content",
          "SourceString": "收到了新的任务委托，和目前的行程有些冲突，最后拒绝了委托。这样走走停停的日子，如果会成为生活中的一部分……也不错。",
          "LocalizedString": "!NoTextFound!"
        }
      }
    }
  }
]