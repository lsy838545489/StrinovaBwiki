        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "1_StoryName",
          "SourceString": "时光礼盒",
          "LocalizedString": "Gift of Time"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "1_StoryContext",
          "SourceString": "节日将近，星庇所的工作终于告一段落，你们一起去参加烟花庆典，在观景点并肩而立，共赏美景，无需多言就能懂彼此未说出口的话。",
          "LocalizedString": "As the festival approaches, the work at Astral Sanctuary finally comes to an end. Together, you head to the fireworks celebration. Standing side by side, you share the breathtaking view, no words needed to understand the unspoken thoughts between you."
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "1_AvgId",
          "SourceString": "104214601",
          "LocalizedString": "104214601"
        }
      },
      "2": {
        "Id": 2,
        "RolePicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/CnyFireworkStory/T_Dynamic_CnyFireworkStory_BG11.T_Dynamic_CnyFireworkStory_BG11",
          "SubPathString": ""
        },
        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "2_StoryName",
          "SourceString": "勇者沐春大冒险",
          "LocalizedString": "Heroic Adventure"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "2_StoryContext",
          "SourceString": "勇者米雪儿与她的伙伴引航者共同踏上了沐春冒险之旅——这可是勇者怎么刷都刷不够的奖励关！",
          "LocalizedString": "The brave Michele and her partner, the Navigator, embark on an adventure together—a bonus quest with endless rewards!"
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "2_AvgId",
          "SourceString": "104210101",
          "LocalizedString": "104210101"
        }
      },
      "3": {
        "Id": 3,
        "RolePicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/CnyFireworkStory/T_Dynamic_CnyFireworkStory_BG12.T_Dynamic_CnyFireworkStory_BG12",
          "SubPathString": ""
        },
        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "3_StoryName",
          "SourceString": "生命的确幸",
          "LocalizedString": "A Fortunate Life"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "3_StoryContext",
          "SourceString": "因为繁忙的工作，奥黛丽并没有机会参与太多庆典的筹备。为了给她足够的参与感，也为了安抚辛苦一年的奥黛丽，你们一同参与了烟花庆典。",
          "LocalizedString": "Busy with her work, Audrey has been unable to help out with the preparations. To make sure she feels included and to reward her for all her hard work, you decide to join her in the fireworks celebrations."
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "3_AvgId",
          "SourceString": "104210501",
          "LocalizedString": "104210501"
        }
      },
      "4": {
        "Id": 4,
        "RolePicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/CnyFireworkStory/T_Dynamic_CnyFireworkStory_BG13.T_Dynamic_CnyFireworkStory_BG13",
          "SubPathString": ""
        },
        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "4_StoryName",
          "SourceString": "共赏此时",
          "LocalizedString": "A Moment Together"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "4_StoryContext",
          "SourceString": "你与拉薇来到观景台观看烟花庆典，盛大的景色勾起了拉薇的思乡之情，也让她感觉到自己的渺小和孤独。但没关系，你愿意做漂泊者的港湾。",
          "LocalizedString": "You join Lawine on the observation deck to watch the fireworks celebrations. The grand display brought out some homesickness in Lawine, making her feel small and lonely. But it's okay—you're there to be a safe haven for the wanderer."
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "4_AvgId",
          "SourceString": "104212801",
          "LocalizedString": "104212801"
        }
      },
      "5": {
        "Id": 5,
        "RolePicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/CnyFireworkStory/T_Dynamic_CnyFireworkStory_BG14.T_Dynamic_CnyFireworkStory_BG14",
          "SubPathString": ""
        },
        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "5_StoryName",
          "SourceString": "望见未来",
          "LocalizedString": "Journey to the Future"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "5_StoryContext",
          "SourceString": "心夏邀请忙于庆典筹备的你一起看烟花。万能的海兔队长能用她的手指望远镜“望见未来”——卡丘世界和引航者的未来一定会越来越好。",
          "LocalizedString": "After your busy week helping with the celebration preparations, Kokona invites you to watch the fireworks together. The mighty Captain Sea Bunny uses her makeshift telescope to “see into the future” - for both you and Strinova, the future is sure to get better and better!"
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "5_AvgId",
          "SourceString": "104212401",
          "LocalizedString": "104212401"
        }
      },
      "6": {
        "Id": 6,
        "RolePicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/CnyFireworkStory/T_Dynamic_CnyFireworkStory_BG15.T_Dynamic_CnyFireworkStory_BG15",
          "SubPathString": ""
        },
        "StoryName": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "6_StoryName",
          "SourceString": "瞬间与永恒",
          "LocalizedString": "Now and Eternity"
        },
        "StoryContext": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "6_StoryContext",
          "SourceString": "一起看烟花时，面对转瞬即逝的景色，玛德蕾娜在喜悦之余，也感到了淡淡的忧伤。你安慰玛德蕾娜，艺术存在的意义，就是将瞬间的美好变为永恒。",
          "LocalizedString": "While you watch the fireworks with Maddelena, she feels bittersweet at the fleeting scenery. You comfort her that the purpose of art is to capture beauty in eternity."
        },
        "AvgId": {
          "Namespace": "ActivityCNYFireStory",
          "Key": "6_AvgId",
          "SourceString": "104210701",
          "LocalizedString": "104210701"
        }
      }
    }
