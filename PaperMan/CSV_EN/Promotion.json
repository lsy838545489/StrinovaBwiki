      "13": {
        "Id": 1013,
        "Sort": 13,
        "Title": {
          "Namespace": "Promotion",
          "Key": "13_Title",
          "SourceString": "世宙星声",
          "LocalizedString": "Voice of the Cosmos"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "13_SubTitle",
          "SourceString": "重焰传说外观威风驾临！",
          "LocalizedString": "Legendary Ignis Skin Arrives!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "13_Desc",
          "SourceString": "一个飞跃星海的传说，一段穿梭宇宙的传奇。\n游历万千星辰，它见证过勇气，公义，信念，牺牲……\n而今，它将为敌人奉上这无尽世界的终末剧！",
          "LocalizedString": "A legend that leapt across the sea of stars, a saga forged through the depths of the universe.\nIt has witnessed courage, justice, conviction, and sacrifice among countless worlds—\nand now, it delivers to its enemies the final act of this boundless cosmos."
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_8.T_Dynamic_FacePicture_8",
