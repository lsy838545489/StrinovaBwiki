      "14": {
        "Id": 1014,
        "Sort": 14,
        "Title": {
          "Namespace": "Promotion",
          "Key": "14_Title",
          "SourceString": "沐春灼华",
          "LocalizedString": "Springlit Splendor"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "14_SubTitle",
          "SourceString": "星绘新传说外观限时开启！",
          "LocalizedString": "Celestia's New Legendary Skin Available Now!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "14_Desc",
          "SourceString": "迎接春日的美好时节，需要一场唤醒希望的仪典。\n司春神女的身影于此间盛放，是花海漫卷，亦是星光摇散。\n她是世间美好，也是长久纯真的希望。",
          "LocalizedString": "To celebrate the beauty of spring, a rite of hope unfolds.\nUnder a canopy of blooming flowers and drifting starlight, the Goddess of Spring appears.\nShe is the testament to the world's beauty and everlasting hope."
        },
