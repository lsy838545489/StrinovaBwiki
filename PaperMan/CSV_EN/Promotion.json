          "Namespace": "Promotion",
          "Key": "15_Title",
          "SourceString": "危险游戏",
          "LocalizedString": "All or Nothing"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "15_SubTitle",
