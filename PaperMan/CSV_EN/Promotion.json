      "6": {
        "Id": 1006,
        "Sort": 6,
        "Title": {
          "Namespace": "Promotion",
          "Key": "6_Title",
          "SourceString": "焰翎魔女",
          "LocalizedString": "Phoenix Witch"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "6_SubTitle",
          "SourceString": "加拉蒂亚",
          "LocalizedString": "Galatea"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "6_Desc",
          "SourceString": "她是无迹可寻的魔女，是召来弦能之火的日轮。\n​她沉醉于弦能的奥妙，魔法的无垠，不在意凡间无趣的争吵。\n​唯有那些妄图染指弦能的无知者才会看到，魔女驾临的危险与威严。",
          "LocalizedString": "She is an elusive witch, the sun wheel that beckons the flames.\nShe is immersed in mysteries and the boundlessness of magic, unconcerned with the trivial disputes of the mortal realm.\nOnly the naive who dare to interfere will witness the peril and majesty of her presence."
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_2.T_Dynamic_FacePicture_2",
          "SubPathString": ""
        },
        "StartTime": {
