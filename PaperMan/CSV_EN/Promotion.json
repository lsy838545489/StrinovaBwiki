      "11": {
        "Id": 1011,
        "Sort": 14,
        "Title": {
          "Namespace": "Promotion",
          "Key": "11_Title",
          "SourceString": "传说臻选",
          "LocalizedString": "LEGENDARY SELECTION"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "11_SubTitle",
          "SourceString": "传说时装免费自选！",
          "LocalizedString": "Free Legendary Skin Selection!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "11_Desc",
          "SourceString": "活动期间每周仅需完成简单任务，即可获取：\n-自选一件传说外观永久解锁\n-自选多套传说外观限时体验\n-拓扑晶环×20",
          "LocalizedString": "Complete weekly quests to earn:\n- Permanently unlock one legendary skin of your choice\n- Limited-time trial of multiple legendary skins\n- Topo Crystal Rings x20"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_7.T_Dynamic_FacePicture_7",
