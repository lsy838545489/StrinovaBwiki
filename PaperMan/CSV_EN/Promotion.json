      "9": {
        "Id": 1009,
        "Sort": 9,
        "Title": {
          "Namespace": "Promotion",
          "Key": "9_Title",
          "SourceString": "炽焱狂龙",
          "LocalizedString": "Scorching Dragon"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "9_SubTitle",
          "SourceString": "喷火器传说外观威风驾临！",
          "LocalizedString": "Legendary Emberspit Skin Arrives!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "9_Desc",
          "SourceString": "它是来自虚拟位面的终末之龙，能够带来滔天的焰浪！\n只因一场意外，如今穿越而来！\n与它结盟，一起完成它的复仇计划！",
          "LocalizedString": "Meet the Doomsday Dragon from the virtual realm, a fiery force of chaos! An unexpected twist brought it here. Join forces to execute its plan of vengeance!"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_4.T_Dynamic_FacePicture_4",
