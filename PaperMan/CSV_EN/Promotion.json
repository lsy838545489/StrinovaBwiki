      "12": {
        "Id": 1012,
        "Sort": 12,
        "Title": {
          "Namespace": "Promotion",
          "Key": "12_Title",
          "SourceString": "绮星梦使",
          "LocalizedString": "Dreamweaver"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "12_SubTitle",
          "SourceString": "米雪儿新传说外观限时开启！",
          "LocalizedString": "Michele's New Legendary Skin Available Now!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "12_Desc",
          "SourceString": "倾听梦的呢喃，汇聚星的辉光。\n应我呼唤，梦的魔法使，米雪儿，变身！\n我来守护，每一个梦境与梦想！",
          "LocalizedString": "Listen to the whispers of dreams, and collect the radiance of the stars.\nAt my call—Dreamweaver Michele—transform!\nI will protect every dream and aspiration!"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_6.T_Dynamic_FacePicture_6",
