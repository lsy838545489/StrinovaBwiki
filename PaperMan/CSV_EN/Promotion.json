      "10": {
        "Id": 1010,
        "Sort": 10,
        "Title": {
          "Namespace": "Promotion",
          "Key": "10_Title",
          "SourceString": "三途雾徊",
          "LocalizedString": "MIST WALKER"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "10_SubTitle",
          "SourceString": "忧雾传说外观限时开启！",
          "LocalizedString": "Yugiri Legendary Skin Available Now!"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "10_Desc",
          "SourceString": "她扬手散落神火，便有灵风萦绕；\n她赤足踏过秽土，便有花雨飘零。\n她是生死薄雾中的幽影，是泣血迷魂苦求的救赎。",
          "LocalizedString": "She scatters divine fire with a wave, and a mystical breeze follows;\nShe steps barefoot on tainted soil, leaving a trail of falling blossoms.\nShe is the shadow in the mist of life and death, the redemption for those lost in despair."
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_5.T_Dynamic_FacePicture_5",
          "SubPathString": ""
