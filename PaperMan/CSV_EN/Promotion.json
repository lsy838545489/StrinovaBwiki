      },
      "8": {
        "Id": 1008,
        "Sort": 8,
        "Title": {
          "Namespace": "Promotion",
          "Key": "8_Title",
          "SourceString": "日珥鸣火·千面之月",
          "LocalizedString": "DAWN OF FLAMES · THOUSAND CRESCENTS"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "8_SubTitle",
          "SourceString": "艾卡·芙拉薇娅传说外观返场",
          "LocalizedString": "Eika & Flavia Legendary Skins Return"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "8_Desc",
          "SourceString": "她是永燃之日，是燃尽黑暗的烈烈明火。\n她似恒凝之月，是照亮幽深的殷殷流光。\n为这世界的每一个晨昏轮转，她们终会交辉。",
          "LocalizedString": "She is the Everlasting Sun, a fierce flame consuming the darkness.\nShe is the Luminous Moon, lighting the way through the depths.\nTogether, they brighten every dawn and dusk."
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_3.T_Dynamic_FacePicture_3",
          "SubPathString": ""
        },
