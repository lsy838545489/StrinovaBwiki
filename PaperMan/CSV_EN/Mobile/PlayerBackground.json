      "5": {
        "ItemId": 3031002,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "5_Name",
          "SourceString": "猫咪基地",
          "LocalizedString": "Kitty Base"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "5_Desc",
          "SourceString": "粘在衣服上的绒毛泄露了秘密。难道除了火力大喵和喵喵卫士，总是带着猫耳的搜查官还有其他喵喵吗？答案是：当然！\n“我的秘密基地，从今天开始，就向你开放啦！”",
          "LocalizedString": "The fur clinging to your clothes gives it away — looks like there's more to this story than just Mighty Meow and Pawtector. Could it be that the cat-eared investigator isn't the only one with feline company? The answer: of course!\n\n\"My secret base is officially open to you—starting today!\""
        },
