      "6": {
        "ItemId": 3031003,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "6_Name",
          "SourceString": "记忆独奏",
          "LocalizedString": "Memory Solo"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "6_Desc",
          "SourceString": "音乐具有跨越时空的力量。当尘封已久的琴弦再度震颤，遥远时光里的微风与阳光，仿佛也随着音符一起重现在身边。\n“希望这首曲子可以停留在你的记忆中，无论经历多少岁月……”",
          "LocalizedString": "Music holds the power to transcend time itself. When long-silent strings begin to resonate once more, it feels as if the distant winds and sunlight of the past return with every note.\n\n\"I hope this melody lingers in your memory, no matter how many years may pass…\""
        },
