      "2": {
        "ItemId": 3030002,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "2_Name",
          "SourceString": "终结战场",
          "LocalizedString": "Endgame"
        },
        "Quality": 1,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "2_Desc",
          "SourceString": "硝烟已散，唯有废墟与残垣记录着此处曾发生过的激战。战场终结于战士收枪的一刻，即便敌人仍在眼前。\n“任务已经完成，我没有继续战斗的理由。再会了，欧泊的战士们。”",
          "LocalizedString": "The smoke of battle has faded, leaving only ruins and shattered walls to bear witness to the fierce clash that once took place here. A battlefield ends the moment a warrior lowers their weapon—even if the enemy still stands before them.\n\"The mission is complete. I have no reason to fight any longer. Farewell, warriors of P.U.S.\""
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3030002.T_Dynamic_Background_3030002",
          "SubPathString": ""
