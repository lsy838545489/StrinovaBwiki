      "3": {
        "ItemId": 3030004,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "3_Name",
          "SourceString": "雨夜回望",
          "LocalizedString": "Memories Under the Rain"
        },
        "Quality": 1,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "3_Desc",
          "SourceString": "集团的内忧外患，压在年轻的话事人肩上。狩猎者的捕兽网重重落下，纯白的独角兽在雨夜中挣扎。\n“如果是‘你’，会怎样做呢？拜托了，过去的自己。”",
          "LocalizedString": "The turmoil within the Syndicate and the threats from beyond weigh heavily upon the young successor's shoulders. The hunter’s snares descend layer by layer, and the pure white unicorn struggles amidst the rain-soaked night.\n\"If it were you, what would you do? Please… tell me, my former self.\""
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3030004.T_Dynamic_Background_3030004",
