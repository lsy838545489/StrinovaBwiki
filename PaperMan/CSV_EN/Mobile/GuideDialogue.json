      "3003103": {
        "DialogId": 3003103,
        "DialogType": 1,
        "DialogPosition": 0,
        "RoleId": 146,
        "Content": {
          "Namespace": "GuideDialogue",
          "Key": "3003103_Content",
          "SourceString": "获取增益效果，需消耗【天赋点】来升级中间的天赋项。",
