      "11": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "11_Desc",
          "SourceString": "个人乱斗就等同于单兵作战，你的目光所及之处皆是敌人。",
          "LocalizedString": "In Free-for-All, it's a fight for survival, with enemies lurking around every corner."
        }
      },
      "12": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "12_Desc",
          "SourceString": "你若是想要冲突重围，枪法和身法缺一不可。",
          "LocalizedString": "To survive the onslaught, you must have good aim and movement."
        }
      },
      "13": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "13_Desc",
          "SourceString": "可以尽量避开多个枪线的攻击，选择“趁乱偷袭”的策略。",
          "LocalizedString": "Try to avoid getting caught in the crossfire. Strike your targets amidst the chaos."
        }
      },
      "14": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "14_Desc",
          "SourceString": "毕竟你的“胜利目标”是尽快击败指定数量的敌人。",
          "LocalizedString": "After all, eliminating the required number of enemies is the only way to win."
        }
      },
      "15": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "CultureInvariantString": null
        }
      },
      "16": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "16_Desc",
          "SourceString": "熟悉地图的布局、包点位置和重要路线是入门的第一步。",
          "LocalizedString": "Knowing the map layout, bomb sites, and key routes is the first step."
        }
      },
      "17": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "17_Desc",
          "SourceString": "如果你是进攻方，那就需要掩护携带装置的队友进入包点，完成安装任务。",
          "LocalizedString": "As the attacker, you need to cover the teammate carrying the bomb as they enter the bomb site and plant the bomb."
        }
      },
      "18": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "18_Desc",
          "SourceString": "携带装置的队友一旦倒下了，装置就会原地掉落。",
          "LocalizedString": "If the teammate carrying the bomb goes down, it will be dropped at their current location."
        }
      },
      "19": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "19_Desc",
          "SourceString": "装置安装完毕后，要继续保持警惕，而不是提前庆祝。",
          "LocalizedString": "Stay alert even after planting the bomb—don't celebrate too soon."
        }
      },
      "20": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "20_Desc",
          "SourceString": "因为只有坚持到装置引爆或者敌人全部倒下，才算获胜。",
          "LocalizedString": "Victory is only achieved when the bomb detonates or all enemies are eliminated."
        }
      },
      "21": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "21_Desc",
          "SourceString": "如果你是防守方，可以记住这两个获胜秘诀，一是在下包前消灭全部的敌人。",
          "LocalizedString": "If you're a defender, there are two ways to win. Eliminate all enemies before the bomb is planted."
        }
      },
      "22": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "22_Desc",
          "SourceString": "二是在倒计时结束前，拆除装置。",
          "LocalizedString": "Second, defuse the device before the timer runs out."
        }
      },
      "23": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "23_Desc",
          "SourceString": "此外，双方打满规定的局数后，会交换攻防位置。",
          "LocalizedString": "Also, after playing the set number of rounds, both sides will switch roles."
        }
      },
      "24": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "24_Desc",
          "SourceString": "最终，先拿下指定分数的队伍就是赢家。",
          "LocalizedString": "The first team to reach the target score wins."
        }
      }
