      "10093": {
        "Id": 10093,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10093_TitleText",
          "SourceString": "<SchoolDay_Title>学园庆典开放日</>",
          "LocalizedString": "<SchoolDay_Title>CAMPUS OPEN DAY</>"
        },
        "TitleTextDoubleLine": {
          "CultureInvariantString": null
        },
        "TitleSubText": {
          "CultureInvariantString": null
        },
        "EnableTitleDoubleLine": false,
        "DescPicture": "",
        "PreviewDesc": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10093_PreviewDesc",
          "SourceString": "<SchoolDay_Content>在樱花烂漫、阳光和煦的春日，卡丘学园开启了一年一度的学园庆典。庆典的一个重要环节是对校内社团的综合评比。为了拿到更好的名次，各个社团的团长使出了浑身解数……</>",
          "LocalizedString": "<SchoolDay_Content>On a warm spring day with blooming sakura, Strinova Academy kicks off its annual celebration. A key part of the celebration is the club competition, where club leaders pull out all the stops to secure the best ranking...</>"
        },
        "PreviewTimetext": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10093_PreviewTimetext",
          "SourceString": "<SchoolDay_Time>活动时间：</>\n<SchoolDay_Time>{startFullTime} ~ {endFullTime}</>",
          "LocalizedString": "<SchoolDay_Time>Event Time:</>\n<SchoolDay_Time>{startFullTime} - {endFullTime}</>"
        }
      },
      "10105": {
        "Id": 10105,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10105_TitleText",
          "SourceString": "<GiftDrop_Tittle_74B>初见赠礼掉落活动</>",
