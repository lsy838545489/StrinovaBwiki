      "10021": {
        "Id": 10021,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10021_TitleText",
          "SourceString": "<Fission_Title>重链卡丘空间</>",
          "LocalizedString": "<Fission_Title>STRINOVA BONDS</>"
        },
        "TitleTextDoubleLine": {
          "CultureInvariantString": null
