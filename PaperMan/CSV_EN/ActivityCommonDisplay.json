        "TitleTextDoubleLine": {
          "CultureInvariantString": null
        },
        "TitleSubText": {
          "CultureInvariantString": null
        },
        "EnableTitleDoubleLine": false,
        "DescPicture": "",
        "PreviewDesc": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10072_PreviewDesc",
          "SourceString": "<Biochemical_Content>前日，普雷顿的突发事件造成了这一地区弦序列的紊乱。随着人员的失踪以及异形怪物的出现，欧泊和乌尔比诺的联合队也开始深入调查这一城区的变化。</>",
          "LocalizedString": "<Biochemical_Content>The explosion in Preton that took place a few days ago has caused a disruption in string sequences, leading to the emergence of aggressive and infectious creatures...</>"
        },
        "PreviewTimetext": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10072_PreviewTimetext",
          "SourceString": "<Biochemical_Time>活动时间：</>\n<Biochemical_Time>{startFullTime}~{endFullTime}</>",
          "LocalizedString": "<Biochemical_Time>Event Time: </>\n<Biochemical_Time>{startFullTime} to {endFullTime}</>"
        }
      },
