        "TitleSubText": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10021_TitleSubText",
          "SourceString": "<Fission_SubTitle>完成适应任务，即得专属奖励！</>",
          "LocalizedString": "<Fission_SubTitle>Complete quests to earn exclusive rewards!</>"
        },
        "EnableTitleDoubleLine": false,
        "DescPicture": "",
        "PreviewDesc": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10021_PreviewDesc",
          "SourceString": "<Fission_Content>我们在重新检测到你的通讯讯号后第一时间发出了这封邮件，欢迎你回到卡丘世界。</>",
          "LocalizedString": "<Fission_Content>We're sending you this message as we've detected that your communication signal has been re-activated. Welcome back to Strinova.</>"
        },
        "PreviewTimetext": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10021_PreviewTimetext",
          "SourceString": "<Fission_Time>活动时间：</>\n<Fission_Time>重建联络管道触发后，共持续21天</>",
          "LocalizedString": "<Fission_Time>Event Time:</>\n<Fission_Time>Once communication channels have been reestablished, the event will last for 21 days.</>"
        }
      },
      "10022": {
        "Id": 10022,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10022_TitleText",
          "SourceString": "<FirstTopUp_Titlle_70B>首充礼包</>",
