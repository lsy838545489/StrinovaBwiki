        "EnableTitleDoubleLine": false,
        "DescPicture": "",
        "PreviewDesc": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10105_PreviewDesc",
          "SourceString": "<GiftDrop_RulesTittle_18B>活动规则：</>\n<GiftDrop_RulesContent_16M>完成除自定义模式外的任意比赛均有机会获得「惊奇战备礼盒」，每日最多3次机会，次日{refreshTime}刷新</>",
          "LocalizedString": "<GiftDrop_RulesTittle_18B>Event Rules：</>\n<GiftDrop_RulesContent_16M>Complete any match, except custom mode, for a chance to get a Marvelous Supply Box. Up to 3 chances daily. Refreshes at {refreshTime}.</>"
        },
        "PreviewTimetext": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10105_PreviewTimetext",
          "SourceString": "<GiftDrop_RulesTittle_18B>活动时间：</>\n<GiftDrop_RulesTittle_18B>{startTime}开服后 ~ {endFullTime}</>",
          "LocalizedString": "<GiftDrop_RulesTittle_18B>Event Time:</>\n<GiftDrop_RulesTittle_18B>{startTime}, after server launch - {endFullTime}</>"
        }
      },
