      "10052": {
        "Id": 10052,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10052_TitleText",
          "SourceString": "<White_Bold_57_FFFFFF>美学与格调</>",
          "LocalizedString": "<White_Bold_57_FFFFFF>AESTHETICS & STYLE</>"
        },
        "TitleTextDoubleLine": {
          "CultureInvariantString": null
        },
        "TitleSubText": {
          "CultureInvariantString": null
        },
        "EnableTitleDoubleLine": false,
        "DescPicture": "",
        "PreviewDesc": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10052_PreviewDesc",
          "SourceString": "<Yellow_Bold_16_FFF4E4>格罗夫旗下的“回味时光”咖啡厅最近入职了三位神秘的新员工，她们似乎都在近期的“美学与格调”活动中等待着同一位特邀客人的到访……</>",
          "LocalizedString": "<Yellow_Bold_16_FFF4E4>Grove Enterprises' Café Reminiscence recently hired three mysterious new employees. They all seem to be waiting for a special guest at the upcoming \"Aesthetics & Style\" event...</>"
        },
        "PreviewTimetext": {
          "Namespace": "ActivityCommonDisplay_I18N",
          "Key": "10052_PreviewTimetext",
          "SourceString": "<Yellow_Bold_16_FFF5DE>活动时间：</>\n<Yellow_Medium_16_FFF5DE>{startFullTime} ~ {endFullTime}</>",
          "LocalizedString": "<Yellow_Bold_16_FFF5DE>Event Time:</>\n<Yellow_Medium_16_FFF5DE>{startFullTime} - {endFullTime}</>"
        }
      },
      "10072": {
        "Id": 10072,
        "TitleText": {
          "Namespace": "ActivityCommonDisplay",
          "Key": "10072_TitleText",
          "SourceString": "<Biochemical_Title>桎化行动</>",
          "LocalizedString": "<Biochemical_Title>OPERATION RESTRAINT</>"
