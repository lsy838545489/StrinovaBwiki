        "Name": {
          "Namespace": "ApartmentMapCfg",
          "Key": "105_Name",
          "SourceString": "宿舍：奥黛丽",
          "LocalizedString": "部屋 - オードリー"
        },
        "Desc": {
          "Namespace": "ApartmentMapCfg",
          "Key": "105_Desc",
          "SourceString": "格罗夫银行大厦是格罗夫家族的重要资产，也是奥黛丽的骄傲。",
          "LocalizedString": "グローブ銀行はグローブ家の重要な資産であり、オードリーの誇りでもある。"
        },
        "Scene": "/Game/PaperMan/Maps/Lobby/Lobby_new/Lobby",
