          "Key": "128_Name",
          "SourceString": "宿舍：拉薇",
          "LocalizedString": "部屋 - ラヴィーネ"
        },
        "Desc": {
          "Namespace": "ApartmentMapCfg",
          "Key": "128_Desc",
          "SourceString": "拉薇在离开欧泊时注销了所有身份信息，谁也不知道她真正的名字叫什么……",
          "LocalizedString": "ラヴィーネはP.U.Sを去る際、人事ファイルを書き換えさせた。誰も彼女の本名さえ知らない…"
        },
        "Scene": "/Game/PaperMan/Maps/Lobby/Lobby_new/Lobby",
