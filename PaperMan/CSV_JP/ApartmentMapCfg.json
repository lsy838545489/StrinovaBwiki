        "Name": {
          "Namespace": "ApartmentMapCfg",
          "Key": "124_Name",
          "SourceString": "宿舍：心夏",
          "LocalizedString": "部屋 - 心夏"
        },
        "Desc": {
          "Namespace": "ApartmentMapCfg",
          "Key": "124_Desc",
          "SourceString": "心夏曾经短暂地在欧泊的教导队中任职，但她更喜欢身处一线的工作。",
          "LocalizedString": "心夏はP.U.Sの教導隊に一時期所属していたが、大好きな前線での仕事のためにすぐに転属した。"
        },
        "Scene": "/Game/PaperMan/Maps/Lobby/Lobby_new/Lobby",
