        "TextContent": {
          "Namespace": "",
          "Key": "5B4233AF41F8E37E7E2BFE967F72250C",
          "SourceString": "哼，命运，与我为敌？——等等，谁要跟你演这么中二的剧本啊！",
          "LocalizedString": "は？運命？敵？……って、なんで急にそんな中二病みたいな話になるのよ。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
