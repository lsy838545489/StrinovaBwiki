        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "402AA43B403772C719CFE6A080CFA494",
          "SourceString": "多、多嘴，逢年过节不想一个人吃饭有问题吗！",
          "LocalizedString": "う、うるさい！年末くらい一人で食べたくないだけ!"
