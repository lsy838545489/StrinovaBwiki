        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "BE6B03DA4C590C8169D1B0BE42585B96",
          "SourceString": "也是，别人的饭，毕竟要比我亲手做的好吃，那你吃别人的吧……",
          "LocalizedString": "そっか。やっぱり外のごはんのほうが美味しいよね。じゃあ、無理しなくていいよ。そっち食べなよ。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
