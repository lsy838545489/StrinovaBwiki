        "TextContent": {
          "Namespace": "",
          "Key": "4A69257E4BA7FCEE268FFFAF02E696C8",
          "SourceString": "等、等下，突然涌起一阵强烈的负罪感……",
          "LocalizedString": "ま、待って……なんか今、ものすごい罪悪感がきた。"
        },
        "TextureContent": {
