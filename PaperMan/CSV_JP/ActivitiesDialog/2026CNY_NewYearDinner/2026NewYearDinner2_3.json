        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "F16EC9E94C3068DA4FC4CF83FF0BD341",
          "SourceString": "赎罪的方法，就是来亲口尝一尝哦！",
          "LocalizedString": "なら、その罪はちゃんと自分の舌で償ってもらわないと。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
