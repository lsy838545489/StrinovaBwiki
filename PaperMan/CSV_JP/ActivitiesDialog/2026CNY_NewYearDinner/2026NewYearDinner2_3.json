        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "2BB0BAC146FB7A1EFA3D929B2418937A",
          "SourceString": "你知道的，每一个强大的猎手，都会有一个一同成长的宿敌。",
          "LocalizedString": "強い狩人には、共に成長してきた宿命のライバルがいる。"
