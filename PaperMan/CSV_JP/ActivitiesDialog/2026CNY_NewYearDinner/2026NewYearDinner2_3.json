        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "46B0704E42C222A46F43F79737866B63",
          "SourceString": "宿敌，即是你我命运！",
          "LocalizedString": "宿敵――それは、切っても切れない運命。"
