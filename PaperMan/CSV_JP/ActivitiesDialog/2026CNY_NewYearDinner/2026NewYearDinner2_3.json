        "TextContent": {
          "Namespace": "",
          "Key": "536DEE2443F925072F6F958F988078A0",
          "SourceString": "绯莎也在？你俩不是？",
          "LocalizedString": "フューシャもいるのか。……二人って、そういう感じだったっけ？"
