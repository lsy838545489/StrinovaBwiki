        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": [],
        "ToneAkEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        }
      },
      "6": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 121,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_121.T_Dynamic_RolePorfile_121",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "21F570A144A42220B60BBF86407436DE",
          "SourceString": "不知道！但是先碰头准没错！",
          "LocalizedString": "まだ決めてない！でも、とりあえず合流！"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
