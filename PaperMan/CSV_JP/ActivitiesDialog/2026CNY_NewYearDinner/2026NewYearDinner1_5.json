        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "E560B02642D5560A0EC378842808CC41",
          "SourceString": "我也没有这么严厉吧，引航者？",
          "LocalizedString": "そこまで管理してないわ。ねえ、ナビゲーター。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
