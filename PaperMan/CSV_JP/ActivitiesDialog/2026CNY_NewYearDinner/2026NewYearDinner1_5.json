      "9": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 115,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_115.T_Dynamic_RolePorfile_115",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "F239127A4A74BA36CA471CA7BDFD89E7",
          "SourceString": "今年聚餐的规则是，一人一道拿手料理，但我只擅长料理那些不长眼的家伙。",
          "LocalizedString": "今年は一人一品ずつ持ち寄る決まりなんだけど……私は料理があまり得意じゃないのね。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "10",
        "OptionType": "ECyStoryDialogOptionType::None",
        "TextContentList": [],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": [],
        "ToneAkEvent": {
          "AssetPathName": "None",
