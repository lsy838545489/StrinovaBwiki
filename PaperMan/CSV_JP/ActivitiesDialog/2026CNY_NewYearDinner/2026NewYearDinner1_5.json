        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "3AB9BEB14F704157659448AC750E9807",
          "SourceString": "芙拉薇娅准你出来放风了？",
          "LocalizedString": "え、いいの？フラヴィアが外出許可を出したの？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
