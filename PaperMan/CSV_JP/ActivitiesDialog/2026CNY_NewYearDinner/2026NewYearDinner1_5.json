        }
      },
      "5": {
        "SpeakerType": "ECyStoryDialogSpeakerType::Player",
        "bIsPlayer": true,
        "bNeedShowAvatar": true,
        "FromId": 0,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_10168_001.T_Dynamic_RolePorfile_10168_001",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "5502E6924C9C199454BF5A9322983071",
          "SourceString": "那，我能帮上什么忙？",
          "LocalizedString": "なるほど。それで私は何役？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "6",
        "OptionType": "ECyStoryDialogOptionType::None",
