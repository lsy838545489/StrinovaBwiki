      "4": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 121,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_121.T_Dynamic_RolePorfile_121",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "105B06AB4530B252569333BA7B02E15E",
          "SourceString": "我要参加今晚的演出，芙拉薇娅说给我买点衣服！",
          "LocalizedString": "今夜はステージに出るから、フラヴィアが衣装を買ってくれるって！"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
