        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "1C97A89744CD433D37C88D8370191F55",
          "SourceString": "这，这样吗，感觉忧雾不是这个意思？",
          "LocalizedString": "今の、夕霧の言おうとした意味と違わない？"
        },
        "TextureContent": {
          "AssetPathName": "None",
