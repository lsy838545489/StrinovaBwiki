      "8": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 115,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_115.T_Dynamic_RolePorfile_115",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "3F7FF7094140ECB0570AF2AF5226605D",
          "SourceString": "啊对，说到今晚的演出，还有一个事情。",
          "LocalizedString": "そういえば、今夜は会食なの。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
