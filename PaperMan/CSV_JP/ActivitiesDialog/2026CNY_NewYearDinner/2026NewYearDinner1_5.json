        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "CB7EBA17495C35D6EF88DBAE82B81D6B",
          "SourceString": "这，这不是作弊吗？",
          "LocalizedString": "え、それって……アリなの？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
