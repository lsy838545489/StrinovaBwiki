        "TextContent": {
          "Namespace": "",
          "Key": "D5B21E224C601F73B977DCA4A65B8F03",
          "SourceString": "——厨房的情报收集环节。",
          "LocalizedString": "キッチンを新しく改装したわ。段取り八分、仕事二分、準備がしっかりでないと。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
