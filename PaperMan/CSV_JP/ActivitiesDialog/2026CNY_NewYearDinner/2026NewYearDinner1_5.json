      "12": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 121,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_121.T_Dynamic_RolePorfile_121",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "5E5963874AAD5C8C4EA1DB9C18AF4194",
          "SourceString": "不是，长官说这是厨艺速成实验演练。而且长官今天做菜把厨房——",
          "LocalizedString": "えっとね、フラヴィアが“料理速成トレーニング”とか言い出して、うちのキッチンを――"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
