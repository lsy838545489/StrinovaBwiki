        "TextContent": {
          "Namespace": "",
          "Key": "23C14D0543E6C8A045CD13A1491E0E52",
          "SourceString": "（忧雾突然离线了片刻）",
          "LocalizedString": "（夕霧の音声が一瞬途切れた）"
        },
        "TextureContent": {
          "AssetPathName": "None",
