      "10": {
        "SpeakerType": "ECyStoryDialogSpeakerType::NPC",
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 115,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_115.T_Dynamic_RolePorfile_115",
          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "F95A99DD498E5000DBE7BCA1D40D1EC5",
          "SourceString": "所以……我需要你帮我挑个餐厅，我们打包个现成的菜，毕竟好吃也是心意的一部分。",
          "LocalizedString": "だから、お店でちゃんと選んで用意しようと思ってる。美味しければ、それで十分でしょう？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
