        "TextContent": {
          "Namespace": "",
          "Key": "008C563945EA9C58EE13249DA5AA23BB",
          "SourceString": "当当！这是新学会的菜式！香奈美，很棒吧？",
          "LocalizedString": "じゃーん！見て見て！これ、最近覚えた新しい料理なの！私すごくない？"
