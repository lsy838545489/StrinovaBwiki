        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "CE73924E47193C0473455188EADEBDB7",
          "SourceString": "等等……逻辑似乎正确，但思路好像很有问题？",
          "LocalizedString": "……待って。理屈は合ってる気がするけど、組み立て方がおかしくないか？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
