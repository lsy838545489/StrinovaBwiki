        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "FD6B59BB4FD69E69271E9BB8A8C7C468",
          "SourceString": "熊是杂食动物，不挑食，你也不挑食，菲很重要，你也很重要，所以问你。",
          "LocalizedString": "クマは雑食なので、あんまり選ばない。あなたも、似てる。フェイは大事。……あなたも、大事。だから聞いた。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
