          "SubPathString": ""
        },
        "Type": "ECyStoryDialogThirdLevelType::Normal",
        "ContentType": "ECyStoryDialogContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "85BC33DB42F239C263AB13A564F73F90",
          "SourceString": "那不是应该看熊的食谱吗……",
          "LocalizedString": "それなら、熊の好みを調べたほうが早いんじゃないか？"
