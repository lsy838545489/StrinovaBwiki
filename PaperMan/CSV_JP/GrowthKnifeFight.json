          "SourceString": "忍锋",
          "LocalizedString": "忍刀"
        },
        "IconHeavyattack": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/GrowthDetailIcon/T_Dynamic_GrowthDetailIcon_15202001.T_Dynamic_GrowthDetailIcon_15202001",
