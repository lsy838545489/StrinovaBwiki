        },
        "Desc": "Detail_15202001",
        "LightattackDesc": {
          "Namespace": "GrowthKnifeFight",
          "Key": "15202001_LightattackDesc",
          "SourceString": "  快速对敌人施加斩击，造成一定的伤害，拥有较远的攻击距离。轻击不会被格挡抵消。",
          "LocalizedString": "素早く斬撃を繰り出し、中距離の敵にダメージを与える。この攻撃はガードでは防げない。"
        },
        "HeavyattackDesc": {
          "Namespace": "GrowthKnifeFight",
          "Key": "15202001_HeavyattackDesc",
          "SourceString": "  在短暂延迟后释放斩击，对命中的敌人造成高额伤害。",
          "LocalizedString": "短い溜めの後、斬撃を繰り出し、命中した敵に高威力のダメージを与える。"
        }
      },
