      "5": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 146,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_146.T_Dynamic_RolePorfile_146",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "E1AD9E764E75D1476E256E84E3F87B44",
          "SourceString": "就是，人在高兴的时候，喝咖啡也是会醉的……",
          "LocalizedString": "人って、嬉しいときはコーヒーを飲んでも酔っちゃうのかな…？"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
