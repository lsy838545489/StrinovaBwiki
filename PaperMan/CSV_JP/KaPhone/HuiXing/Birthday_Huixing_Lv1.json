        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "1050EE414809671A17A75288B5F7ABDE",
          "SourceString": "不光是指礼物和祝福，能一整天都看到大家毫无保留的笑容，我感觉很幸福。",
          "LocalizedString": "プレゼントやお祝いだけじゃなくて、一日中みんなの心からの笑顔を見られて、本当に幸せでした。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
