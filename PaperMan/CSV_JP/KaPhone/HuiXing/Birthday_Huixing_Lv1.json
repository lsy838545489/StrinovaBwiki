        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "194B70A740AE598553807184EA2A0621",
          "SourceString": "由前辈精心准备的、和前辈一起度过的生日，我感觉很幸福……",
          "LocalizedString": "先輩が心を込めて準備してくれて、一緒に過ごせた誕生日が、本当に幸せでした……"
        },
