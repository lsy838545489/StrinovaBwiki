        "TextContentList": [
          {
            "Namespace": "",
            "Key": "40F1FB9A4F29EED9DF993E98C3FDD1B2",
            "SourceString": "说来听听？",
            "LocalizedString": "へえ、どんなこと？"
          }
        ],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": [
          "5"
        ]
