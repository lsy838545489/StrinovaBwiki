        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "2464F09443C611560B127FB556A3C504",
          "SourceString": "就是眼睛有点花，这张贺卡上的字都被我看出重影了。",
          "LocalizedString": "ただ、ちょっと目がぼやけて、このカードの文字が二重に見えちゃって…"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
