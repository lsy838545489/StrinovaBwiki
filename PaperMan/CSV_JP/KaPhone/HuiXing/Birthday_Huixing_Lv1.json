        "TextContentList": [
          {
            "Namespace": "",
            "Key": "A02AC1A4428CBB5C2DFA29A636C69ABA",
            "SourceString": "咖啡？醉？",
            "LocalizedString": "え、コーヒーで酔っちゃったの？"
          },
          {
            "Namespace": "",
            "Key": "1D3F564347B5C270906D0F956B07F195",
            "SourceString": "咖啡的功效不是让人保持清醒吗？",
            "LocalizedString": "コーヒーって普通、目を覚すものじゃないの？"
          }
        ],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": [
          "7",
          "7"
        ]
