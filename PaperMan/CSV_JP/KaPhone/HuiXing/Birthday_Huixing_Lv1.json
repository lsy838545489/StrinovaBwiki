      "7": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 146,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_146.T_Dynamic_RolePorfile_146",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "104AF9BE42975B5163F34F9D0F25CF68",
          "SourceString": "吃完前辈给我准备的蛋糕后，感觉晕乎乎的，有一点像小时候偷吃太多酒心巧克力那次……",
          "LocalizedString": "先輩が用意してくれたケーキを食べた後、なんだかふわふわしてきて、子供の頃にリキュールチョコを食べすぎた時の感じに似てて…"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "8",
        "OptionType": "ECyCommunicationOptionType::None",
        "TextContentList": [],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": []
      },
      "8": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 146,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_146.T_Dynamic_RolePorfile_146",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "363BD34F465AA92451FCF59D9D704B53",
          "SourceString": "但不是讨厌的感觉！有点像踩在云朵上，轻飘飘的，软绵绵的。",
          "LocalizedString": "でも、それは嫌な感じじゃなくて、まるで雲の上を歩いているようで、軽やかでふんわりしてるんです。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "9",
        "OptionType": "ECyCommunicationOptionType::None",
        "TextContentList": [],
        "EmojiList": [],
        "TextureList": [],
