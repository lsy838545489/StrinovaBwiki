      "2": {
        "ItemId": 3030002,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "2_Name",
          "SourceString": "终结战场",
          "LocalizedString": "戦いの果て"
        },
        "Quality": 1,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "2_Desc",
          "SourceString": "硝烟已散，唯有废墟与残垣记录着此处曾发生过的激战。战场终结于战士收枪的一刻，即便敌人仍在眼前。\n“任务已经完成，我没有继续战斗的理由。再会了，欧泊的战士们。”",
          "LocalizedString": "戦火はすでに消え去り、廃墟と瓦礫だけが激戦の記憶を刻んでいる。\n戦場が終わるのは、戦士が銃を下ろしたその瞬間——たとえ敵がまだ立っていようとも。\n「任務は終わった。もう戦う理由はない。……さらば、P.U.Sの戦士たち」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3030002.T_Dynamic_Background_3030002",
          "SubPathString": ""
