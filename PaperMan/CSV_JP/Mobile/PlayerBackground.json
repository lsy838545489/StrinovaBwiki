      "3": {
        "ItemId": 3030004,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "3_Name",
          "SourceString": "雨夜回望",
          "LocalizedString": "雨夜の回想"
        },
        "Quality": 1,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "3_Desc",
          "SourceString": "集团的内忧外患，压在年轻的话事人肩上。狩猎者的捕兽网重重落下，纯白的独角兽在雨夜中挣扎。\n“如果是‘你’，会怎样做呢？拜托了，过去的自己。”",
          "LocalizedString": "グループを揺るがす内外の危機。若き当主の肩に、重責がのしかかる。狩人たちの包囲網が迫る中、純白のユニコーンは雨の夜にもがいていた。\n「あんたなら、どうする？……頼む、過去の私」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3030004.T_Dynamic_Background_3030004",
          "SubPathString": ""
