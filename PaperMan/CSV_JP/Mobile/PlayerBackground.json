      "7": {
        "ItemId": 3031004,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "7_Name",
          "SourceString": "敬茶礼仪",
          "LocalizedString": "茶道のお作法"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "7_Desc",
          "SourceString": "有关茶叶一切都需要认真对待。选杯、温盏、置茶、润茶……每一步都不能马虎。尤其，是为了这个特殊的仪式。\n“既然你我都能作为彼此的老师，那这拜师的礼仪，也要独一无二才行。”",
          "LocalizedString": "茶葉と向き合うときは、どの手順も気を抜けない。\nまずは茶碗を選び、茶器を清め、茶葉を入れ、湯を注いで香りを立てる……。\nその一つひとつが、とある大切な「所作」へとつながっていく。\n「互いに学び合える関係なら、この礼の式も、特別な形にしないと」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3031004.T_Dynamic_Background_3031004",
