      "4": {
        "ItemId": 3031001,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "4_Name",
          "SourceString": "璀璨星空",
          "LocalizedString": "きらめく星空"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "4_Desc",
          "SourceString": "看不到星星的夜晚，也可以许愿吗？如果星空被阴霾遮盖，就用这场盛大的烟花，让天空重新璀璨，来换你同样灿烂的笑容。\n“谢谢前辈实现我的愿望。前辈的心愿，也由我来实现吧。”",
          "LocalizedString": "星が見えない夜でも願いは届くの？\nもし曇り空に星が隠れてしまうなら、盛大な花火で空にきらめきを取り戻せばいい。\nあなたが笑顔になれるように。\n「願いを叶えてくれてありがとう、先輩。今度は私が、先輩の願いを叶える番ですね」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3031001.T_Dynamic_Background_3031001",
          "SubPathString": ""
