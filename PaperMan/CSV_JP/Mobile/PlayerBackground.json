      "1": {
        "ItemId": 3030001,
        "Available": "EAvailableStateType::Available",
        "Default": true,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "1_Name",
          "SourceString": "幕间小憩",
          "LocalizedString": "静かなひととき"
        },
        "Quality": 1,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "1_Desc",
          "SourceString": "来自星辰的守护者沉沉睡去。在她的梦中，是否能看到某种预兆？关于未来，关于这个世界……\n“无数次……无数次……”",
          "LocalizedString": "星々の守護者は深い眠りにつく。その夢の中で、彼女は何を見るのだろう——未来の兆しか、それともこの世界の記憶か。\n「何度も……何度も……」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3030003.T_Dynamic_Background_3030003",
          "SubPathString": ""
