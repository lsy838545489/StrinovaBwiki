      "6": {
        "ItemId": 3031003,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "6_Name",
          "SourceString": "记忆独奏",
          "LocalizedString": "記憶のソロ"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "6_Desc",
          "SourceString": "音乐具有跨越时空的力量。当尘封已久的琴弦再度震颤，遥远时光里的微风与阳光，仿佛也随着音符一起重现在身边。\n“希望这首曲子可以停留在你的记忆中，无论经历多少岁月……”",
          "LocalizedString": "音楽には、時を越えて心を揺らす力がある。\n長く沈黙していた弦が再び震えたとき、遠い日々の光や風までが音に乗って蘇る。\n「この曲が、どれほど時が流れても、記憶に残りますように……」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3031003.T_Dynamic_Background_3031003",
