      "5": {
        "ItemId": 3031002,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "5_Name",
          "SourceString": "猫咪基地",
          "LocalizedString": "ねこ基地"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "5_Desc",
          "SourceString": "粘在衣服上的绒毛泄露了秘密。难道除了火力大喵和喵喵卫士，总是带着猫耳的搜查官还有其他喵喵吗？答案是：当然！\n“我的秘密基地，从今天开始，就向你开放啦！”",
          "LocalizedString": "服に付いたふわふわの毛が、すべてを語っている。\nパワーにゃんやガーディにゃんたち以外にも、猫耳の捜査官には秘密の仲間がいるのか？\nもちろん――いるに決まってる。\n「今日から、この秘密基地を相棒にも開放します」"
        },
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/PlayerBackground/Itemicon/T_Dynamic_Background_3031002.T_Dynamic_Background_3031002",
          "SubPathString": ""
