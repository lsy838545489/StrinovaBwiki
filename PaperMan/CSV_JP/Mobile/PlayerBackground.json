      "8": {
        "ItemId": 3031005,
        "Available": "EAvailableStateType::Available",
        "Default": false,
        "Name": {
          "Namespace": "PlayerBackground",
          "Key": "8_Name",
          "SourceString": "维修拍档",
          "LocalizedString": "整備パートナー"
        },
        "Quality": 6,
        "Desc": {
          "Namespace": "PlayerBackground",
          "Key": "8_Desc",
          "SourceString": "左手零件，右手工具……机器的升级和修理，一个人可搞不定！最好能有一个心意互通的维修拍档。\n“你的一系列操作像模像样嘛！看来最佳拍档的位置，‘马克兔’要让给你了！以后，也请多多关照！”",
          "LocalizedString": "左手にパーツ、右手にツール……。機械の強化も修理も、一人では限界があるものだ。\nだからこそ、息の合う整備パートナーが必要なんだ。\n「その手際、なかなかのものだね！ どうやら相棒の座をマークウサギから譲らなきゃいけないみたい。これからもよろしく頼むよ！」"
        },
