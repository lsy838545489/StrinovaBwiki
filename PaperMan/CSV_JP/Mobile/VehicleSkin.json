      "63000023": {
        "Id": 63000023,
        "BoolLoad": false,
        "AvailableState": 2,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000023_Name",
          "SourceString": "地心专列",
          "LocalizedString": "地心専列"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000023_Desc",
          "SourceString": "调皮的小恶魔驾驶着专列，包裹着炽热的熔岩从地心驶来。想拦住她，恐怕要费一番力气。\n\n【“地面上的交通规则，好复杂啊……”】",
          "LocalizedString": "地心から駆け上がる小悪魔の特別列車。 灼熱のマグマを纏い、誰にも止められない勢いで走り抜ける。止めようと思っても、ちょっとやそっとじゃ追いつけないかも。\n【「地上の交通ルールって、むずかしい……」】"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000023_SpDesc",
          "SourceString": "载具附近每2秒恢复1绝招点数",
          "LocalizedString": "輸送車の近くにいると、2秒ごとにアルティメットポイントPが1回復する。"
        },
        "Quality": 4,
        "SortId": 23,
