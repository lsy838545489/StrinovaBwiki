      "63000020": {
        "Id": 63000020,
        "BoolLoad": false,
        "AvailableState": 1,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_Name",
          "SourceString": "圣城传讯",
          "LocalizedString": "聖城の啓示"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_Desc",
          "SourceString": "歌剧院的舞台上，一出神话戏剧即将上演。应援车从圣城出发，驶向大街小巷，带来女神的传讯。\n\n【“迷途的人们啊，请跟随我的指引，到达神圣的终点吧。”】",
          "LocalizedString": "オペラハウスの舞台では、神話劇がまもなく開幕を迎える。聖都を出発した応援車が、街の隅々へと走り出し、女神の言葉を届けていく。\n\n【「迷える人々よ。私の導きに従い、光の先にある聖なる終点へと至りなさい」】"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000020_SpDesc",
          "SourceString": "载具附近每2秒恢复1生命值",
          "LocalizedString": "輸送車の近くにいると、2秒ごとにHPが1回復する。"
        },
        "Quality": 4,
        "SortId": 20,
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/VehicleSkin/VehicleSkinIcon/T_Dynamic_VehicleSkinIcon_63000020.T_Dynamic_VehicleSkinIcon_63000020",
