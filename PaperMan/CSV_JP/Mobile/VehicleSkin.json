      "63000021": {
        "Id": 63000021,
        "BoolLoad": false,
        "AvailableState": 2,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000021_Name",
          "SourceString": "午夜导播",
          "LocalizedString": "ミッドナイト・ブロードキャスター"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000021_Desc",
          "SourceString": "据说，有一辆神秘的导播车会出现在午夜的城市街头。若有幸寻觅到它的踪迹，便能接收到午夜电台的电波。\n\n【“晚上好，追逐蝴蝶的猎手。欢迎来到‘猎物’的主场。”】",
          "LocalizedString": "深夜の街角に、ひっそりと現れるという謎の中継車。もしその姿を見つけられたなら、深夜電波の向こう側に届く「特別な放送」を受信できるという。\n\n【「こんばんは、蝶を追う狩人さん。ようこそ「獲物」の主場へ」】"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000021_SpDesc",
          "SourceString": "载具附近每2秒恢复1护甲",
          "LocalizedString": "輸送車の近くにいると、2秒ごとにアーマーが1回復する。"
        },
        "Quality": 4,
        "SortId": 21,
        "IconItem": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/VehicleSkin/VehicleSkinIcon/T_Dynamic_VehicleSkinIcon_63000021.T_Dynamic_VehicleSkinIcon_63000021",
