      "63000022": {
        "Id": 63000022,
        "BoolLoad": false,
        "AvailableState": 1,
        "Name": {
          "Namespace": "VehicleSkin",
          "Key": "63000022_Name",
          "SourceString": "喵趣出击",
          "LocalizedString": "にゃんまる出撃"
        },
        "Desc": {
          "Namespace": "VehicleSkin",
          "Key": "63000022_Desc",
          "SourceString": "电玩城的宣传车，由赢得“超级玩家大赏”的电玩大使米雪儿友情代言。",
          "LocalizedString": "アーケードの宣伝用プロモーションカー。\n「スーパーゲーマー大賞」を制したアーケードアンバサダー、ミシェルが公式代言者を務めている。"
        },
        "SpDesc": {
          "Namespace": "VehicleSkin",
          "Key": "63000022_SpDesc",
          "SourceString": "贴车时，每2秒恢复1点绝招点数",
          "LocalizedString": "輸送車に張り付くと、2秒ごとにアルティメットポイントPが1回復する。"
        },
        "Quality": 3,
        "SortId": 22,
