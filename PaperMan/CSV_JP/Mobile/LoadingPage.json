        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_101.T_Dynamic_LoadingPage_101",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "101_Title",
          "SourceString": "欧泊",
          "LocalizedString": "P.U.S"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "101_Desc",
          "SourceString": "新世界的官方政府，维护秩序的同时，致力于研究“崩溃症”的根除方法。",
          "LocalizedString": "ストリノヴァの政府機関。秩序を維持しながら崩壊症の解決策を模索している。"
        }
      },
      "102": {
        "Id": 102,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_102.T_Dynamic_LoadingPage_102",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "102_Title",
          "SourceString": "剪刀手",
          "LocalizedString": "シザーズ"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "102_Desc",
          "SourceString": "与欧泊敌对的武装组织，试图争夺巴布洛晶体的控制权，打开回归旧世界的通道。",
          "LocalizedString": "P.U.Sと敵対する組織。 パブロクリスタルを奪取し、地球へのポータルを開こうとしている。"
        }
      },
      "103": {
        "Id": 103,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_103.T_Dynamic_LoadingPage_103",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "103_Title",
          "SourceString": "乌尔比诺",
          "LocalizedString": "ウルビノ"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "103_Desc",
          "SourceString": "控制着新世界生产命脉的商业财团，利用晶体能量探索着前往其他维度的方式。",
          "LocalizedString": "新世界の生産を握る巨大財団。パブロクリスタルを集め、別次元への道を切り開こうとしている。"
        }
      },
      "104": {
        "Id": 104,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_104.T_Dynamic_LoadingPage_104",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "104_Title",
          "SourceString": "超弦体",
          "LocalizedString": "超弦体"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "104_Desc",
          "SourceString": "超弦体掌握了弦化的能力，可以通过后颈处的Y形巴布洛结晶，驱动体内的弦序列进行打散与重组，从而实现2D态与3D态之间的自由转变。",
          "LocalizedString": "!NoTextFound!"
        }
      },
      "105": {
        "Id": 105,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_105.T_Dynamic_LoadingPage_105",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "105_Title",
          "SourceString": "巴布洛晶体",
          "LocalizedString": "パブロクリスタル"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "105_Desc",
          "SourceString": "卡丘世界里，从卡丘人到具体的宠物、植物、料理乃至建筑、大型设备等，均是绘师使用巴布洛晶体绘制出来的。",
          "LocalizedString": "ストリノヴァでは、ストリノヴァ人をはじめ、ペットや植物、料理から建築物や大型装置に至るまで、すべては絵師たちが「パブロクリスタル」を用いて描き出した創造物である。"
        }
      },
      "106": {
        "Id": 106,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_106.T_Dynamic_LoadingPage_106",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "106_Title",
          "SourceString": "爆破玩法",
          "LocalizedString": "デモリッション"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "106_Desc",
          "SourceString": "爆破入侵需要团队合作，攻守方围绕炸弹安放进行博弈。",
          "LocalizedString": "デモリッションは、アタック側とディフェンス側に分かれて爆弾の設置・解除を巡って競うモード。"
        }
      },
      "107": {
        "Id": 107,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_107.T_Dynamic_LoadingPage_107",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "107_Title",
          "SourceString": "卡拉彼丘",
          "LocalizedString": "ストリノヴァ"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "107_Desc",
          "SourceString": "随着地球能源枯竭，人类在弦理论的推动下，探索出一个多维空间，利用该空间中的“巴布洛晶体”，构建了能够适应多维空间的新身体，建立了城市，并将其命名为卡拉彼丘。",
          "LocalizedString": "地球のエネルギーが尽きかけ、人類は絶望の中、生き延びる道を探した。弦理論に基づいて、多次元空間への扉が開かれた。人類は、その空間で発見された「パブロクリスタル」を用いて新たな体を作り上げ、都市を築き、その空間を「ストリノヴァ」と呼んだ。"
        }
      },
      "108": {
        "Id": 108,
        "Type": 0,
        "Param": 0,
        "Page": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResourceMobile/Loading/T_Dynamic_LoadingPage_108.T_Dynamic_LoadingPage_108",
          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "108_Title",
          "SourceString": "阵营之争",
          "LocalizedString": "陣営関係"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "108_Desc",
          "SourceString": "每隔百年，卡拉彼丘的居民身体中的弦序列便会崩坏衰解，秉持着不同信念与想法的人们走上了彼此分歧的道路，卡拉彼丘也逐渐陷入了纷争的漩涡。",
          "LocalizedString": "だが、進歩には代償があった。百年ごとに、ストリノヴァの住人たちの弦配列が劣化し、崩壊する。 理想郷の夢が崩れ去るとともに、異なる信念とイデオロギーを持つ人々は分岐する道を歩み始めた。そして、「崩壊症」と呼ばれる新たな危機が訪れ、新世界は混沌の渦に巻き込まれていった……"
        }
      },
      "109": {
        "Id": 109,
