          "SubPathString": ""
        },
        "Title": {
          "Namespace": "LoadingPage",
          "Key": "109_Title",
          "SourceString": "推进玩法",
          "LocalizedString": "エスコート"
        },
        "Desc": {
          "Namespace": "LoadingPage",
          "Key": "109_Desc",
          "SourceString": "推进玩法需要团队配合，攻守方围绕运载目标进行对抗。",
          "LocalizedString": "エスコートモードではチーム連携が鍵となり、攻守両方が輸送車を巡って対決する。"
        }
      },
