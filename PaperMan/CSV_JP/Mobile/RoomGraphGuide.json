        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "2_Desc",
          "SourceString": "进攻方的任务是在规定时间内，沿着路线将运载目标推送到终点。",
          "LocalizedString": "アタック側は、制限時間内に輸送車をルートに沿ってゴールまで押し進めることが目的となる。"
        }
      },
      "3": {
        "PlayMode": 6,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "3_Desc",
          "SourceString": "防守方的任务是在路途中拦截运载目标，消灭敌人。",
          "LocalizedString": "ディフェンス側の任務は、輸送車の進行を妨害し、敵を排除すること。"
        }
      },
      "4": {
        "PlayMode": 6,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "4_Desc",
          "SourceString": "需要注意的是只有当进攻方待在运载目标附近，才能实现有效推进。",
          "LocalizedString": "アタック側のプレイヤーが近くにいる時のみ輸送車が進む。"
        }
      },
      "5": {
        "PlayMode": 6,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "5_Desc",
          "SourceString": "并且，该运载目标支持四面弦化贴墙和自由滑行。",
          "LocalizedString": "また、輸送車に張り付き、移動することができる。"
        }
      },
      "6": {
        "PlayMode": 6,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "6_Desc",
          "SourceString": "这些规则你都学会了，胜利就不难了。",
          "LocalizedString": "ルールを理解すれば、勝利はすぐそこにある。"
        }
      },
