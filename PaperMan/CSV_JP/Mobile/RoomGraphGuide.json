      "11": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "11_Desc",
          "SourceString": "个人乱斗就等同于单兵作战，你的目光所及之处皆是敌人。",
          "LocalizedString": "フリーフォーオールでは、目に見える相手は全員敵となる。"
        }
      },
      "12": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "12_Desc",
          "SourceString": "你若是想要冲突重围，枪法和身法缺一不可。",
          "LocalizedString": "包囲を突破するためには、エイムとムーブ両方が欠かせない。"
        }
      },
      "13": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "13_Desc",
          "SourceString": "可以尽量避开多个枪线的攻击，选择“趁乱偷袭”的策略。",
          "LocalizedString": "多方面からの攻撃を避けながら、混乱に乗じて奇襲を仕掛ける戦略がポイントとなる。"
        }
      },
      "14": {
        "PlayMode": 14,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "14_Desc",
          "SourceString": "毕竟你的“胜利目标”是尽快击败指定数量的敌人。",
          "LocalizedString": "このモードの目標は、制限時間内に特定の数の敵を迅速に撃破すること。"
        }
      },
      "15": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "CultureInvariantString": null
        }
      },
      "16": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "16_Desc",
          "SourceString": "熟悉地图的布局、包点位置和重要路线是入门的第一步。",
          "LocalizedString": "初心者は、マップの構造やボムサイトの位置、重要なルートを把握するところから始めよう。"
        }
      },
      "17": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "17_Desc",
          "SourceString": "如果你是进攻方，那就需要掩护携带装置的队友进入包点，完成安装任务。",
          "LocalizedString": "アタック側の場合、爆弾を持つ味方を援護し、ボムサイトでの設置を成功させることがカギとなる。"
        }
      },
      "18": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "18_Desc",
          "SourceString": "携带装置的队友一旦倒下了，装置就会原地掉落。",
          "LocalizedString": "爆弾キャリアーが倒されると、その場に爆弾が落ちる。"
        }
      },
      "19": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "19_Desc",
          "SourceString": "装置安装完毕后，要继续保持警惕，而不是提前庆祝。",
          "LocalizedString": "設置が完了した後も気を抜かずに警戒を続ける必要がある。"
        }
      },
      "20": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "20_Desc",
          "SourceString": "因为只有坚持到装置引爆或者敌人全部倒下，才算获胜。",
          "LocalizedString": "爆弾を爆発させ、または敵を全員倒したら、アタック側の勝利となる。"
        }
      },
      "21": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "21_Desc",
          "SourceString": "如果你是防守方，可以记住这两个获胜秘诀，一是在下包前消灭全部的敌人。",
          "LocalizedString": "ディフェンス側の勝利条件は二つ。ひとつは、爆弾設置前にアタック側を全滅させること。"
        }
      },
      "22": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "22_Desc",
          "SourceString": "二是在倒计时结束前，拆除装置。",
          "LocalizedString": "もうひとつは、カウントダウンが終了する前に爆弾を解除すること。"
        }
      },
      "23": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "23_Desc",
          "SourceString": "此外，双方打满规定的局数后，会交换攻防位置。",
          "LocalizedString": "また、規定のラウンドが経過すると攻守交代となる。"
        }
      },
      "24": {
        "PlayMode": 2,
        "Graph": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "Title": {
          "CultureInvariantString": null
        },
        "Desc": {
          "Namespace": "RoomGraphGuide",
          "Key": "24_Desc",
          "SourceString": "最终，先拿下指定分数的队伍就是赢家。",
          "LocalizedString": "最終的に、指定ラウンド数を先取したチームが勝者となる。"
        }
      }
    }
