        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "13101_Desc",
          "SourceString": "能将人体各项数据可视化的设备，由伊薇特发明。",
          "LocalizedString": "イヴェットの発明品。人体の様々な能力をデータ化できる。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "13101_ItemStory",
          "SourceString": "伊薇特发明了能“感知情绪”的设备，但社恐的她找不到测试对象。为了不让研究时的心血浪费，她决定向引航者寻求帮助。",
          "LocalizedString": "イヴェットは「感情を感知できる」デバイスを発明したが、コミュ障のためテスト対象が見つけられない。研究を無駄にしないために、彼女はナビゲーターに助けを求めた。"
        }
      },
