        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12404_Desc",
          "SourceString": "存储着重要数据的投影装置。",
          "LocalizedString": "重要なデータを保存したプロジェクター。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12404_ItemStory",
          "SourceString": "具有能够储存大容量工程数据的便携投影器，适合工程作业查看图纸使用。\n资深工程师的推荐产品，轻便小巧，不会占用工作台的空间。其中存储的内容寄托了许多人的思念。",
          "LocalizedString": "大容量の工学用データを保存可能な携帯型のプロジェクター。仕事をしながら設計図を確認するのにうってつけ。\n 軽量小型で作業場所のスペースをとらないため、熟練のエンジニア推奨の一品。保存されたデータには人々の想い出がこめられている。"
        }
      },
      "10701": {
        "Id": 10701,
        "OwnerRoleId": 107,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10701_Name",
          "SourceString": "“妙趣横生”展览门票",
          "LocalizedString": "奇想展の入場券"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66107001.T_Dynamic_Item_66107001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66107001.T_Dynamic_BigItem_66107001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10701_Desc",
          "SourceString": "一场艺术盛宴的入场券，混合着意外与灵感……",
          "LocalizedString": "驚きとインスピレーションに満ちた芸術祭の入場券…"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10701_ItemStory",
          "SourceString": "“妙趣横生”艺术展的入场券，特邀白芸艺术馆的玛德蕾娜小姐设计了极具新意的图案。\n这场展览的门票相对稀缺，想要获得参展的机会，至少需要提前半年预订。\n这两张来之不易的门票，是玛德蕾娜参与设计得到的额外酬劳。",
          "LocalizedString": "奇想展の入場券。白芸美術館のマダレーナが手掛けた模様が描かれている。\nこの展示会の入場券は大人気のため、手に入れるためには半年以上前に予約しなければならない。\n入手困難な入場券が2枚もあるのは、券の図案を描いたマダレーナが追加の報酬としてもらったからな。"
        }
      },
      "10702": {
        "Id": 10702,
        "OwnerRoleId": 107,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10702_Name",
          "SourceString": "“满载而归”采集篮",
          "LocalizedString": "有意義な旅のバスケット"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66107002.T_Dynamic_Item_66107002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66107002.T_Dynamic_BigItem_66107002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10702_Desc",
          "SourceString": "这个果篮里装着的可是“灵感”！",
          "LocalizedString": "フルーツのバスケットはインスピレーションでいっぱい！"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10702_ItemStory",
          "SourceString": "制作者抱着“满载而归”的美好愿望设计了这个采集篮，上面装饰了她最爱的甜茶草莓。\n在许多时候这个果篮都是空的，也许是托了艺术顾问的福，设计师“满载而归”的愿望才得以实现。",
          "LocalizedString": "有意義な旅だったと思ってほしいという願いをこめて作られたこのバスケットは、彼女の大好きな甘茶イチゴで飾られている。\n 空っぽのままであることも多いが、アートコンサルタントのおかげだろうか、作り手の願いは叶った。"
        }
      },
      "10703": {
        "Id": 10703,
        "OwnerRoleId": 107,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10703_Name",
          "SourceString": "绘笔和“七彩”调色盘",
          "LocalizedString": "絵筆と「七彩」のパレット"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66107003.T_Dynamic_Item_66107003",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66107003.T_Dynamic_BigItem_66107003",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10703_Desc",
          "SourceString": "调色盘与色彩，艺术家与顾问。",
          "LocalizedString": "パレットと色、それはアーティストとコンサルタントに似ている。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10703_ItemStory",
          "SourceString": "玛德蕾娜惯用的绘笔与“七彩”调色盘，上面涂满了用浆果特制的颜料。\n“七彩”是她7岁的生日礼物，在往后漫长的时光中，尽管它早已色迹斑斑，但每次画画的时候，玛德蕾娜都要用它来调色。",
          "LocalizedString": "マダレーナのお気に入りの絵筆と「七彩」のパレットは、ベリーで作った絵の具で覆われている。\n マダレーナは7歳の誕生日に「七彩」をもらった。ずっと使い続けたパレットには色が染みついているが、それでもマダレーナはいつだってこのパレットで色を混ぜる。"
        }
      },
