      "14601": {
        "Id": 14601,
        "OwnerRoleId": 146,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "14601_Name",
          "SourceString": "半损坏的星空板",
          "LocalizedString": "一部が壊れたスターパッド"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66146004.T_Dynamic_Item_66146004",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66146004.T_Dynamic_BigItem_66146004",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "14601_Desc",
          "SourceString": "第一次共事的纪念品。",
          "LocalizedString": "初めての共同作業の記念品。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "14601_ItemStory",
          "SourceString": "一块左边屏幕损坏的平板电脑，是曾经用来记录崩溃症患者的电子病例，现在作为和星绘第一次共事的纪念品而保存。\n屏幕正中间是星庇所的标志，四散的星星则代表来访的患者。",
          "LocalizedString": "崩壊症の患者のデータを記録するために使われていたタブレットだが、画面の左側が壊れている。今では、星理恵との初めての共同作業の記念品として保管されている。\n真ん中には星のクリニックのロゴが記されており、散りばめられた星々は訪れてくる患者を表わしている。"
        }
      },
      "14602": {
        "Id": 14602,
        "OwnerRoleId": 146,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "14602_Name",
          "SourceString": "望远镜和十字星挂坠",
          "LocalizedString": "望遠鏡と星のペンダント"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66146001.T_Dynamic_Item_66146001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66146001.T_Dynamic_BigItem_66146001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "14602_Desc",
          "SourceString": "星绘幼时的最爱，如今已有了新的意义。",
          "LocalizedString": "子どもの頃の星理恵が大好きだったもの。今では新しい意味がこめられている。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "14602_ItemStory",
          "SourceString": "做工精致的望远镜，上面用细链系着一枚金属十字星挂坠。\n以金属铜打造的镜筒，部件使用了珍贵的木材，保留着旧日地球的设计风尚。",
          "LocalizedString": "金属製の星のペンダントが細いチェーンで付けられた精巧な作りの望遠鏡。\n望遠鏡の筒は銅で、その他の部品は貴重な木材で作られている。旧地球のデザインスタイルを彷彿とさせる。"
        }
      },
      "14603": {
        "Id": 14603,
        "OwnerRoleId": 146,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "14603_Name",
          "SourceString": "“天体的秩序”手链",
          "LocalizedString": "「天体の秩序」ブレスレット"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66146003.T_Dynamic_Item_66146003",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66146003.T_Dynamic_BigItem_66146003",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "14603_Desc",
          "SourceString": "牵绊着天体的手链，刻有星绘的名字。",
          "LocalizedString": "星理恵の名前が刻まれた天体のブレスレット。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "14603_ItemStory",
          "SourceString": "一条手工制作的手链，太阳处于中心，连接着两端的星星和月亮。\n以旧日地球采掘到的晶石制作链身，其中一颗晶石内侧篆刻着星绘的名字。",
          "LocalizedString": "真ん中の太陽が星々と月をつないでいる手作りのブレスレット。\n 旧地球で採掘されたクリスタルを素材としている。クリスタルのひとつには星理恵の名前が刻まれている。"
        }
      },
      "14604": {
        "Id": 14604,
        "OwnerRoleId": 146,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "14604_Name",
          "SourceString": "闪光的烟花棒",
          "LocalizedString": "キラキラ花火棒"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66146002.T_Dynamic_Item_66146002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66146002.T_Dynamic_BigItem_66146002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "14604_Desc",
          "SourceString": "散发着温柔光芒的电子烟花棒。",
          "LocalizedString": "優しい光を放つ電子花火。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "14604_ItemStory",
          "SourceString": "通过发射电光束来模拟焰火的电子产品，凭借其安全无害性的设计，完全取代了使用火药的焰火棒。\n虽然注重电子感这点很有卡丘世界的风格，但其实也是来自旧日地球的物品。",
          "LocalizedString": "花火を模した光線を発する電子装置。その安全性により、従来の火薬式の花火に取って代わった。\n 電気を利用したデザインはストリノヴァにお似合いのスタイルだが、実はこれは旧地球に由来する品だ。"
        }
      },
      "10101": {
        "Id": 10101,
        "OwnerRoleId": 101,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10101_Name",
          "SourceString": "无暇的光之剑",
          "LocalizedString": "傷ひとつない光の剣"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66101002.T_Dynamic_Item_66101002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66101002.T_Dynamic_BigItem_66101002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10101_Desc",
          "SourceString": "一提到游戏，她的眸子里仿佛有星星在闪烁。",
          "LocalizedString": "ゲームについての話をしていると、その瞳は小さな星のようにきらめく。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10101_ItemStory",
          "SourceString": "《NO.1的正义英雄》巨剑周边模型，光洁无瑕，父亲赠予米雪儿的生日礼物，凝聚了她纯真的信仰与梦想。\n“手执利剑，遵循本心，勇敢地撕裂黑暗吧！这就是玩家的专属做派。”",
          "LocalizedString": "『ジャスティスヒーローNO.1』に登場する大きな剣の模型。キラキラ輝いている。ミシェルが誕生日に父親からもらったもの。模型はミシェルの純粋な信念と夢を体現している。\n 「剣を抜き、自分の心に従って闇を切り裂け！ それがゲーマーの生き方」"
        }
      },
      "10102": {
        "Id": 10102,
        "OwnerRoleId": 101,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10102_Name",
          "SourceString": "耀眼的搜查官徽章",
          "LocalizedString": "輝かしい捜査官バッジ"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66101003.T_Dynamic_Item_66101003",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66101003.T_Dynamic_BigItem_66101003",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10102_Desc",
          "SourceString": "这枚徽章上承载的东西，只能由我来维护了。",
          "LocalizedString": "このバッジにこめられた意味を守れるのは私だけ。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10102_ItemStory",
          "SourceString": "流淌着历任搜查官坚毅的欧泊徽章，正义之剑贯穿其中，英勇荣光闪耀依旧。\n“正义，英勇，坚毅，这是欧泊守护者的训诫。”\n“佩戴上这枚徽章以后，我也能成为那样的英雄了吧！”",
          "LocalizedString": "P.U.Sのバッジは、過去の捜査官たちの不屈の魂を表現している。剣がバッジを貫き、英雄の栄光は今も輝く。\n 「正義、勇気、そして忍耐。それがP.U.Sのモットー」\n 「このバッジを身につければ、私もヒーローになれるでしょ！」"
        }
      },
      "10103": {
        "Id": 10103,
        "OwnerRoleId": 101,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10103_Name",
          "SourceString": "孤独的影之盾",
          "LocalizedString": "孤独な影の盾"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66101004.T_Dynamic_Item_66101004",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66101004.T_Dynamic_BigItem_66101004",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10103_Desc",
          "SourceString": "我是搜查官米雪儿，也是超级玩家米雪儿！",
          "LocalizedString": "私は捜査官ミシェル。そして、スーパーゲーマーのミシェルでもあります！"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10103_ItemStory",
          "SourceString": "《NO.1的正义英雄》大盾周边模型，与模型巨剑配套发售。在米雪儿的手中，小小的模型竟然发挥了不可思议的妙用。\n“勇往直前，迎难而上，希望的光芒不会就此熄灭！”",
          "LocalizedString": "『ジャスティスヒーローNO.1』に登場する大きな盾の模型。剣とセットで販売された。ミシェルの手にかかれば、この小さな模型も素晴らしい出来栄えになる。\n 「さあ、前に進んで困難に立ち向かおう。希望の光は消させない！」"
        }
      },
      "10104": {
        "Id": 10104,
        "OwnerRoleId": 101,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10104_Name",
          "SourceString": "胜利的饼干与奖杯",
          "LocalizedString": "勝利のクッキーとトロフィー"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66101001.T_Dynamic_Item_66101001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66101001.T_Dynamic_BigItem_66101001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10104_Desc",
          "SourceString": "门背后究竟是？少女鼓足勇气推开了门……",
          "LocalizedString": "扉の向こうにはいったい何が？ 少女は勇気を振り絞って扉を開ける…"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10104_ItemStory",
          "SourceString": "米雪儿第一次因为“玩家作风”收获来自他人的谢礼，她在杯身上铭刻下自己的信念，用心地保护着里面小小的猫爪饼干。\n“致勇敢帅气的猫咪搜查官，你的勇敢坚毅如同游戏中的勇者一般。”",
          "LocalizedString": "ゲーマー流のやり方によって初めて感謝の贈り物を受け取ったとき、ミシェルはトロフィーに自らの信念を刻み、中には大事な肉球クッキーを入れた。\n 「勇敢でカッコいい猫の捜査官へ。あの日、あなたが勇敢に戦う姿はまさにヒーローそのものです」"
        }
      },
      "10501": {
        "Id": 10501,
        "OwnerRoleId": 105,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10501_Name",
          "SourceString": "《话语的螺旋角》精装版",
          "LocalizedString": "『談話の螺旋』ハードカバー版"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66105003.T_Dynamic_Item_66105003",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66105003.T_Dynamic_BigItem_66105003",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10501_Desc",
          "SourceString": "交友与谈判无异，都是从精神上征服人心。",
          "LocalizedString": "友だち作りは交渉と同じ。両方とも、誰かの信頼を勝ち取るための行動。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10501_ItemStory",
          "SourceString": "由奥黛丽父母所著的谈判手册，详尽记录了谈判的技巧及专业知识，带给了奥黛丽谈判桌上的无数场胜利。\n书本的第一页写着，“致我们最珍爱的女儿，奥黛丽·格罗夫。”",
          "LocalizedString": "オードリーの両親が書いた交渉の教科書には、幅広いテクニックや知識が盛り込まれており、オードリーが数多くの交渉に成功するのに役立ってきた。\n 最初のページには「オードリー・グローブ、私たちの最愛の娘へ」とある。"
        }
      },
      "10502": {
        "Id": 10502,
        "OwnerRoleId": 105,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10502_Name",
          "SourceString": "巧克力配方手账",
          "LocalizedString": "チョコレートレシピのノート"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66105004.T_Dynamic_Item_66105004",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66105004.T_Dynamic_BigItem_66105004",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10502_Desc",
          "SourceString": "经由制作者的巧思，巧克力热液雕琢成型。",
          "LocalizedString": "作った人の創意工夫によって、型から作られたチョコレート。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10502_ItemStory",
          "SourceString": "奥黛丽搜集整理的巧克力制作配方，覆盖了十多种款式，从配料到制作方法一应俱全。\n坚守着这份真心，百年家族傲然挺立，苦涩的巧克力也变得甜脆。",
          "LocalizedString": "オードリーはありとあらゆる種類のチョコレートのレシピを集めて整理した。素材から作り方まで、チョコ作りに関するすべてを網羅したのだ。\n オードリーの真心のおかげで歴史ある一家はその誇りを保ち、苦いチョコさえ甘くなっている。"
        }
      },
      "10503": {
        "Id": 10503,
        "OwnerRoleId": 105,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10503_Name",
          "SourceString": "骨瓷制咖啡杯",
          "LocalizedString": "ボーンチャイナのコーヒーカップ"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66105002.T_Dynamic_Item_66105002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66105002.T_Dynamic_BigItem_66105002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10503_Desc",
          "SourceString": "多方交锋的谈判场上，黑白交织，情理碰撞。",
          "LocalizedString": "交渉の場では、黒と白がそれぞれ論理と感情を体現し、互いに衝突する。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10503_ItemStory",
          "SourceString": "简约古典的骨瓷制咖啡杯，是某年生日父母所赠的礼物，因为喝不惯咖啡，奥黛丽的使用次数并不是很多。\n咖啡承载着记忆的味道，它见证了古老家族的聚散离合。",
          "LocalizedString": "簡素で古典的なボーンチャイナのコーヒーカップ。両親がくれた誕生日プレゼント。オードリーはコーヒーが好きではないのであまり使わない。\n コーヒーの香りは想い出を運んでくる。歴史ある一族の集いと別れの想い出を。"
        }
      },
      "10504": {
        "Id": 10504,
        "OwnerRoleId": 105,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "10504_Name",
          "SourceString": "黑白独角兽勋章",
          "LocalizedString": "黒と白のユニコーンメダル"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66105001.T_Dynamic_Item_66105001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66105001.T_Dynamic_BigItem_66105001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "10504_Desc",
          "SourceString": "百年家族的高傲与纯洁恒久地流溢其间。",
          "LocalizedString": "歴史ある一族の誇りと純潔がこれでもかと感じられる。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "10504_ItemStory",
          "SourceString": "一对镌刻了黑白独角兽的荣誉勋章，承载着古老家族的信任，据说被授予者将受到来自独角兽的祝福。\n在时间面前，所有东西都会腐朽，唯有高洁的灵魂不可磨灭。",
          "LocalizedString": "黒と白のユニコーンが刻まれ、名誉を象徴する一対のメダル。歴史ある一族の信頼を、それは担っている。授与された者はユニコーンの祝福を受けるとされている。\n すべては時の流れとともに朽ちる。それに耐えうるものは、ただ高潔な魂のみ。"
        }
      },
      "12801": {
        "Id": 12801,
        "OwnerRoleId": 128,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12801_Name",
          "SourceString": "剪刀手出入通行证",
          "LocalizedString": "シザーズのパス"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66128002.T_Dynamic_Item_66128002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66128002.T_Dynamic_BigItem_66128002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12801_Desc",
          "SourceString": "决断事务其疾如风，为将先行，必成表率。",
          "LocalizedString": "将たるもの、素早く決断を下し、行動によって範を示すべきだ。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12801_ItemStory",
          "SourceString": "一张金属制的通行证卡片，印有“剪刀手”阵营的标志，由拉薇所赠，和拉薇的相识由此开始。\n它代表着剪刀手信任与认可，拥有了它可自由出入剪刀手的部分场所。",
          "LocalizedString": "シザーズのシンボルが刻まれた金属製のパス。ラヴィーネとの交流はこのパスとともに始まった。\n シザーズの信頼と承認を表わしており、その縄張りの一部のエリアを自由に出入りできるようになる。"
        }
      },
      "12802": {
        "Id": 12802,
        "OwnerRoleId": 128,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12802_Name",
          "SourceString": "便携式纳药箱",
          "LocalizedString": "携帯用応急手当キット"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66128001.T_Dynamic_Item_66128001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66128001.T_Dynamic_BigItem_66128001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12802_Desc",
          "SourceString": "身为一柄组织的利刃，势如猛火侵敌掠阵。",
          "LocalizedString": "シザーズの破壊兵器とも言うべきラヴィーネは、激しく燃える炎のように敵陣を切り裂く。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12802_ItemStory",
          "SourceString": "拉薇个人的纳药箱，外观简约，容量不大，备齐了常见的医疗用品，特别是外伤用药物。\n拉薇很节制地使用这些药品，她似乎对自己的伤口并不在意。",
          "LocalizedString": "ラヴィーネの個人用応急手当キット。簡素であまり大きくはなく、一般的な医薬品、特に傷を手当するためのものが入っている。\n ラヴィーネはあまり医薬品を使っていない。どうやら自分の傷のことはあまり気にしていないようだ。"
        }
      },
      "12803": {
        "Id": 12803,
        "OwnerRoleId": 128,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12803_Name",
          "SourceString": "太阳镜与贝雷帽套装",
          "LocalizedString": "サングラスとベレー帽"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66128003.T_Dynamic_Item_66128003",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66128003.T_Dynamic_BigItem_66128003",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12803_Desc",
          "SourceString": "应机而动，临危不惧，犹如松柏迎风不折。",
          "LocalizedString": "風に耐えて立つ松の木のようにしなやかで、何も恐れない。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12803_ItemStory",
          "SourceString": "商场打折时购入的贝雷帽和太阳镜，外观朴实，防晒性能优秀。在巧解了一次危机后赠给了拉薇，经过她的精心打整后，帽子带上了淡淡的香气，光泽如新。\n拉薇十分珍爱它们，在艳阳天穿戴出门，她似乎坚信它们能为自己带来好运与勇气。",
          "LocalizedString": "セールで買ったベレー帽とサングラス。シンプルな見た目だが、紫外線からはしっかり守ってくれる。ラヴィーネはこれを借りて危機を乗り切った。ラヴィーネが丁寧に手入れしてくれたおかげで、新品みたいにきれいになった帽子からはほのかな香りが漂ってくる。\n ラヴィーネは帽子とサングラスをとても大事にしていて、晴れの日には必ず身につける。それらが幸運と勇気をもたらしてくれると信じているようだ。"
        }
      },
      "12804": {
        "Id": 12804,
        "OwnerRoleId": 128,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12804_Name",
          "SourceString": "训练用木制匕首",
          "LocalizedString": "修行用の短刀"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66128004.T_Dynamic_Item_66128004",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66128004.T_Dynamic_BigItem_66128004",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12804_Desc",
          "SourceString": "她轻闭双眸，感受着和你一样的沉稳心境。",
          "LocalizedString": "あなたのような落ち着きを得るために、彼女は目を閉じる。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12804_ItemStory",
          "SourceString": "拉薇平时训练刀术所用的木制匕首，整体轻便小巧，易于隐藏。刀身刻满了久远的时间，记录了拉薇的每一次训练。\n拉薇在武馆的武器架上发现了它，自此，在武馆的竹林中或茶社的月夜中，它总会陪伴着拉薇寻求内心的安宁。",
          "LocalizedString": "ラヴィーネが武道の修行で用いる木製の短刀。小型かつ軽量で、どこにでも隠せる。刃の部分はひどく摩耗していて、ラヴィーネが懸命に修行してきたことをうかがわせる。\n 道場の武器棚にこれを見つけたラヴィーネは、心の安寧を求めて手に取った。道場裏の竹林にも月明かりに照らされた茶室にも持っていく。"
        }
      },
      "12401": {
        "Id": 12401,
        "OwnerRoleId": 124,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12401_Name",
          "SourceString": "\"心夏推荐\"立牌",
          "LocalizedString": "「心夏の推薦」スタンド"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66124004.T_Dynamic_Item_66124004",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66124004.T_Dynamic_BigItem_66124004",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12401_Desc",
          "SourceString": "来自大排档美食家的肯定。",
          "LocalizedString": "屋台食のグルメから贈られる認定証。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12401_ItemStory",
          "SourceString": "做工精巧的亚克力立牌，上面画着心夏竖起大拇指的Q版头像。\n只有在味道、品质和创新性上都得到认可的商家才能得到的荣誉，受到市民们的广泛认可。",
          "LocalizedString": "精巧に作られたアクリルスタンドには、小さな心夏がサムズアップする様子が描かれている\n 味、品質、そして革新性が認められた屋台にのみ贈られる栄誉。このアクリルスタンドがある店に外れはないとみんな知っている。"
        }
      },
      "12402": {
        "Id": 12402,
        "OwnerRoleId": 124,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12402_Name",
          "SourceString": "休眠的小兔",
          "LocalizedString": "眠りについたウサギ"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66124001.T_Dynamic_Item_66124001",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66124001.T_Dynamic_BigItem_66124001",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12402_Desc",
          "SourceString": "心夏的无人机，承载着贵重的回忆。",
          "LocalizedString": "心夏のドローン。大事な想い出が詰まっている。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12402_ItemStory",
          "SourceString": "心夏一直使用的海兔型治疗无人机，充满个性化的设计美学。\n失去了动力，无力地耸拉着耳朵，也许它只是累了，只要睡一会就能回到心夏身边。在它睡醒之前，要替心夏好好保管。",
          "LocalizedString": "心夏が使っているアメフラシ型のヒーリングドローン。独特な美的センスでデザインされている。\n もはや電力は尽きかけており、ドローンの耳は力なくはばたいている。心夏のもとに戻るには、ちょっと休んで疲れを癒やす必要があるのかもしれない。再び立ち上がるその日まで、心夏のために守ってあげよう。"
        }
      },
      "12403": {
        "Id": 12403,
        "OwnerRoleId": 124,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12403_Name",
          "SourceString": "蒙尘的古代人偶",
          "LocalizedString": "埃まみれの古代の人形"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66124002.T_Dynamic_Item_66124002",
          "SubPathString": ""
        },
        "ItemPicture": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/BigIcon/T_Dynamic_BigItem_66124002.T_Dynamic_BigItem_66124002",
          "SubPathString": ""
        },
        "CheckReward": [
          {
            "ItemId": 6,
            "ItemAmount": 30
          }
        ],
        "Desc": {
          "Namespace": "PledgeItem",
          "Key": "12403_Desc",
          "SourceString": "心夏珍藏的宝物,凝聚了往昔的时光。",
          "LocalizedString": "心夏の想い出が詰まった大切なもの。"
        },
        "ItemStory": {
          "Namespace": "PledgeItem",
          "Key": "12403_ItemStory",
          "SourceString": "造型奇特的古代人偶，旧地球的文化遗产，此为工艺美术复制品。\n即使在心夏收到过的众多奇特礼物中也算得上最奇特的一个，据说心夏曾用它来玩过家家。",
          "LocalizedString": "奇妙な形状をした古代の人形のレプリカ。旧地球の文化遺産。\n 心夏がもらったプレゼントはどれも独特なものばかりだったが、そのなかでもこれは群を抜いて奇妙だ。心夏はこの人形でおままごとをしていたらしい。"
        }
      },
      "12404": {
        "Id": 12404,
        "OwnerRoleId": 124,
        "Name": {
          "Namespace": "PledgeItem",
          "Key": "12404_Name",
          "SourceString": "崭新的蓝图",
          "LocalizedString": "最新の設計図"
        },
        "ItemIcon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Item/ItemIcon/T_Dynamic_Item_66124003.T_Dynamic_Item_66124003",
