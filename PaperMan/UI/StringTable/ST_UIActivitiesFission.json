    "StringTable": {
      "TableNamespace": "ST_UIActivitiesFission",
      "KeysToEntries": {
        "TaskProgress": "任务进度：",
        "TextBlock_16_Text": "2023年9月27日6:00  –  2023年12月7日5:59",
        "TextBlock_10_Text": "在你收到这封邮件时，你已经被启蒙计划选为候补学员之一。",
        "ToBeRecruited": "待招募",
        "BiologicalLaboratory": "生物实验室",
        "TextBlock_3_Text": "我们希望给予所有人以自己的意志平等地选择未来的权力，启蒙计划应运而生——启发人们、引导人们，无论他们最终选择为何而战。",
        "TextBlock_3_Text1": "我们在重新检测到你的通讯讯号后第一时间发出了这封邮件，欢迎你回到卡丘世界。",
        "NewcomerRegistrationEmail": "新人报到邮件",
        "ConfirmReplacement": "确认更换",
        "TextBlock_19_Text": "玩家完成身份的专属任务, 可解锁专属奖励；",
        "TextBlock_6_Text": "你在卡丘世界累积了丰富的战斗经验，但与此同时，世界上还有许多人尚不具备独自战斗的力量和勇气。",
        "AMysteriousEmail": "一封神秘的邮件",
        "Txt_Grad_Text": "达到<HangUpRed>20</>级后，您可以考虑受聘为<HangUpRed>招募官</>,继续为卡丘世界培养新生力量。招募官的奖励也是十分丰厚的哟~",
        "ActivityIdentity": "活动身份: ",
        "NewStudent": "新学员",
        "EnlightenmentPlanningCommittee": "启蒙计划委员会",
        "ChangePassword": "更换口令",
        "StartupProtocol": "启动协议",
        "TextBlock_3_Text2": "新学员累计30天未登录，将被自动移出学员列表，已完成和进行中的任务进程不会受到影响。",
        "ViewAllStudents": "查看全部学员",
        "TheLightOfStarPainting": "星绘的光芒",
        "TextBlock_26_Text": "自该活动触发后, <重链卡丘空间>共持续开放21天。",
        "TheTeamIRecruited": "我招募的小队",
        "RecruiterTasks": "招募官任务",
        "RebuildCommunicationChannel": "重建联络管道",
        "IssuingUnit": "颁发单位",
        "Tutor": "导师：",
        "TextBlock_8_Text": "等级到达20级，即可成为招募官，获取丰厚奖励。",
        "NewbieTraining": "新人培训",
        "TextBlock_18_Text": "游戏活动期间，会根据调查官的卡丘等级, 发布游戏身份.",
        "StudentOverview": "学员总览",
        "TheCurrentActivityWillBeIn": "当前活动将在",
        "TextBlock_11_Text": "你已经主动迈出了战斗的第一步，这是非常难得的资质，我们相信你会在未来的卡丘世界发挥重要的作用。",
        "BecomeARecruiter": "成为招募官",
        "TextBlock_4_Text": "在你离开的时候，卡丘世界发生了很多变化，在你探索这些变化的同时，我们也为你准备了一系列\r\n训练项目，帮助你找回战斗的感觉。",
        "EditableTextBox_Command_HintText": "点击右边粘贴按钮或者单击输入招募口令",
        "LinkInterruptionCode": "链接中断代码：",
        "WorkHardToImproveYourLevel": "努力提升自己等级吧！",
        "TextBlock_8_Text1": "完成全部新人任务，获得专属活动奖励",
        "Level": "等级: ",
        "TextBlock_12_Text": "但在你能真正以自己的意志选择为之奋战的未来之前，你也许还需要一些帮助和指引，启蒙计划正是为此而生。",
        "Graduated": "已毕业",
        "RookieTrain_Time": "当前活动将在{num}后结束",
        "TextBlock_2_Text": "引航者，你已被选中成为启蒙计划的教官。",
        "EndAfter": "后结束",
        "InstructorTask": "教官任务",
        "TextBlock_29_Text": "若招募的学员累计超过30天未登录游戏, 则双方绑定关系自动解绑。",
        "TextBlock_3_Text3": "可自选招募口令，更换后原口令将不再生效。",
        "TextBlock_14_Text": "寻找一位教官，获取招募口令，新世界的大门会为你打开。",
        "HelloPilot": "你好，引航者。",
        "NoviceTraining": "新手训练",
        "LaviSneakAttack": "拉薇 - 影袭",
        "TextBlock_4_Text1": "      你已经主动迈出了战斗的第一步，这是非常难得的资质，我们相信你会在未来的卡丘\r\n界发挥重要的作用。",
        "PreviousLogin": "前登录",
        "TextBlock_25_Text": "此活动仅对距离上次登录时间超过30天的引航者开放，在此活动期间，完成指定任务，获取专属奖励。",
        "TheFirstEnlightenmentProgramOfKaraPicchu": "卡拉彼丘第一届启蒙计划",
        "LookingForwardToWorkingWithYouAgain": "期望与你再次合作。",
        "CertificateNumber": "证书编号：",
        "PilotLongTimeNoSee": "引航者，好久不见。",
        "MyRecruitmentPassword": "我的招募口令",
        "TextBlock_25_Text1": "游戏活动期间，获得招募官获得口令, 可解锁专属新人奖励。",
        "TextBlock_26_Text1": "当完成全部新人任务后并领取奖励, 同时卡丘等级达到20级别后, 可成为教官进行学员招募。",
        "TextBlock_6_Text1": "      但在你能真正以自己的意志选择为之奋战的未来之前，你也许还需要一些帮助和指引，\r\n启蒙计划正是为此而生。",
        "CombatExercise": "作战练习",
        "TextBlock_23_Text": "招募的若学员流失, 则双方绑定关系自动解绑, 任务数据会保留。",
        "LaviWeaponssneakAttack": "拉薇武器 — 影袭",
        "TextBlock_1_Text": "·",
        "TextBlock_22_Text": "    卡丘游戏等级>=20级, 可立即获得教官身份。",
        "TextBlock_4_Text2": "我们相信你能完成这个任务。别担心，启蒙计划为你准备了丰富的物资支援以及可靠的协助者，你马上就会见到她。",
        "CurrentPassword": "当前口令",
        "ImportantSupplies": "重要物资",
        "GraduationCertificate": "毕业证书",
        "MyRecruitmentOfficer": "我的招募官",
        "TextBlock_21_Text": "    卡丘等级<=5级, 为目标招募学员。",
        "CurrentlyObtained": "当前获取：",
        "Text_1": "重链卡丘空间",
        "GoBack_Time": "链接将于<GoBackTime_Yellow>{num}天</>后终止，请尽快获取资源////"
