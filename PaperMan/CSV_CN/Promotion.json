      "9": {
        "Id": 1009,
        "Sort": 9,
        "Title": {
          "Namespace": "Promotion",
          "Key": "9_Title",
          "SourceString": "炽焱狂龙",
          "LocalizedString": "焔竜バハムート"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "9_SubTitle",
          "SourceString": "喷火器传说外观威风驾临！",
          "LocalizedString": "レジェンダリー外観「焔竜バハムート」堂々登場！"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "9_Desc",
          "SourceString": "它是来自虚拟位面的终末之龙，能够带来滔天的焰浪！\n只因一场意外，如今穿越而来！\n与它结盟，一起完成它的复仇计划！",
          "LocalizedString": "虚数の世界からやってきた、終末の竜。\n世界を燃やす炎と共に、いま降臨！\n――その復讐に、あなたも加わらないか？"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_4.T_Dynamic_FacePicture_4",
          "SubPathString": ""
