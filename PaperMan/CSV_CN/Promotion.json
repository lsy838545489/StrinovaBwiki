      "10": {
        "Id": 1010,
        "Sort": 10,
        "Title": {
          "Namespace": "Promotion",
          "Key": "10_Title",
          "SourceString": "三途雾徊",
          "LocalizedString": "三途の霧"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "10_SubTitle",
          "SourceString": "忧雾传说外观限时开启！",
          "LocalizedString": "夕霧レジェンダリー外観期間限定登場！"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "10_Desc",
          "SourceString": "她扬手散落神火，便有灵风萦绕；\n她赤足踏过秽土，便有花雨飘零。\n她是生死薄雾中的幽影，是泣血迷魂苦求的救赎。",
          "LocalizedString": "手をかざせば業火は舞い、その身を巡るは幽き風。\n裸足で穢土を渡れば、花は雨となり、空に零れ落つ。\n彼女は生と死の狭間に立つ幽影、迷える魂を導く救済の灯火。"
        },
