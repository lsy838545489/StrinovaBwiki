      "8": {
        "Id": 1008,
        "Sort": 8,
        "Title": {
          "Namespace": "Promotion",
          "Key": "8_Title",
          "SourceString": "日珥鸣火·千面之月",
          "LocalizedString": "プロミネンス・千貌の月"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "8_SubTitle",
          "SourceString": "艾卡·芙拉薇娅传说外观返场",
          "LocalizedString": "アイカ＆フラヴィアレジェンダリー外観復刻"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "8_Desc",
          "SourceString": "她是永燃之日，是燃尽黑暗的烈烈明火。\n她似恒凝之月，是照亮幽深的殷殷流光。\n为这世界的每一个晨昏轮转，她们终会交辉。",
          "LocalizedString": "彼女は燃え続ける太陽、闇を焼き尽くす烈火。\n彼女は凍てつく月、深淵を照らす流光。\n日と月が巡り合う時、世界は新たな暁を迎える。"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_3.T_Dynamic_FacePicture_3",
          "SubPathString": ""
        },
