      "7": {
        "Id": 1007,
        "Sort": 7,
        "Title": {
          "Namespace": "Promotion",
          "Key": "7_Title",
          "SourceString": "溯光圣祈",
          "LocalizedString": "聖光の祈り"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "7_SubTitle",
          "SourceString": "珐格兰丝",
          "LocalizedString": "フラグランス"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "7_Desc",
          "SourceString": "奇迹之花的盛开，始于“崩溃”的再次侵袭。\n裙甲焕明，手执灯炬，她的身影是庇护也是指引。\n她从不是沐浴穹光的娇蕊。她从来是刺破秽暗的荆棘。",
          "LocalizedString": "「崩壊」が再びこの地を襲ったとき、奇跡の花はそのつぼみを開いた。\n輝く鎧で身を包み、灯火を手に掲げた彼女の姿は、人々にとって希望であり、道しるべでもあった。\n彼女は、ただ光にすがる花ではなく、闇をも裂く、誇り高き茨である。"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_1.T_Dynamic_FacePicture_1",
          "SubPathString": ""
        },
