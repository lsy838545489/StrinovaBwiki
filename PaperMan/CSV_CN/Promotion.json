      "6": {
        "Id": 1006,
        "Sort": 6,
        "Title": {
          "Namespace": "Promotion",
          "Key": "6_Title",
          "SourceString": "焰翎魔女",
          "LocalizedString": "炎羽の魔女"
        },
        "SubTitle": {
          "Namespace": "Promotion",
          "Key": "6_SubTitle",
          "SourceString": "加拉蒂亚",
          "LocalizedString": "ガラテア"
        },
        "Desc": {
          "Namespace": "Promotion",
          "Key": "6_Desc",
          "SourceString": "她是无迹可寻的魔女，是召来弦能之火的日轮。\n​她沉醉于弦能的奥妙，魔法的无垠，不在意凡间无趣的争吵。\n​唯有那些妄图染指弦能的无知者才会看到，魔女驾临的危险与威严。",
          "LocalizedString": "人目を逃れ潜む魔女、弦の火を呼ぶ日輪の使者。\n弦能という神秘の魔力に耽溺し、魔法の果てしなさに魅了される。\n凡世の些細な争いなど気にかけず、ただその奥深さを極める。\nただ、弦能に触れようとする無知なる者たちのみが、魔女の降臨に伴う危険を目の当たりにする。"
        },
        "Localicon": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/Activities/FacePicture/T_Dynamic_FacePicture_2.T_Dynamic_FacePicture_2",
          "SubPathString": ""
        },
        "StartTime": {
