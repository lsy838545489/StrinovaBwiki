        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "HuiXing_146_Lv_6",
          "Key": "Row6_TextContent_FromRoleId146",
          "SourceString": "之所以问这个，是因为我刚才经历了一次很奇妙的体验。",
          "LocalizedString": "どうしてこんなことをお聞きするかと言うと、ついさっき不思議な経験をしたんです。"
        },
        "TextureContent": {
          "AssetPathName": "None",
