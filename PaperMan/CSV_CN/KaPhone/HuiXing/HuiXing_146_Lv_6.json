        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "HuiXing_146_Lv_6",
          "Key": "Row7_TextContent_FromRoleId146",
          "SourceString": "一般来说，人在睡觉的时候不可能听到自己说梦话才对吧？",
          "LocalizedString": "普通、寝ているとき自分の寝言なんて聞こえないはずなんですけど…"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
