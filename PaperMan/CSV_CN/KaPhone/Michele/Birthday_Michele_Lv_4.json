          {
            "Namespace": "",
            "Key": "AEBEE5404D5D220E33919192A8317815",
            "SourceString": "熟、熟能生巧……",
            "LocalizedString": "「慣れたもん勝ち」って感じかな。"
          },
          {
            "Namespace": "",
            "Key": "B2E7D6F04CA094A753789096F1DE18C5",
            "SourceString": "肌、肌肉记忆……",
            "LocalizedString": "筋、筋肉記憶……"
          }
        ],
