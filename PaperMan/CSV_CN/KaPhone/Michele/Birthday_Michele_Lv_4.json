      "5": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 101,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_101.T_Dynamic_RolePorfile_101",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "A51653CD4875CDB2CE8A2297DD875D6C",
          "SourceString": "等等，你不要误会啊！我今年真的很少写检讨的，连芙拉薇娅部长都表扬我了！",
          "LocalizedString": "ちょっと待って！誤解しないでください！今年、ほとんど報告書を書いてないんです！フラヴィア部長にも褒められたんですよ！"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "GreetingCardList": [],
        "NormalJumpRowName": "6",
        "OptionType": "ECyCommunicationOptionType::None",
        "TextContentList": [],
        "EmojiList": [],
        "TextureList": [],
        "OptionalJumpRowNameArray": []
      },
      "6": {
        "bIsPlayer": false,
        "bNeedShowAvatar": true,
        "FromId": 101,
        "Avatar": {
          "AssetPathName": "/Game/PaperMan/UI/Atlas/DynamicResource/RoleSkin/RoleProfile/T_Dynamic_RolePorfile_101.T_Dynamic_RolePorfile_101",
          "SubPathString": ""
        },
        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "F7201FE248A7F188EF8FA39F7FC20A29",
          "SourceString": "这次只是巧合，误会，意外……呜呜呜，偶尔热血上头的时候是会忘记流程的……",
          "LocalizedString": "今回のはほんとに偶然で、うっかりやっちゃったんです……うぅ、たまに熱血が上がってしまって、手順を飛ばしちゃうことがあるんです。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
