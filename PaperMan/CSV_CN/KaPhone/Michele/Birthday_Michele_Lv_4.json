        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "",
          "Key": "3F882C02412AC6260011D389361A4AAA",
          "SourceString": "实在是忍不了，先把欺负人的坏蛋暴揍了一顿，才想起来要先走通报抓捕流程……",
          "LocalizedString": "どうしても我慢できなくて、先に悪者をしっかり捕まえてから、報告の流れを思い出しました……"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
