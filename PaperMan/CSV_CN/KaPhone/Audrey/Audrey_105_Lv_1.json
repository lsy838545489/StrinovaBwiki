        "TextContent": {
          "Namespace": "Audrey_105_Lv_1",
          "Key": "Row3_TextContent_FromRoleId105",
          "SourceString": "真是难得，今天我不用处理公务，方便一起喝个下午茶吗？",
          "LocalizedString": "今日は珍しくやることがない日。いっしょにお茶でも飲まない？"
