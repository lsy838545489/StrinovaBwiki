        "TextContent": {
          "Namespace": "Audrey_105_Lv_1",
          "Key": "Row6_TextContent_FromRoleId105",
          "SourceString": "那我就提前预定了，挑了个不错的靠窗位置。",
          "LocalizedString": "いい感じの窓際の席を予約しておいた。"
        },
