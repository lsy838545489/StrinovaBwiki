        "TextContent": {
          "Namespace": "yvette_131_Lv_1",
          "Key": "Row12_TextContent_FromRoleId131",
          "SourceString": "而且不知道为什么，事情的处理变得更顺利了。",
          "LocalizedString": "よく分からないけど、上手くいくようになったんだ。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
