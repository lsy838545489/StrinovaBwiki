        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "yvette_131_Lv_1",
          "Key": "Row11_TextContent_FromRoleId131",
          "SourceString": "我让菲“试营业”了几天，发现效果意外很好。",
          "LocalizedString": "フェイに何にか「プレオープン」させたところ、思いのほか良かったよ。"
        },
        "TextureContent": {
          "AssetPathName": "None",
