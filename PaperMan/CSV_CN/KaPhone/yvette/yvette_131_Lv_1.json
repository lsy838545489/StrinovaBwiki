        "Type": "ECyCommunicationThirdLevelType::Normal",
        "ContentType": "ECyCommunicationContentType::Text",
        "TextContent": {
          "Namespace": "yvette_131_Lv_1",
          "Key": "Row10_TextContent_FromRoleId131",
          "SourceString": "因为我想……与其花那么长的时间做心理建设，不如让菲替我去见陌生人。",
          "LocalizedString": "そんなに時間を掛けて……心の準備をするより、私の代わりにフェイに会ってもらったほうがいいような気がする。"
        },
        "TextureContent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
        "AkOnEvent": {
          "AssetPathName": "None",
          "SubPathString": ""
        },
