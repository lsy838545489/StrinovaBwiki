        "TextContent": {
          "Namespace": "Maddelena_107_Lv_1",
          "Key": "Row11_TextContent_FromRoleId107",
          "SourceString": "引航者，在假期间你有什么打算吗？",
          "LocalizedString": "ナビゲーター、休みの日の予定はもう決まってる？"
