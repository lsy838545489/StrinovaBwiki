        }
      },
      "1000202": {
        "DialogId": 1000202,
        "DialogType": 1,
        "DialogPosition": 1,
        "RoleId": 146,
        "Content": {
          "Namespace": "GuideDialogue",
          "Key": "1000202_Content",
