        "NameText": {
          "Namespace": "SequenceMap",
          "Key": "97001_NameText",
          "SourceString": "科摩斯塔",
          "LocalizedString": "コスモスタワー"
        },
        "Desc": {
          "Namespace": "SequenceMap",
          "Key": "97001_Desc",
          "SourceString": "科摩斯塔是每座城市的供能中心，通过大量巴布洛晶体产生的弦能共鸣维持着区域的稳定，从而压制【崩溃】以及【逆弦化】现象。",
          "LocalizedString": "コスモスタワーはすべての都市のエネルギーの供給源だ。パブロクリスタルを集約することで生成された超弦体が一帯の安定性を保っており、「崩壊症」と「逆弦化」を食い止めている。"
        }
      },
      "97013": {
        "MapId": 97013,
        "MapName": "/Game/PaperMan/Maps/Envi_Train/Envi_Train",
        "LevelStreamList": [],
        "NameText": {
          "Namespace": "SequenceMap",
          "Key": "97013_NameText",
          "SourceString": "防御系统",
          "LocalizedString": " 防御システム"
        },
        "Desc": {
          "Namespace": "SequenceMap",
          "Key": "97013_Desc",
          "SourceString": "科摩斯塔中设有防御系统，它存在于一个虚拟的空间中，并仿照了【真实荒野】的特性。闯入者承受着难以抑制的不适感与序列混乱的无序感，最终在防御系统中走向逆弦化的结局。",
          "LocalizedString": "コスモスタワーの防御システムは「原生地域」を模倣した仮想空間に存在する。侵入者は極めて険しい環境を乗り越えなければならない。そして、乗り越えたとしても、その先に待っているのは逆弦化の運命だ。"
        }
      },
      "97002": {
        "MapId": 97002,
        "MapName": "/Game/PaperMan/Maps/Scenario/Chapter3/Scenario_Chapter3",
        "LevelStreamList": [
          "JQ_Envi_Central",
          "JQ_Envi_Central_Base",
          "JQ_Envi_Centra_FX",
          "JQ_Envi_Central_Lighting",
          "JQ_Envi_Central_Low",
          "JQ_Envi_Central_Middle",
          "JQ_Envi_Central_Reflection_Pc",
          "JQ_Envi_Central_Rendering"
        ],
        "NameText": {
          "Namespace": "SequenceMap",
          "Key": "97002_NameText",
          "SourceString": "提纯中心",
          "LocalizedString": "精製センター"
        },
        "Desc": {
          "Namespace": "SequenceMap",
          "Key": "97002_Desc",
          "SourceString": "巴布洛晶体由两部分组成，一部分是晶体本体，一部分是掺杂在其中的虚质。对于卡丘人来说，虚质是一种无用的物质，因此需要通过提纯的手段将其剔除。",
          "LocalizedString": "パブロクリスタルはクリスタルそのものと内部の仮想物質というふたつの要素から成っている。仮想物質のままでは超弦体の役には立たないため、クリスタルを使用するには純化する必要がある。"
        }
      },
      "97003": {
