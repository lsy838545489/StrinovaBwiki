        "NameText": {
          "Namespace": "SequenceMap",
          "Key": "97003_NameText",
          "SourceString": "88区",
          "LocalizedString": "88区"
        },
        "Desc": {
          "Namespace": "SequenceMap",
          "Key": "97003_Desc",
          "SourceString": "88区是纽特朗最早建立成型的街道之一，在这里可以找到很多古早风格的建筑物，也是城市的交通要道和主要商业街之一。",
          "LocalizedString": "88区はニュートロンヴィルで初めて設立された区画のひとつだ。この世界で最も古い建物がいくつも存在し、今でも商業の中心地として賑わっている。"
        }
      },
