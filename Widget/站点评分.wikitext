		<label class="rating-row">
			<input type="checkbox" value="4分" class="hidden-checkbox" />
			<div class="rating-row-inner">
				<div class="rating-left">
					<span class="rating-tag">4分</span>
					<span class="rating-stars">⭐⭐⭐⭐</span>
				</div>
				<span data-role="4分" class="poll-info-text">读取中...</span>
			</div>
		</label>

		<label class="rating-row">
			<input type="checkbox" value="3分" class="hidden-checkbox" />
			<div class="rating-row-inner">
				<div class="rating-left">
					<span class="rating-tag">3分</span>
					<span class="rating-stars">⭐⭐⭐</span>
				</div>
				<span data-role="3分" class="poll-info-text">读取中...</span>
			</div>
		</label>

		<label class="rating-row">
			<input type="checkbox" value="2分" class="hidden-checkbox" />
			<div class="rating-row-inner">
				<div class="rating-left">
					<span class="rating-tag">2分</span>
					<span class="rating-stars">⭐⭐</span>
				</div>
				<span data-role="2分" class="poll-info-text">读取中...</span>
			</div>
		</label>

		<label class="rating-row">
			<input type="checkbox" value="1分" class="hidden-checkbox" />
			<div class="rating-row-inner">
				<div class="rating-left">
					<span class="rating-tag">1分</span>
					<span class="rating-stars">⭐</span>
