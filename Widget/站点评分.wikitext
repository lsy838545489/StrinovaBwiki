<includeonly>
<div class="kqp-poll-container kqp-rating-widget-compact">
	<div class="poll-info" style="display: none">
名称：WIKI站点评分
限制票数：1
结束时间：2099/12/31 23:59:59
	</div>
	<div class="poll-easter-egg" style="display:none;">
感谢你为 WIKI 提出评分喵！✨
    </div>

	<!-- 极简头部：标题与人数左右对齐 -->
	<div class="rating-header-compact">
		<!-- <span class="rating-title-text">⭐ WIKI 站点评分</span> -->
		<span class="poll-title tittleVote">加载中...</span>
