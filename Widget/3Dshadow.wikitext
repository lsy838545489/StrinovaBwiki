<includeonly><!--{if !isset($wg3Dshadow) || !$wg3Dshadow}--><!--{assign var="wg3Dshadow" value=false scope="global"}--><style>
.gallery img {
	will-change: transform, filter;
}</style><script>"use strict";
window.RLQ = window.RLQ || [];
window.RLQ.push(() => {
	let mousePos = { x: 0, y: 0 };
	function faceToCursor() {
		document.querySelectorAll(".gallery img").forEach((ele) => {
			const distanceX =
				(ele.offsetLeft +
					ele.offsetWidth / 2 -
					window.pageXOffset -
					mousePos.x) *
				0.025;
			const distanceY =
				(ele.offsetTop +
					ele.offsetHeight / 2 +
					window.innerHeight / 2 -
					window.pageYOffset -
					mousePos.y) *
				0.025;
			ele.style.transform = `perspective(1000px) rotateX(${distanceY}deg) rotateY(${-distanceX}deg)`;
			ele.style.webkitFilter = `drop-shadow(rgba(0,0,20,.25) ${distanceX}px ${distanceY}px 2.5px)`;
		});
	}
	document.addEventListener("scroll", faceToCursor);
	document.addEventListener("mousemove", (e) => {
		mousePos = { x: e.clientX, y: e.clientY };
		faceToCursor(e);
	});
});
</script><!--{/if}--></includeonly><noinclude>{{Documentation}}</noinclude>