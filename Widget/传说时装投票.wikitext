            var script = document.createElement('script');
            script.src = scriptUrl;
            script.async = true;
            document.head.appendChild(script);
        } else {
            setTimeout(bootstrap, 50);
        }
    }
    window.RLQ = window.RLQ || [];
    window.RLQ.push(function() { bootstrap(); });
})();
