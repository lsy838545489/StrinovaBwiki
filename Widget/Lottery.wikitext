<includeonly><div class="Gacha">选择卡池：<select id="sl_upRole"></select><table id="table" border="1" width="100%" class="active"><tbody><tr><td class="Bigcontainer"></td></tr></tbody></table><div id="result"></div><div id="bt_again"><button id="bt_1again" type="button">单次复现</button><button id="bt_10again" type="button">十次复现</button></div></div><script>"use strict";
(() => {
	const poolData = JSON.parse(document.getElementById("poolData").innerText);

	let preloadNum = 10;
	let outdoorPool = [];
	let fourLeafClover = 0;
	let lastLegendary = Object.keys(poolData).reduce((obj, pool) => ({
		...obj,
		[pool]: "",
	}));

	let poolName = Object.keys(poolData)[0];
	let history = {
		showTimes: 0,
		items: [],
	};

	const IamFeelingLucky = (times = 1) => {
		const generateItem = (rarity, { name, cat, src }) => {
			const div = document.createElement("div");
			div.classList.add(`${rarity}Cell`, "Cellcontainer");
			div.innerHTML = `<div class="Cellcontainer_bg1 ${rarity}"></div><div class="Cellcontainer_bg2 ${rarity}"></div><div class="Cellcontainer_bg3 ${rarity}"></div><div class="text0 ${rarity}Name">${name}</div><div class="text2 ${rarity}Name">${cat}</div>`;
			div.appendChild(
				Object.assign(document.createElement("img"), {
					className: `image ${rarity}Img`,
					width: 50,
					src: `https://wiki.biligame.com/klbq/特殊:重定向/file/${src}`,
					decoding: "sync",
					loading: "eager",
					fetchPriority: "high",
				})
			);
			return div;
		};

		for (let i = 0; i < times; i++) {
			let rarity = (() => {
				const random = Math.random();
				if (random < 0.006) return "传说";
				if (random < 0.056) return "完美";
				if (random < 0.296) return "卓越";
				return "精致";
			})();
			if (rarity === "传说") fourLeafClover = 0;
			else if (fourLeafClover < 79) fourLeafClover++;
			else (rarity = "传说"), (fourLeafClover = 0);

			let itemParams;
			do
				itemParams =
					poolData[poolName][rarity][
						Math.floor(
							Math.random() * poolData[poolName][rarity].length
						)
					];
			while (
				rarity === "传说" &&
				lastLegendary[poolName] === itemParams.type
			);
			if (rarity === "传说") lastLegendary[poolName] = itemParams.type;

			history.items.push({
				rarity,
				name: itemParams.name,
				cat: itemParams.cat,
			});

			outdoorPool.push(generateItem(rarity, itemParams));
		}
	};

	const bigContainer =
		document.body.getElementsByClassName("Bigcontainer")[0];

	const amIlucky = (times = 1) => {
		const updateHistory = () =>
			(document.getElementById("result").innerHTML = `已抽取${
				history.showTimes
			}次，抽取结果：${history.items
				.slice(0, history.showTimes)
				.filter(({ rarity }) => rarity === "传说")
				.map(({ name, cat }) => `${cat}·${name}`)
				.join("，")}`);

		bigContainer.innerHTML = "";

		for (let i = 0; i < times; i++)
			bigContainer.appendChild(outdoorPool.shift());

		history.showTimes += times;
		updateHistory();
	};

	const poolSelector = document.getElementById("sl_upRole");
	for (const pool in poolData)
		poolSelector.innerHTML += `<option value="${pool}">${pool}</option>`;
	poolSelector.onchange = e => {
		lastLegendary = Object.keys(poolData).reduce((obj, pool) => ({
			...obj,
			[pool]: "",
		}));
		outdoorPool = [];
		poolName = e.target.value;
		history.items = history.items.slice(0, history.showTimes);
		IamFeelingLucky(preloadNum);
	};

	IamFeelingLucky(preloadNum);

	document.getElementById("bt_1again").onclick = () => {
		amIlucky();
		IamFeelingLucky();
	};
	document.getElementById("bt_10again").onclick = () => {
		amIlucky(10);
		IamFeelingLucky(10);
	};
})();</script></includeonly><noinclude>{{#tag:pre|{{:Data:Lotter.json}}|id=poolData|style="display:none;"}}{{#widget:Lottery}}{{#css:
