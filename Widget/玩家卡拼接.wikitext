</div><script>"use strict";
(() => {
    const canvas = document.createElement("canvas");
    canvas.width = 642;
    canvas.height = 1440;
    canvas.style.width = "330px";
    canvas.style.height = "720px";
    const ctx = canvas.getContext("2d");

    // 状态管理变量
    let currentHType = 'h';
    let hideH = false;
    const src = {
        j: "https://patchwiki.biligame.com/images/klbq/2/28/rr8grevmnwomvkoobmt3luhluj0rcr6.png",
        f: "https://patchwiki.biligame.com/images/klbq/7/7b/iuwrnudwao470636kde2xq7xkkeq9kq.png",
        pb: "https://patchwiki.biligame.com/images/klbq/1/1c/4rgakzyixd02jhrcq30tf9e9fqjgmcw.png",
        pd: "https://patchwiki.biligame.com/images/klbq/9/9a/d1xh5fbe14i65qhsd5gtzrfto8gyva0.png",
        pdi: "",
        pm: "https://patchwiki.biligame.com/images/klbq/9/90/9695z471s9iudyh69holzvg7qc31dko.png",
        n: "",
        l: "75",
        h: "https://patchwiki.biligame.com/images/klbq/0/03/0eenl0ql7zl9eg4knjgr6vwnng94zff.png",
        hnew: ""
    };

    const loadImg = (src) => new Promise((resolve, reject) => {
    if (!src) return resolve(null);
    const img = new Image();
    img.crossOrigin = "Anonymous";  // 设置跨域请求
    img.onload = () => resolve(img);
    img.onerror = reject;
    img.src = src;
});

    const update = async () => {
        try {
            const [j, f, pb, pd, pm, h, hnew] = await Promise.all([
                loadImg(src.j),
                loadImg(src.f),
                loadImg(src.pb),
                loadImg(src.pd),
                loadImg(src.pm),
                loadImg(hideH ? null : src.h),
                loadImg(hideH ? null : src.hnew)
            ]);

            ctx.clearRect(0, 0, canvas.width, canvas.height);
            
            // 绘制基板
            if (j) ctx.drawImage(j, 69, 68, 504, 1224);
            
            // 绘制封装
            if (f) ctx.drawImage(f, 11, 0, 620, 1400);
            
            // 绘制段位背景
            if (pb) ctx.drawImage(pb, 215.4, 16.44, 211.2, 109.12);
            
            // 绘制段位图标
            if (pd) ctx.drawImage(pd, 274.8, 28.8, 92.4, 92.4);
            
            // 修复文字位置
            ctx.save();
            ctx.font = "bold 22.12px sans-serif";
            ctx.fillStyle = "#FFF";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle"; // 修正基准线
            ctx.shadowColor = "#000";
            ctx.shadowBlur = 1;
            ["0 1", "1 0", "-1 0", "0 -1"].forEach(offset => {
                const [x, y] = offset.split(" ");
                ctx.shadowOffsetX = x;
                ctx.shadowOffsetY = y;
                ctx.fillText(src.pdi, 321, 73); // Y坐标调整
            });
            ctx.restore();

            // 玩家信息背景
            if (pm) ctx.drawImage(pm, 57, 130, 528, 128);
            
            // 玩家信息文字
            ctx.font = "36.4px sans-serif";
            ctx.fillStyle = "#FFF";
            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillText(src.n, 321, 175); // 调整Y坐标
            ctx.fillText(src.l, 321, 225); // 调整Y坐标

            // 核心/勋章
            if (!hideH) {
                if (currentHType === 'h' && h) {
                    ctx.drawImage(h, 159.72, 860.8, 322.56, 322.56);
                } else if (currentHType === 'hnew' && hnew) {
                    ctx.drawImage(hnew, 159.72, 860.8, 322.56, 322.56);
                }
            }
        } catch (error) {
            console.error("图片加载失败:", error);
        } finally {
            document.getElementById("download").disabled = false;
        }
    };

    document.querySelector(".card").appendChild(canvas);
  
  // 下载按钮事件监听
    document.getElementById("download").addEventListener("click", (e) => {
        const dataURL = canvas.toDataURL("image/png");

        if (!dataURL.startsWith("data:image/png")) {
            e.preventDefault();
            alert("请等待图片生成完成");
        } else {
            // 设置 download 按钮的 href 为生成的图片数据 URL
            e.target.href = dataURL;
            e.target.download = `玩家卡_${Date.now()}.png`;
        }
    });

    // 基板选择
    document.querySelectorAll('#menu-j img').forEach(img => {
        img.onclick = () => {
            src.j = img.dataset.image;
            update();
        };
    });

    // 封装选择（新增）
    document.querySelectorAll('#menu-f img').forEach(img => {
        img.onclick = () => {
            src.f = img.src.replace(/_icon(\d+)\.png$/, ".png");
            update();
        };
    });

    // 段位选择（新增）
    document.querySelectorAll('#menu-pd img').forEach(img => {
        img.onclick = () => {
            src.pd = img.src.replace(/_icon(\d+)\.png$/, ".png");
            update();
        };
    });

    // 核心/勋章选择
    ['h', 'hnew'].forEach(id => {
        document.querySelectorAll(`#menu-${id} img`).forEach(img => {
            img.onclick = () => {
                if (hideH) return;
                const newImage = img.src.replace(/_icon\d+\.png$/, ".png");
                
                if (id === 'h') {
                    src.h = newImage;
                    src.hnew = "";
                    currentHType = 'h';
                } else {
                    src.hnew = newImage;
                    src.h = "";
                    currentHType = 'hnew';
                }
                
                document.querySelectorAll('#menu-h, #menu-hnew')
                    .forEach(t => t.classList.remove('active'));
                document.querySelector(`#menu-${id}`).classList.add('active');
                update();
            };
        });
    });

    // 其他事件监听保持不变...
    document.getElementById('hideH').addEventListener('change', e => {
        hideH = e.target.checked;
        document.querySelectorAll('#menu-h, #menu-hnew')
            .forEach(t => t.classList.toggle('disabled', hideH));
        update();
    });

    document.getElementById('pdi').addEventListener('input', e => {
        src.pdi = e.target.value;
        update();
    });

    document.getElementById('n').addEventListener('input', e => {
        src.n = e.target.value.substring(0, 8);
        update();
    });

    document.getElementById('l').addEventListener('input', e => {
        src.l = Math.min(500, Math.max(0, e.target.value || 0));
        src.pm = `/klbq/特殊:重定向/file/拼接_名称背景_${Math.floor(src.l / 25) * 25 || 1}.png`;
        update();
    });

    update();
})();
</script>
