<script>
	//↓↓↓批量创建↓↓↓
	BCBTMeta = {
		"template": "",
		"key": [],
		"page": {},
		"state": "ready",
		"titles": [],
		"index": 0
	}
	function create() {
		$("#BEProgress").show();
		let title = BCBTMeta.titles[BCBTMeta.index++]
		if (!title) {
			alert("已完成全部任务！");
			$("#BEProgress").hide();
			return false;
		}
		let text = "{" + "{" + BCBTMeta.template
		for (let i = 0, ilen = BCBTMeta.key.length; i < ilen; i++) {
			text += "\n|" + (BCBTMeta.key[i] ? BCBTMeta.key[i] + "=" : "") + BCBTMeta.page[title][i]
		}
		text += "\n}}"
		new mw.Api().postWithToken('csrf', {
			action: 'edit',
			title: title,
			text: text,
			createonly: $("#FillMode").text() === "跳过" ? true : false,
			summary: '批量创建/编辑'
		}).then(function (json) {
