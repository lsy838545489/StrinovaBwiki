	function editPage() {
		$("#BEProgress").show();
		let completedCount = 0;

		titleArray.forEach((title, index) => {
			setTimeout(async () => {
				// 更新进度条
				let ProcessValue = Math.floor((index + 1) / titleArray.length * 100);
				setProgress(ProcessValue);

				var isPrepend = $("#isPrepend").prop("checked");
				try {
					await new mw.Api().edit(
						title,
						function (revision) {
							var text = revision.content,
								hasCategory = text.indexOf(category) !== -1,
								summary = "批量编辑";
							if (editMode === "add" && hasCategory) {
								console.log(index, title, "已有该分类，未操作");
								if (category === "") {
									$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchEmpty");
									mw.notify("[" + title + "]无插入内容，空编辑！", { type: 'warn', tag: 'editEmpty' });
									$.get(mw.config.get("wgCookiePath") + title);
								} else {
									$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchEmpty");
									mw.notify("[" + title + "]已有该分类，未操作！", { type: 'warn', autoHide: false });
									$.get(mw.config.get("wgCookiePath") + title);
								}
								return text;
							}

							if (editMode === "add") {
								let InsertMode = $("#InsertMode").text();
								let isPrepend = (InsertMode === "页面内容之前") ? text = category + "\n" + text : text += "\n" + category;
								let AddCustomSummary = $("#AddCustomSummary").val();
								summary = AddCustomSummary || "批量添加";
								$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchSuccess");
								mw.notify("[" + title + "]已添加！", { type: 'success', tag: 'editSuccess' });
								$.get(mw.config.get("wgCookiePath") + title);
							}
							if (editMode === "replace") {
								let Oldwikitext = $("#Oldwikitext").val();
								let Newwikitext = $("#Newwikitext").val();
								if ($("#EditWikitextMode").text() === "正则") {
									let regex = new RegExp(Oldwikitext, 'g');
									let newText = text.replace(regex, Newwikitext);
									if (newText !== text) {
										text = newText;
										$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchSuccess");
										mw.notify("[" + title + "]已替换！", { type: 'success', tag: 'editSuccess' });
										$.get(mw.config.get("wgCookiePath") + title);
									} else {
										$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchEmpty");
										mw.notify("[" + title + "]无匹配！", { type: 'warn', tag: 'editError' });
										$.get(mw.config.get("wgCookiePath") + title);
									}
									text = newText;
									let EditCustomSummary = $("#EditCustomSummary").val();
									summary = EditCustomSummary || "批量正则替换（" + Oldwikitext + "->" + Newwikitext + "）";
								} else {
									if (text.indexOf(Oldwikitext) === -1) {
										$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchEmpty");
										mw.notify("[" + title + "]无匹配！", { type: 'warn', tag: 'editError' });
										$.get(mw.config.get("wgCookiePath") + title);
									} else {
										$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchSuccess");
										mw.notify("[" + title + "]已替换！", { type: 'success', tag: 'editSuccess' });
										$.get(mw.config.get("wgCookiePath") + title);
									}
									text = text.split(Oldwikitext).join(Newwikitext);
									let EditCustomSummary = $("#EditCustomSummary").val();
									summary = EditCustomSummary || "批量替换（" + Oldwikitext + "->" + Newwikitext + "）";
								}
							} else if (editMode === "remove") {
								text = text.replace(category, "")
								summary = "批量删除分类";
								$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchSuccess");
								mw.notify("[" + title + "]已删除！", { type: 'success', tag: 'editSuccess' });
								$.get(mw.config.get("wgCookiePath") + title);
							}
							return {
								text: text,
								summary: summary,
								minor: true
							};
						}
					);
				} catch (e) {
					console.log(index, title, "操作失败");
					$('#BEdisplay pre[data-title="' + title + '"]').addClass("BatchError");
					mw.notify("[" + title + "]处理失败", { type: 'error', autoHide: false });
				}

				// 计数完成的任务
				completedCount++;

				// 当所有任务完成时
				if (completedCount === titleArray.length) {
					lock = false;
					$("#BEProgress").hide();
					alert("处理完毕");
				}
			}, index * 1000);
		});
	}
