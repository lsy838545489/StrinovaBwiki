	function movePage() {
		$("#BEProgress").show();
		let MoveModetext = $("#MoveModetext").val();
		let FixMode = $("#FixMode").text();
		let MoveMode = $("#MoveMode").text();
		let pages = CPMeta.page;
		pages.forEach((page, index) => {
			setTimeout(() => {
				let NewAddtitle = (FixMode === "前缀") ? MoveModetext + page : page + MoveModetext;
				let NewDelPretitle = (page.startsWith(MoveModetext)) ? page.slice(MoveModetext.length) : page;
				let NewDelSuftitle = (page.endsWith(MoveModetext)) ? page.slice(0, -MoveModetext.length) : page;
				let NewDeltitle = (FixMode === "前缀") ? NewDelPretitle : NewDelSuftitle;
				let Newtitle = (MoveMode === "添加") ? NewAddtitle : NewDeltitle;
				new mw.Api()
					.postWithToken("csrf", {
						action: "move",
						from: page,
						to: Newtitle,
						reason: "批量移动",
						format: "json",
						noredirect: $(".isRedirect input").is(":checked")
					}).then(
						function (json) {
							let ProcessValue = Math.floor((index + 1) / pages.length * 100);
							setProgress(ProcessValue);
							if (json.move) {
								document.querySelector('#BEdisplay pre[data-title="' + page + '"]').classList.add("BatchSuccess");
								mw.notify("[" + page + "]已移动到[" + Newtitle + "]！", { type: 'success', tag: 'moveSuccess' });
								$.get(mw.config.get("wgCookiePath") + Newtitle);
							}
						}
					).catch(function (e) {
						if (e == "articleexists") {
							document.querySelector('#BEdisplay pre[data-title="' + page + '"]').classList.add("BatchError");
							mw.notify("[" + Newtitle + "]已存在！", { type: 'warn', autoHide: false });
						}
						if (e === "selfmove") {
							document.querySelector('#BEdisplay pre[data-title="' + page + '"]').classList.add("BatchError");
							mw.notify("[" + page + "]未移动！", { type: 'error', autoHide: false });
						}
						if (e === "missingtitle") {
							document.querySelector('#BEdisplay pre[data-title="' + page + '"]').classList.add("BatchError");
							mw.notify("[" + page + "]未找到！", { type: 'error', autoHide: false });
						}
					});
			}, index * 500);
		});
	}
