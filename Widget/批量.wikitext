			$(".CategoryMode").on('click', function () {
				$("#AskMode").text($(this).text());
				$("#AskParam").attr("placeholder", "请直接填入要处理的分类名称后查询");
			});
			$(".ParamMode").on('click', function () {
				$("#AskMode").text($(this).text());
				$("#AskParam").attr("placeholder", "请填入要查询的ASK参数后查询");
			});
			$(".BeforeMode,.AfterMode").on('click', function () {
				$("#InsertMode").text($(this).text());
			});
			$(".NormalMode,.RegularMode").on('click', function () {
				$("#EditWikitextMode").text($(this).text());
			});
			$(".PrefixMode,.SuffixMode").on('click', function () {
				$("#FixMode").text($(this).text());
			});
			$(".MoveAddMode,.MoveDelMode").on('click', function () {
				$("#MoveMode").text($(this).text());
			});
			$("#gotoCustomMove").on('click', function () {
				$("#RuleMoveBOX").hide();
				$("#CustomMoveBOX").show();
				$("#todoTitles").val('');
				$("#PageNum").text(0);
				moveData = [];
				$("#BEdisplay").empty();
				$("#todoTitles").attr("placeholder", "请从excel中复制，粘贴到此处。左侧列为原标题，右侧列为新标题。");
			});
			$("#gotoRuleMove").on('click', function () {
				$("#CustomMoveBOX").hide();
				$("#RuleMoveBOX").show();
				$("#todoTitles").val('');
				$("#PageNum").text(0);
				moveData = [];
				$("#BEdisplay").empty();
				$("#todoTitles").attr("placeholder", "默认为“|”（管道符）分隔");
			});
			$("#getCustomMoveData").on('click', function () {
				getCustomMoveData();
			});
			$("#CustomMoveBTN").on('click', function () {
				if (confirm("真的确认了吗")) {
					movePageCustom();
				}
			});
			//批量填充
			if (mw.config.get('wgUserGroups').indexOf("sysop") == -1) {
				document.getElementById("BatchCreateByTemplate").innerHTML = "你无权使用这个功能。"
				document.getElementById("BatchCreateByTemplate").style.cssText = `font-size: large;font-weight: bold;`;
				return
			}
			document.getElementById("BCBTexcel").oninput = function () {
				let value = this.value;
				value = value.replace(/""/g, "&&quot;").replace(/"([^"]+)"/g, function (match, group1) { return group1.replace(/\n/g, '\r'); });
				let row = value.split("\n")
				let title = row[0].split("\t")
				title = title.map(function (e) { return e.trim() })
				BCBTMeta.template = title[0]
				BCBTMeta.key = []
				BCBTMeta.page = {}
				for (let i = 1, ilen = title.length; i < ilen; i++) {
					BCBTMeta.key.push(title[i])
				}
				for (let i = 1, ilen = row.length; i < ilen; i++) {
					let cell = row[i].split("\t")
					cell = cell.map(function (e) { return e.trim().replace(/&&quot;/g, '"').replace(/\r/g, '\n'); })
					if (cell[0]) {
						BCBTMeta.page[cell[0]] = []
						for (let j = 1, jlen = title.length; j < jlen; j++) {
							BCBTMeta.page[cell[0]].push(cell[j] || "")
						}
					}
				}
				let BCBTdisplay = document.getElementById("BCBTdisplay")
				BCBTdisplay.innerHTML = "";
				for (let key in BCBTMeta.page) {
					let text = "[[<a href=" + mw.config.values.wgScriptPath + "/" + encodeURIComponent(key) + " title=" + key + " target=_blank>" + key + "</a>]]"
					text += "\n\n{{" + (BCBTMeta.template ? "<a href=" + mw.config.values.wgScriptPath + "/" + encodeURIComponent("模板:" + BCBTMeta.template) + " title=" + "模板:" + BCBTMeta.template + "  target=_blank>" + BCBTMeta.template + "</a>" : "<span style='color:red'>请确认模板</span>")
					for (let i = 0, ilen = BCBTMeta.key.length; i < ilen; i++) {
						text += "\n|" + (BCBTMeta.key[i] ? BCBTMeta.key[i] + "=" : "") + BCBTMeta.page[key][i]
					}
					text += "\n}}"
					let pre = document.createElement("pre")
					pre.classList.add("col-md-3")
					pre.dataset.title = key
					pre.innerHTML = text
					BCBTdisplay.appendChild(pre)
				}
			}
			document.getElementById("BCBTsubmit").onclick = function () {
				if (BCBTMeta.state == "ready" && confirm("真的确认了吗？")) {
					document.getElementById("BCBTexcel").readOnly = true
					BCBTMeta.state = "busy";
					BCBTMeta.titles = Object.keys(BCBTMeta.page)
					create();
				}
			}
			//查询版本：先取“您的版本”(当前页修订时间) → 再取 tools 页“最新版本”并比较
			new mw.Api().get({
			action: 'query',
			prop: 'revisions',
			titles: mw.config.get('wgPageName'),
			rvprop: 'timestamp',
			formatversion: 2
			}).done(function (data) {
			try {
				var pg  = data.query.pages[0];
				var ts  = pg.revisions[0].timestamp;          // ISO UTC
				var ymd = new Date(ts).toISOString().split('T')[0];
				$('#YourVer').text(ymd);
			} catch (e) {
				console.error('获取 YourVer 失败', e);
			}

			// 再取“最新版本”并比较
			$.getJSON("//wiki.biligame.com/tools/api.php?action=query&prop=revisions&pageids=2730&rvprop=timestamp&format=json", function (data2) {
			if (data2.query && data2.query.pages) {
				var page      = Object.values(data2.query.pages)[0];
				var timestamp = page.revisions[0].timestamp;
				var dateStr   = new Date(timestamp).toISOString().split('T')[0]; // 只取 Y-m-d
				$("#LastVer").text(dateStr);

				// 兼容：如果您的版本比远端旧 → 显示“New”
				var yourDateStr = $("#YourVer").text();
				if (yourDateStr && dateStr) {
				var yourDate = new Date(yourDateStr);
				var lastDate = new Date(dateStr);
				if (yourDate < lastDate) {
					$("#CheckVer").append(' <sup><span class="label label-danger">New</span></sup>');
				}
				}
			} else {
				console.error("获取最后更新日期失败");
			}
			});
			}).fail(function (e) {
			console.error('YourVer API 调用失败', e);
			});
			//查询页面		
			$("#AskSubmit").on("click", function () {
				askTitles();
			})
			//批量刷新
			$("#PagePurge").on("click", function () {
				purgePage();
			})
			//批量删除
			if (mw.config.get('wgUserGroups').indexOf("sysop") == -1) {
				$("#BatchDeleteByTemplate").html("你无权使用这个功能。");
				$("#BatchDeleteByTemplate").css("font-size", "large").css("font-weight", "bold");
				return
			}
			$("#Separator").on('input', function () {
				updateBEdisplay($("#todoTitles").val().replace(/[\n\r]+/g, ''));
			});
			$("#todoTitles").on('input', function () {
				updateBEdisplay($(this).val().replace(/[\n\r]+/g, ''));
			});
			//批量移动
			$("#RuleMoveBTN").click(function () {
				if (CPMeta.state == "ready" && confirm("真的确认了吗？")) {
					$("#todoTitles").prop("readOnly", true);
					CPMeta.state = "busy";
					movePage();
				}
			});
			$("#PageDelete").click(function () {
				if (CPMeta.state == "ready" && confirm("真的确认了吗？")) {
					$("#todoTitles").prop("readOnly", true);
					CPMeta.state = "busy";
					deletePage();
				}
			});
			//ZipFILL
			zipFillData = {
				zipData: [],
				fileIndex: 0,
			};
			change = function (idName) {
				let upload = document.getElementById(idName);
				var file = upload.files[0];
				JSZip.loadAsync(file)
					.then(function (zip) {
						var fileBox = [];
						zip.forEach(function (relativePath, zipEntry) {
							fileBox.push(
								zipEntry.async("string").then(function (content) {
									return { name: zipEntry.name, content: content };
								})
							);
						});
						return Promise.all(fileBox);
					})
					.then(function (files) {
						// 在页面上显示每个文件的内容
						zipFillData.zipData = files;
						console.log(zipFillData.zipData);
						$.each(zipFillData.zipData, function (index, item) {
							let text = "[[<a href=" + mw.config.values.wgScriptPath + "/" + encodeURIComponent(item.name) + " title=" + item.name + " target=_blank>" + item.name + "</a>]]";
							// let text = item.name;
							text += `\n\n${item.content}`;
							let pre = document.createElement("pre");
							pre.classList.add("col-md-3");
							pre.dataset.title = item.name;
							pre.innerHTML = text;
							BZdisplay.appendChild(pre);
						});
					})
					.catch(function (error) {
						console.log("读取ZIP文件时出错:", error);
					});
			};
			createByZip = function () {
				if (!zipFillData.zipData[zipFillData.fileIndex]) {
					return false;
				}
				var title = zipFillData.zipData[zipFillData.fileIndex].name;
				var text = zipFillData.zipData[zipFillData.fileIndex++].content;
				new mw.Api()
					.postWithToken("csrf", {
						action: "edit",
						title: title,
						text: text,
						summary: "读取zip生成的批量编辑",
					})
					.then(function (json) {
						console.log(`创建成功${title}`);
						document.querySelector('#BZdisplay pre[data-title="' + title + '"]').classList.add("BatchSuccess");
						$("#BEProgress").show();
						mw.notify("[" + title + "]已填充！", { type: 'success' })
						let ProcessValue = Math.floor(zipFillData.fileIndex / zipFillData.zipData.length * 100);
						setProgress(ProcessValue);
						if (zipFillData.fileIndex >= zipFillData.zipData.length) {
							$("#BEProgress").hide();
							console.log("全部结束");
						} else {
							return setTimeout(createByZip, 500);
						}
					})
					.catch(function (e) {
						console.log(e);
						document.querySelector('#BZdisplay pre[data-title="' + title + '"]').classList.add("BatchError");
						if (zipFillData.fileIndex >= zipFillData.zipData.length) {
							$("#BEProgress").hide();
							console.log("全部结束");
						} else {
							return setTimeout(createByZip, 500);
						}
					});
			};
			$("#BZsubmit").on("click", function () {
				if (confirm("真的确认了吗")) {
					createByZip();
				}
			});
			$("#replaceBTN").on("click", function () {
				if (confirm("高危操作，真的确认了吗？")) {
					editWikitext('replace');
				}
			});

			$(".filter-btn").on("click", function () {
				let filter = $(this).data("filter");
				let target = $(this).data("target") || "BE";
				filterByClass(filter, target);
			});

			$("#BECopyError").on("click", function () {
				let target = $(this).data("target") || "BE";
				copyTitlesByClass(target, "BatchError");
			});

			$("#BECopyEmpty").on("click", function () {
				let target = $(this).data("target") || "BE";
				copyTitlesByClass(target, "BatchEmpty");
			});

			$("#BCBTCopyError").on("click", function () {
				let target = $(this).data("target") || "BCBT";
				copyTitlesByClass(target, "BatchError");
			});

			$("#BCBTCopyEmpty").on("click", function () {
				let target = $(this).data("target") || "BCBT";
				copyTitlesByClass(target, "BatchEmpty");
			});

			$("#BZCopyError").on("click", function () {
				let target = $(this).data("target") || "BZ";
				copyTitlesByClass(target, "BatchError");
			});

			let BEObserver = new MutationObserver(function (mutations) {
				updateFilterCount("BE");
			});
			BEObserver.observe(document.getElementById('BEdisplay'), {
				childList: true,
				attributes: true,
				attributeFilter: ['class'],
				subtree: true
			});

			let BCBTObserver = new MutationObserver(function (mutations) {
				updateFilterCount("BCBT");
			});
			BCBTObserver.observe(document.getElementById('BCBTdisplay'), {
				childList: true,
				attributes: true,
				attributeFilter: ['class'],
				subtree: true
			});

			let BZObserver = new MutationObserver(function (mutations) {
				updateFilterCount("BZ");
			});
			BZObserver.observe(document.getElementById('BZdisplay'), {
				childList: true,
				attributes: true,
				attributeFilter: ['class'],
				subtree: true
			});
		})
	}])
</script>
</includeonly><noinclude>{{#Widget:批量}}</noinclude>