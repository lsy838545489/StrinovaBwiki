	function updateFilterCount(target) {
		let displayId = `#${target}display`;
		let countId = `#${target}FilterCount`;
		let total = $(`${displayId} pre`).length;
		let success = $(`${displayId} pre.BatchSuccess`).length;
		let error = $(`${displayId} pre.BatchError`).length;
		let empty = $(`${displayId} pre.BatchEmpty`).length;
		if (target === "BZ") {
			$(countId).text(`共 ${total} 条 (成功: ${success}, 失败: ${error})`);
		} else {
			$(countId).text(`共 ${total} 条 (成功: ${success}, 失败: ${error}, 错误: ${empty})`);
		}
	}

	function filterByClass(filter, target) {
		$(`.filter-btn[data-target="${target}"]`).removeClass("filter-active");
		$(`.filter-btn[data-target="${target}"][data-filter="${filter}"]`).addClass("filter-active");
		
		let displayId = `#${target}display`;
		
		if (filter === "all") {
			$(displayId + " pre").show();
		} else if (filter === "success") {
			$(displayId + " pre").hide();
			$(displayId + " pre.BatchSuccess").show();
		} else if (filter === "error") {
			$(displayId + " pre").hide();
			$(displayId + " pre.BatchError").show();
		} else if (filter === "empty") {
			$(displayId + " pre").hide();
			$(displayId + " pre.BatchEmpty").show();
		}
	}

	function copyTitlesByClass(target, className) {
		let displayId = `#${target}display`;
		let separator = $("#Separator").val() || "|";
		let titles = [];
		
		$(displayId + ` pre.${className}`).each(function() {
			let title = $(this).data("title");
			if (title) {
				titles.push(title);
			}
		});
		
		if (titles.length === 0) {
			mw.notify("没有可复制的标题！", { type: 'warn' });
			return;
		}
		
		let text = titles.join(separator);
		
		navigator.clipboard.writeText(text).then(function() {
			mw.notify(`已复制 ${titles.length} 个标题到剪贴板！`, { type: 'success' });
		}).catch(function(err) {
			console.error('复制失败:', err);
			mw.notify("复制失败，请手动复制", { type: 'error' });
		});
	}
