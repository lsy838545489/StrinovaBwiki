<includeonly>
<style>
/* 1. 基础容器与舞台背景 */
.kanami-player-widget {
  width: 100%;
  height: 80vh;
  background: linear-gradient(135deg, #494156 0%, #2A2533 100%);
  border-radius: 16px;
  box-shadow: 0 8px 24px rgba(73, 65, 86, 0.3);
  padding: 20px;
  color: #BAC2CD;
  box-sizing: border-box;
  border: 1px solid #EAC1D3;
  margin: 10px 0;
  
  display: flex;
  flex-direction: column;
  position: relative;
  overflow: hidden; /* 防止聚光灯光束溢出卡片 */
}

/* 2. Live 舞台聚光灯效果 (Stage Lights) */
.kanami-stage-light {
  position: absolute;
  top: -50%;
  width: 200%;
  height: 200%;
  pointer-events: none;
  z-index: 1;
  opacity: 0; /* 默认（暂停时）隐藏灯光 */
  transition: opacity 0.8s ease;
  mix-blend-mode: screen;
}

/* 左侧聚光灯 */
.kanami-stage-light.light-left {
  left: -50%;
  background: conic-gradient(
    from 140deg at 30% 0%, 
    transparent 0deg, 
    rgba(234, 193, 211, 0.25) 15deg, 
    rgba(211, 101, 138, 0.15) 30deg, 
    transparent 45deg
  );
}

/* 右侧聚光灯 */
.kanami-stage-light.light-right {
  right: -50%;
  background: conic-gradient(
    from 170deg at 70% 0%, 
    transparent 0deg, 
    rgba(250, 205, 186, 0.25) 15deg, 
    rgba(234, 193, 211, 0.15) 30deg, 
    transparent 45deg
  );
}

/* 当播放器处于 .playing 状态时激活舞台灯光与摇摆动画 */
.kanami-player-widget.playing .kanami-stage-light {
  opacity: 1;
}

.kanami-player-widget.playing .light-left {
  animation: stageSweepLeft 6s infinite ease-in-out alternate;
}

.kanami-player-widget.playing .light-right {
  animation: stageSweepRight 7s infinite ease-in-out alternate;
}

/* 舞台聚光灯摆动动画帧 */
@keyframes stageSweepLeft {
  0% { transform: rotate(-8deg) scale(0.9); }
  50% { transform: rotate(12deg) scale(1.1); }
  100% { transform: rotate(-3deg) scale(1.0); }
}

@keyframes stageSweepRight {
  0% { transform: rotate(6deg) scale(1.0); }
  50% { transform: rotate(-14deg) scale(1.15); }
  100% { transform: rotate(4deg) scale(0.95); }
}

/* 3. 播放器内部组件提升 z-index，保证在灯光上方 */
.kanami-info, 
.kanami-lrc-container, 
.kanami-progress-container, 
.kanami-controls, 
.kanami-playlist {
  position: relative;
  z-index: 2;
}

/* 歌曲信息区（仅保留标题） */
.kanami-player-widget .kanami-info {
  text-align: center;
  margin-bottom: 10px;
  flex-shrink: 0;
}
.kanami-player-widget .kanami-title {
  font-size: 1.5rem;
  font-weight: bold;
  color: #FACDBA;
  margin: 0;
  text-shadow: 0 0 10px rgba(250, 205, 186, 0.3);
}

/* 歌词区 */
.kanami-player-widget .kanami-lrc-container {
  flex: 1;
  min-height: 120px;
  overflow: hidden;
  position: relative;
  margin: 10px 0;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 12px;
  border: 1px solid rgba(234, 193, 211, 0.2);
  mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
  -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
}

.kanami-player-widget .kanami-lrc-wrapper {
  position: absolute;
  width: 100%;
  top: 50%;
  margin-top: -13px;
  transition: transform 0.3s ease-out;
  text-align: center;
}

.kanami-player-widget .kanami-lrc-line {
  font-size: 1rem;
  line-height: 30px;
  color: #BAC2CD;
  opacity: 0.5;
  transition: all 0.3s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  padding: 0 10px;
}

.kanami-player-widget .kanami-lrc-line.active {
  color: #FACDBA;
  opacity: 1;
  font-size: 1.25rem;
  font-weight: bold;
  text-shadow: 0 0 10px rgba(211, 101, 138, 0.8);
}

/* 进度条 */
.kanami-player-widget .kanami-progress-container {
  display: flex;
  align-items: center;
  gap: 10px;
  font-size: 0.75rem;
  margin-bottom: 10px;
  flex-shrink: 0;
}

.kanami-player-widget .kanami-progress-bar {
  flex: 1;
  height: 6px;
  background: rgba(186, 194, 205, 0.3);
  border-radius: 3px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.kanami-player-widget .kanami-progress-fill {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #EAC1D3, #D3658A);
  border-radius: 3px;
  transition: width 0.1s linear;
}

/* 控制按钮与音量区 */
.kanami-player-widget .kanami-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  flex-shrink: 0;
}

.kanami-player-widget .kanami-btn-play {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: linear-gradient(135deg, #D3658A, #EAC1D3);
  border: none;
  color: #494156;
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4px 10px rgba(211, 101, 138, 0.4);
  transition: transform 0.2s, background 0.2s;
}

.kanami-player-widget .kanami-btn-play:hover {
  transform: scale(1.05);
  background: linear-gradient(135deg, #FACDBA, #D3658A);
}

.kanami-player-widget .kanami-volume-container {
  display: flex;
  align-items: center;
  gap: 8px;
}

.kanami-player-widget .kanami-volume-slider {
  -webkit-appearance: none;
  width: 70px;
  height: 4px;
  background: #BAC2CD;
  border-radius: 2px;
  outline: none;
}

.kanami-player-widget .kanami-volume-slider::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #D3658A;
  cursor: pointer;
}

/* 曲目列表 UI（移除歌手，仅展示歌曲序号和标题） */
.kanami-player-widget .kanami-playlist {
  border-top: 1px dashed rgba(234, 193, 211, 0.3);
  padding-top: 8px;
  max-height: 30%;
  overflow-y: auto;
  flex-shrink: 0;
}

.kanami-player-widget .kanami-playlist-title {
  font-size: 0.75rem;
  color: #EAC1D3;
  margin-bottom: 6px;
  opacity: 0.8;
}

.kanami-player-widget .kanami-track-item {
  display: block;
  padding: 6px 10px;
  font-size: 0.75rem;
  border-radius: 6px;
  cursor: pointer;
  margin-bottom: 4px;
  background: rgba(0, 0, 0, 0.15);
  transition: all 0.2s;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.kanami-player-widget .kanami-track-item:hover {
  background: rgba(234, 193, 211, 0.15);
  color: #FACDBA;
}

.kanami-player-widget .kanami-track-item.active {
  background: rgba(211, 101, 138, 0.25);
  border: 1px solid #D3658A;
  color: #FACDBA;
  font-weight: bold;
}

/* PC / 桌面双栏响应式布局 */
@media (min-width: 768px) {
  .kanami-player-widget {
    display: grid;
    grid-template-columns: 1fr 280px;
    grid-template-rows: auto 1fr auto auto;
    gap: 0 20px;
  }

  .kanami-player-widget .kanami-info {
    grid-column: 1 / 3;
    grid-row: 1;
  }

  .kanami-player-widget .kanami-lrc-container {
    grid-column: 1 / 2;
    grid-row: 2;
    height: 100%;
    margin: 0;
  }

  .kanami-player-widget .kanami-playlist {
    grid-column: 2 / 3;
    grid-row: 2;
    max-height: 100%;
    border-top: none;
    border-left: 1px dashed rgba(234, 193, 211, 0.3);
    padding-top: 0;
    padding-left: 15px;
  }

  .kanami-player-widget .kanami-progress-container {
    grid-column: 1 / 3;
    grid-row: 3;
    margin-top: 15px;
    margin-bottom: 10px;
  }

  .kanami-player-widget .kanami-controls {
    grid-column: 1 / 3;
    grid-row: 4;
    margin-bottom: 0;
  }
}
</style>

<div class="kanami-player-widget">
  <div class="kanami-stage-light light-left"></div>
  <div class="kanami-stage-light light-right"></div>

  <div class="kanami-info">
    <p class="kanami-title"></p>
  </div>
  
  <div class="kanami-lrc-container">
    <div class="kanami-lrc-wrapper"></div>
  </div>
  
  <div class="kanami-progress-container">
    <span class="currentTime">00:00</span>
    <div class="kanami-progress-bar">
      <div class="kanami-progress-fill"></div>
    </div>
    <span class="totalTime">00:00</span>
  </div>
  
  <div class="kanami-controls">
    <button class="kanami-btn-play">▶</button>
    <div class="kanami-volume-container">
      <span>♫</span>
      <input type="range" class="kanami-volume-slider" min="0" max="1" step="0.01" value="0.8">
    </div>
  </div>

  <div class="kanami-playlist">
    <div class="kanami-playlist-title">🎵 播放列表</div>
    <div class="kanami-track-list"></div>
  </div>
</div>

<script>
(function() {
  // 1. 曲目列表配置（可根据需要增删曲目）
  const playlist = [
    {
      id: "song_1",
      title: "Cuter me",
      fileName: "文件:Bgm-Cuter_me.mp3",
      lrcPage: "Widget:KanamiPlayer/Cuter me"
    },
    {
      id: "song_2",
      title: "Cuter me(日文版)",
      fileName: "文件:Bgm-Cuter_me_(日文版).mp3",
      lrcPage: "Widget:KanamiPlayer/Cuter me(日文版)"
    },
    {
      id: "song_3",
      title: "Be Shining",
      fileName: "文件:Bgm-Be_Shining.mp3",
      lrcPage: "Widget:KanamiPlayer/Be Shining"
    },
    {
      id: "song_4",
      title: "你看 世界好美",
      fileName: "文件:Bgm-香奈美角色曲《你看_世界好美》.mp3",
      lrcPage: "Widget:KanamiPlayer/你看 世界好美"
    },
    {
      id: "song_5",
      title: "你看 世界好美(日文版)",
      fileName: "文件:Bgm-香奈美角色曲《你看_世界好美》日语版.mp3",
      lrcPage: "Widget:KanamiPlayer/你看 世界好美(日文版)"
    }
  ];

  const STORAGE_KEY_VOLUME = 'kanami_player_volume';
  let currentIndex = 0;
  let audio = new Audio();
  let isLoading = false;
  let lyrics = [];
  let currentLrcIndex = -1;

  const container = document.currentScript.previousElementSibling;
  const titleEl = container.querySelector('.kanami-title');
  const playBtn = container.querySelector('.kanami-btn-play');
  const progressBar = container.querySelector('.kanami-progress-bar');
  const progressFill = container.querySelector('.kanami-progress-fill');
  const currentTimeEl = container.querySelector('.currentTime');
  const totalTimeEl = container.querySelector('.totalTime');
  const volumeSlider = container.querySelector('.kanami-volume-slider');
  const lrcWrapper = container.querySelector('.kanami-lrc-wrapper');
  const trackListEl = container.querySelector('.kanami-track-list');

  function getSavedVolume() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_VOLUME);
      if (saved !== null && !isNaN(saved)) {
        return Math.max(0, Math.min(1, parseFloat(saved)));
      }
    } catch (e) {}
    return 0.8;
  }

  const initVol = getSavedVolume();
  audio.volume = initVol;
  if (volumeSlider) volumeSlider.value = initVol;

  // 2. MW API 获取文件真实 URL
  function fetchFileUrl(fileName) {
    if (window.mw && mw.Api) {
      return new mw.Api().get({
        action: 'query',
        titles: fileName,
        prop: 'imageinfo',
        iiprop: 'url',
        redirects: 1,
        formatversion: 2
      }).then(data => {
        const pages = data.query.pages;
        if (pages && pages[0] && pages[0].imageinfo) {
          return pages[0].imageinfo[0].url;
        }
        throw new Error('未找到音频文件');
      });
    } else {
      const url = '/api.php?action=query&prop=imageinfo&iiprop=url&format=json&redirects=1&titles=' + encodeURIComponent(fileName);
      return fetch(url).then(r => r.json()).then(data => {
        const pages = data.query.pages;
        const pageId = Object.keys(pages)[0];
        if (pageId !== "-1" && pages[pageId].imageinfo) {
          return pages[pageId].imageinfo[0].url;
        }
        throw new Error('未找到音频文件');
      });
    }
  }

  // 3. MW API 抓取歌词子页面的文本内容
  function fetchLrcContent(pageName) {
    if (!pageName) return Promise.resolve('');
    
    if (window.mw && mw.Api) {
      return new mw.Api().get({
        action: 'parse',
        page: pageName,
        prop: 'wikitext',
        formatversion: 2
      }).then(data => {
        if (data && data.parse && data.parse.wikitext) {
          // 清理可能包含的 html/wiki 标签或 pre 保护框
          let text = data.parse.wikitext;
          return text.replace(/<\/?(pre|nowiki)>/gi, '').trim();
        }
        return '';
      }).catch(err => {
        console.warn('读取歌词子页面失败:', err);
        return '';
      });
    } else {
      const url = '/api.php?action=parse&prop=wikitext&format=json&page=' + encodeURIComponent(pageName);
      return fetch(url).then(r => r.json()).then(data => {
        if (data && data.parse && data.parse.wikitext) {
          return data.parse.wikitext['*'].replace(/<\/?(pre|nowiki)>/gi, '').trim();
        }
        return '';
      }).catch(() => '');
    }
  }

  function formatTime(seconds) {
    if (isNaN(seconds) || seconds < 0) return '00:00';
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
  }

  function parseLrc(text) {
    lyrics = [];
    currentLrcIndex = -1;
    lrcWrapper.style.transform = 'translateY(0px)';

    if (!text) {
      lrcWrapper.innerHTML = '<div class="kanami-lrc-line active">暂无歌词</div>';
      return;
    }
    const lines = text.split('\n');
    const timeReg = /\[(\d{2}):(\d{2})\.(\d{2,3})\]/;
    
    lines.forEach(line => {
      const match = timeReg.exec(line);
      if (match) {
        const minutes = parseInt(match[1]);
        const seconds = parseInt(match[2]);
        const ms = parseInt(match[3]);
        const time = minutes * 60 + seconds + (ms > 99 ? ms / 1000 : ms / 100);
        const lrcStr = line.replace(timeReg, '').trim();
        if (lrcStr) lyrics.push({ time, text: lrcStr });
      }
    });

    if (!lyrics.length) {
      lrcWrapper.innerHTML = '<div class="kanami-lrc-line active">暂无有效格式歌词</div>';
      return;
    }

    lrcWrapper.innerHTML = lyrics
      .map((item, index) => `<div class="kanami-lrc-line" data-index="${index}">${item.text}</div>`)
      .join('');
  }

  function updateLrc() {
    if (!lyrics.length) return;
    const curTime = audio.currentTime;
    let index = lyrics.findIndex((item, i) => {
      const nextItem = lyrics[i + 1];
      return curTime >= item.time && (!nextItem || curTime < nextItem.time);
    });

    if (index !== -1 && index !== currentLrcIndex) {
      currentLrcIndex = index;
      const lines = lrcWrapper.querySelectorAll('.kanami-lrc-line');
      lines.forEach(el => el.classList.remove('active'));
      if (lines[index]) {
        lines[index].classList.add('active');
        lrcWrapper.style.transform = `translateY(-${index * 26}px)`;
      }
    }
  }

  function renderUI() {
    const track = playlist[currentIndex];
    titleEl.textContent = track.title;
    
    // 如果已经获取并缓存过该曲目的歌词文本，直接解析
    if (track.lrcText !== undefined) {
      parseLrc(track.lrcText);
    } else {
      lrcWrapper.innerHTML = '<div class="kanami-lrc-line active">歌词加载中...</div>';
    }

    trackListEl.innerHTML = playlist.map((item, index) => `
      <div class="kanami-track-item ${index === currentIndex ? 'active' : ''}" data-index="${index}">
        ${index + 1}. ${item.title}
      </div>
    `).join('');

    trackListEl.querySelectorAll('.kanami-track-item').forEach(item => {
      item.addEventListener('click', () => {
        const idx = parseInt(item.getAttribute('data-index'));
        if (idx !== currentIndex) {
          switchTrack(idx);
        }
      });
    });
  }

  // 异步加载音频与歌词
  async function loadAndPlayCurrent() {
    const track = playlist[currentIndex];
    
    if (isLoading) return;
    isLoading = true;
    playBtn.textContent = '⏳';

    try {
      // 1. 并行发起“音频直链”和“歌词子页面”的 API 请求
      const fetchAudioPromise = track.realUrl ? Promise.resolve(track.realUrl) : fetchFileUrl(track.fileName);
      const fetchLrcPromise = track.lrcText !== undefined ? Promise.resolve(track.lrcText) : fetchLrcContent(track.lrcPage);

      const [realUrl, lrcText] = await Promise.all([fetchAudioPromise, fetchLrcPromise]);

      // 2. 写入缓存，下次无需再请求 API
      track.realUrl = realUrl;
      track.lrcText = lrcText;

      audio.src = realUrl;
      parseLrc(lrcText);

      // 3. 执行播放
      await audio.play();
      playBtn.textContent = '❚❚';
      container.classList.add('playing');
    } catch (err) {
      console.error('播放失败:', err);
      alert('加载失败，请检查音频或歌词子页面是否存在！');
      playBtn.textContent = '▶';
      container.classList.remove('playing');
    } finally {
      isLoading = false;
    }
  }

  function switchTrack(index) {
    audio.pause();
    container.classList.remove('playing');
    currentIndex = index;
    renderUI();
    loadAndPlayCurrent();
  }

  function togglePlay() {
    if (audio.paused) {
      loadAndPlayCurrent();
    } else {
      audio.pause();
      playBtn.textContent = '▶';
      container.classList.remove('playing');
    }
  }

  // 事件绑定
  playBtn.addEventListener('click', togglePlay);

  audio.addEventListener('timeupdate', () => {
    if (audio.duration) {
      const percent = (audio.currentTime / audio.duration) * 100;
      progressFill.style.width = percent + '%';
      currentTimeEl.textContent = formatTime(audio.currentTime);
      updateLrc();
    }
  });

  audio.addEventListener('loadedmetadata', () => {
    totalTimeEl.textContent = formatTime(audio.duration);
  });

  progressBar.addEventListener('click', (e) => {
    if (!audio.duration) return;
    const rect = progressBar.getBoundingClientRect();
    const clickPosition = (e.clientX - rect.left) / rect.width;
    audio.currentTime = clickPosition * audio.duration;
  });

  volumeSlider.addEventListener('input', (e) => {
    const val = parseFloat(e.target.value);
    audio.volume = val;
    try {
      localStorage.setItem(STORAGE_KEY_VOLUME, val);
    } catch (err) {}
  });

  audio.addEventListener('ended', () => {
    playBtn.textContent = '▶';
    progressFill.style.width = '0%';
    container.classList.remove('playing');
    const nextIndex = (currentIndex + 1) % playlist.length;
    switchTrack(nextIndex);
  });

  renderUI();
})();
</script>
</includeonly>